#!/usr/bin/env python3
"""Desktop actions; training only controls keep-awake, never GPU routing."""
import json, subprocess, sys
from _sensei_machine import desktop_state, save_state
state = desktop_state()
a = sys.argv[1:]
if not a:
    print(json.dumps(state));raise SystemExit(0)
action = a[0]
if action == 'training':
    enabled = len(a) > 1 and a[1] == 'on'
    if enabled != state.get('training', False):
        current = subprocess.check_output(['qs','-c','wrayth','ipc','call','idle','state'],text=True).strip()
        if enabled:
            state['previousIdleHold'] = current == 'HOLD'
        hold = enabled or state.get('previousIdleHold', False)
        subprocess.run(['qs','-c','wrayth','ipc','call','idle','hold','on' if hold else 'off'],check=True)
    state['training'] = enabled
    save_state(state)
elif action == 'animations':
    enabled = not state.get('animations', True)
    subprocess.run(['hyprctl','keyword','animations:enabled','true' if enabled else 'false'],check=True)
    state['animations'] = enabled;save_state(state)
else:
    raise SystemExit('Unsupported desktop action: ' + action)
print(json.dumps(state))
