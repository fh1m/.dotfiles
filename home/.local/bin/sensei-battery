#!/usr/bin/env python3
"""Read real laptop battery telemetry; only explicit actions change charging policy."""
import argparse,json,subprocess
from pathlib import Path
SUPPLIES=Path('/sys/class/power_supply')
def snapshot():
    batteries=[]
    for path in sorted(SUPPLIES.glob('*')):
        try:
            if (path/'type').read_text().strip()!='Battery' or path.name.startswith('hid-'):continue
        except OSError:continue
        def read(key):
            try:return (path/key).read_text().strip()
            except OSError:return None
        def value(key,scale=1):
            try:return float(read(key))/scale
            except (TypeError,ValueError):return None
        full=value('energy_full',1e6);design=value('energy_full_design',1e6)
        batteries.append({'name':path.name,'model':read('model_name'),'technology':read('technology'),'status':read('status'),'charge':value('capacity'),'energy':value('energy_now',1e6),'capacity':full,'design':design,'health':100*full/design if full and design else None,'watts':value('power_now',1e6),'voltage':value('voltage_now',1e6),'cycles':value('cycle_count'),'limit':value('charge_control_end_threshold'),'limitSupported':read('charge_control_end_threshold') is not None})
    return {'batteries':batteries}
def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('action',nargs='?',choices=['state','limit','oneshot'],default='state');parser.add_argument('percent',nargs='?',type=int);args=parser.parse_args()
    if args.action!='state':
        if args.percent is None or not 20<=args.percent<=100:raise ValueError('Charge limit must be 20–100%')
        subprocess.run(['asusctl','battery',args.action,str(args.percent)],check=True,capture_output=True,text=True,timeout=20)
    print(json.dumps(snapshot()))
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.SubprocessError) as error:print(json.dumps({'error':str(error)}));raise SystemExit(1)
