#!/usr/bin/env python3
"""Launch the installed graphical output editor; preserve a recoverable layout."""
from pathlib import Path
import datetime,os,shutil,subprocess,sys
if not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
 import json
 instances=json.loads(subprocess.check_output(['hyprctl','instances','-j'],text=True))
 if not instances:raise SystemExit('No graphical Hyprland session found')
 os.environ.update(HYPRLAND_INSTANCE_SIGNATURE=instances[0]['instance'],WAYLAND_DISPLAY=instances[0]['wl_socket'])
h=Path.home();p=h/'.config/hypr/monitors-user.lua';stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
backup=h/'.local/state/dotfiles-backups'/('display-layout-'+stamp)
if p.exists():
 backup.mkdir(parents=True,exist_ok=True);shutil.copy2(p,backup/p.name)
if len(sys.argv)>1 and sys.argv[1]=='reset':
 if p.exists():p.rename(backup/'archived-monitors-user.lua')
 subprocess.run(['hyprctl','-i','0','reload'],check=True)
else:
 os.execvp('nwg-displays',['nwg-displays','-m',str(p.with_suffix('.conf')),'-n','7'])
