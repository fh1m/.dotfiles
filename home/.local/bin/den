#!/usr/bin/env python3
"""Explicit Den navigation and authenticated peer/storage handoff. No job executor."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import socket
import tempfile
from urllib.parse import quote

# Current continuity commands supersede the historical mailbox/Deskflow status.
if __name__=='__main__' and len(sys.argv)>1 and sys.argv[1] in {'status','doctor','mode','sync','backup','job','companion','watch','workbench'}:
    os.execv(str(Path.home()/'.local/bin/sensei-den'),['sensei-den',*sys.argv[1:]])

HOME = Path.home()
STATE = HOME / '.local/state/den'
SETTINGS = HOME / '.config/sensei-den/config.json'
MAILBOX = HOME / '.local/bin/den-mailbox'
SSH_CONFIG = STATE / 'ssh/client.conf'
ID = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,95}\Z')


def run(argv, **kwargs):
    return subprocess.run(argv, capture_output=True, timeout=kwargs.pop('timeout', 8), **kwargs)


def settings():
    try:
        value = json.loads(SETTINGS.read_text())
        if not isinstance(value, dict):raise ValueError('Invalid Den settings')
        return value
    except FileNotFoundError:return {}


def peer(*args, raw=None):
    if not SSH_CONFIG.is_file():raise ValueError('Peer SSH settings are not configured')
    alias=settings().get('peer',{}).get('alias','homie-den' if socket.gethostname().split('.')[0]=='arete' else 'arete-den')
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,64}',alias):raise ValueError('Invalid peer alias')
    result = run(['ssh', '-F', str(SSH_CONFIG), alias, 'den-mailbox', *args], input=raw)
    if result.returncode:raise ValueError('Homie is offline or authentication failed; existing work is preserved')
    return result.stdout


def input_unit():
    unit=settings().get('input',{}).get('unit','app-org.deskflow.deskflow@denclient.service')
    if not re.fullmatch(r'[A-Za-z0-9_.@-]+\.service',unit):raise ValueError('Invalid input service')
    return unit


def input_status():
    result = run(['systemctl', '--user', 'is-active', input_unit()])
    return result.stdout.decode().strip() or 'inactive'


def status():
    try:
        value=json.loads(peer('ping'))
        if value.get('host')!=settings().get('peer',{}).get('name','homie' if socket.gethostname().split('.')[0]=='arete' else 'arete') or value.get('protocol')!=1:raise ValueError('Unexpected peer identity')
        remote={'state':'online','host':value['host'],'authenticated':True}
    except (ValueError, subprocess.SubprocessError, OSError):remote={'state':'unavailable','authenticated':False}
    return {'peer':remote,'input':input_status(),'storage': 'configured' if settings().get('storage') else 'not configured'}


def storage():
    value=settings().get('storage',{})
    host,share=value.get('host',''),value.get('share','')
    user=value.get('user','fh1m')
    if not re.fullmatch(r'[A-Za-z0-9.-]{1,253}',host) or not re.fullmatch(r'[A-Za-z0-9_-]{1,64}',share):
        raise ValueError('Homie storage is not configured')
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,64}',user):raise ValueError('Invalid storage user')
    return host,share,user


def password():
    result=run(['secret-tool','lookup','service','sensei-den','host','homie','account','fh1m'])
    if result.returncode or not result.stdout.strip():raise ValueError('Storage credential is not in the unlocked OS keyring')
    return result.stdout.rstrip(b'\n')


def storage_open():
    from gi.repository import Gio, GLib
    host,share,user=storage();secret=password().decode()
    uri='smb://'+quote(user,safe='')+'@'+host+'/'+quote(share,safe='')
    target=Gio.File.new_for_uri(uri);operation=Gio.MountOperation();loop=GLib.MainLoop();errors=[]
    def authenticate(op,*_):
        op.set_anonymous(False);op.set_username(user);op.set_password(secret)
        op.set_password_save(Gio.PasswordSave.PERMANENTLY);op.reply(Gio.MountOperationResult.HANDLED)
    operation.connect('ask-password',authenticate)
    cancel=Gio.Cancellable()
    def finished(file,result):
        try:file.mount_enclosing_volume_finish(result)
        except GLib.Error as error:
            if not error.matches(Gio.io_error_quark(),Gio.IOErrorEnum.ALREADY_MOUNTED):errors.append('Storage connection failed; check Homie and the credential')
        loop.quit()
    def expire():cancel.cancel();return False
    timer=GLib.timeout_add_seconds(15,expire)
    target.mount_enclosing_volume(Gio.MountMountFlags.NONE,operation,cancel,finished)
    loop.run();GLib.source_remove(timer)
    if errors:raise ValueError(errors[0])
    Gio.AppInfo.launch_default_for_uri(uri,None)


def storage_check():
    host,share,user=storage();secret=password()
    if b'\n' in secret or b'\r' in secret:raise ValueError('Invalid storage credential')
    fd=os.memfd_create('den-smb-auth',0)
    try:
        os.write(fd,b'username = '+user.encode()+b'\npassword = '+secret+b'\n')
        os.lseek(fd,0,os.SEEK_SET)
        with tempfile.TemporaryDirectory(prefix='den-share-check-') as tmp:
            source=Path(tmp)/'source.bin';received=Path(tmp)/'received.bin';source.write_bytes(os.urandom(65536))
            name='den-check-'+os.urandom(8).hex()+'.bin'
            # Only generated names enter smbclient's command parser. Credentials
            # remain in an anonymous descriptor, never argv or a disk file.
            commands='put '+str(source)+' '+name+'; get '+name+' '+str(received)+'; del '+name
            result=run(['smbclient','//'+host+'/'+share,'-A','/proc/self/fd/'+str(fd),'-m','SMB3','--client-protection=encrypt','-c',commands],pass_fds=(fd,),timeout=20)
            if result.returncode or not received.exists():raise ValueError('Authenticated storage round trip failed')
            digest=hashlib.sha256(source.read_bytes()).hexdigest()
            if hashlib.sha256(received.read_bytes()).hexdigest()!=digest:raise ValueError('Storage checksum mismatch')
            return {'bytes':65536,'sha256':digest,'verified':True,'encrypted':True}
    finally:os.close(fd)


def main():
    parser=argparse.ArgumentParser(description=__doc__);sub=parser.add_subparsers(dest='command',required=True)
    state=sub.add_parser('status');state.add_argument('--json',action='store_true')
    sub.add_parser('inbox');read=sub.add_parser('read');read.add_argument('id')
    get=sub.add_parser('peer-get');get.add_argument('id');sub.add_parser('peer-list')
    send=sub.add_parser('send');send.add_argument('file',type=Path)
    control=sub.add_parser('input');control.add_argument('action',choices=['start','stop','status','toggle'])
    files=sub.add_parser('storage');files.add_argument('action',choices=['open','check'])
    args=parser.parse_args()
    native = HOME/'.local/bin/den-control'
    if native.is_file() and (HOME/'.local/state/homie-control/input/config.toml').is_file():
        action = None
        if args.command == 'status': action = 'status'
        elif args.command == 'input': action = 'status' if args.action == 'status' else args.action
        elif args.command == 'storage': action = 'storage' if args.action == 'open' else 'check'
        if action:
            os.execv(sys.executable, [sys.executable, str(native), action, '--json'])
    if args.command=='status':
        value=status()
        if args.json:print(json.dumps(value))
        else:print('Peer: '+value['peer']['state']+' | input: '+value['input']+' | storage: '+value['storage'])
    elif args.command in ('inbox','read'):
        if args.command=='read' and not ID.fullmatch(args.id):raise ValueError('Invalid message ID')
        subprocess.run([str(MAILBOX),args.command,*([args.id] if args.command=='read' else [])],check=True)
    elif args.command in ('peer-list','peer-get'):
        if args.command=='peer-get' and not ID.fullmatch(args.id):raise ValueError('Invalid message ID')
        sys.stdout.buffer.write(peer(*(['list'] if args.command=='peer-list' else ['get',args.id])))
    elif args.command=='send':
        raw=args.file.read_bytes()
        if len(raw)>65536:raise ValueError('Message exceeds 64 KiB')
        subprocess.run([str(MAILBOX),'publish'],input=raw,check=True,capture_output=True)
        receipt=json.loads(peer('put',raw=raw))
        if receipt['sha256']!=hashlib.sha256(raw).hexdigest():raise ValueError('Peer receipt hash mismatch')
        print(json.dumps(receipt))
    elif args.command=='input':
        if args.action=='status':print(input_status())
        else:
            unit = input_unit()
            gate = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/'+str(os.getuid()))) / 'den-input-enabled'
            if args.action == 'start':
                # Only Deskflow sessions may use this portal consent; Phone has a
                # separate switch. The marker never grants SSH command access.
                fd = os.open(gate, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, 'w') as stream:stream.write('Den input explicitly enabled\n')
                try:subprocess.run(['systemctl','--user','start',unit],check=True)
                except BaseException:
                    gate.unlink(missing_ok=True)
                    raise
            else:
                gate.unlink(missing_ok=True)
                subprocess.run(['systemctl','--user','stop',unit],check=True)
    elif args.command=='storage':
        if args.action=='open':storage_open()
        else:print(json.dumps(storage_check()))


if __name__=='__main__':
    try:main()
    except (ValueError,OSError,subprocess.SubprocessError) as error:
        # Errors are deliberately concise: subprocess stderr may contain sensitive
        # application diagnostics, so it is not replayed into desktop notifications.
        print('Den: '+(str(error) if isinstance(error,ValueError) else 'Operation unavailable; check local configuration'),file=sys.stderr)
        raise SystemExit(1)
