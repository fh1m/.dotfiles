 fn get_output_configuration(state: &State, pos: Position) -> Vec<Output> {
+    // Den: explicitly target a physical screen without changing compositor geometry.
+    // Missing target disables the edge instead of unexpectedly grabbing another screen.
+    if let Ok(name) = env::var("DEN_CAPTURE_OUTPUT") {
+        return state.outputs.iter().filter(|output| {
+            output.info.as_ref().is_some_and(|info| info.name == name)
+        }).cloned().collect();
+    }
     // get all output edges corresponding to the position
     let edges = get_edges(&state.outputs, pos);
     let opposite_edges = get_edges(&state.outputs, pos.opposite());
