@@ -0,0 +1,11 @@
+package go_librespot_test
+import (
+ "testing"
+ librespot "github.com/devgianlu/go-librespot"
+)
+func TestSpotifyIDOverflowReturnsError(t *testing.T) {
+ for _, id := range []string{"zzzzzzzzzzzzzzzzzzzzzz", "-1"} {
+  if _, err := librespot.SpotifyIdFromBase62(librespot.SpotifyIdTypeTrack,id); err == nil { t.Fatal("invalid ID accepted") }
+ }
+ if _, err := librespot.SpotifyIdFromBase62(librespot.SpotifyIdTypeTrack,"1111111111111111111111"); err != nil {t.Fatal(err)}
+}
