#%PAM-1.0
# Known gap, measured: the Quickshell binary imports pam_authenticate, pam_end,
# pam_start_confdir and pam_strerror only -- never pam_acct_mgmt. So no account
# stage here runs: pam_time and expired-account checks do NOT apply to the lock.
# Adding an `account` line below would do nothing. Login still enforces them.
#
# Read by services/Lock.qml through PamContext.configDirectory, so the
# lockscreen needs nothing under /etc and no root to install.

auth    required                    pam_faillock.so     preauth
auth    [success=1 default=bad]     pam_unix.so
auth    [default=die]               pam_faillock.so     authfail
auth    required                    pam_faillock.so     authsucc
