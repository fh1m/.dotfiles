#!/usr/bin/env python3
"""Explicit bounded ROS capture. Run inside the selected ROS environment; never controls a vehicle."""
import argparse,json,os,re,signal,subprocess,time
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--output',type=Path,required=True);p.add_argument('--seconds',type=int,default=15);p.add_argument('--max-mib',type=int,default=128);p.add_argument('--topic',action='append',required=True);a=p.parse_args()
if not 1<=a.seconds<=60 or not 1<=a.max_mib<=512:p.error('Capture bounds: 1–60 seconds, 1–512 MiB')
if len(a.topic)>32 or any(not re.fullmatch(r'/[A-Za-z0-9_/]+',t) for t in a.topic):p.error('Select at most 32 explicit topic names')
out=a.output.expanduser().resolve()
if out.exists():p.error('Output already exists; never overwrite a recording')
out.parent.mkdir(parents=True,exist_ok=True);os.umask(0o077)
help_result=subprocess.run(['ros2','bag','record','--help'],capture_output=True,text=True,timeout=5)
if help_result.returncode:p.error('ROS bag recorder unavailable in this environment')
selection=['--topics'] if '--topics' in help_result.stdout else []
argv=['ros2','bag','record','-s','mcap','-o',str(out),*selection,*a.topic]
child=None;reason='duration';started=time.time()
try:
 child=subprocess.Popen(argv,start_new_session=True)
 while child.poll() is None and time.time()-started<a.seconds:
  if out.exists() and sum(x.stat().st_size for x in out.rglob('*') if x.is_file())>=a.max_mib*1048576:reason='size-limit';break
  time.sleep(.25)
except KeyboardInterrupt:reason='user-stop'
finally:
 if child and child.poll() is None:
  os.killpg(child.pid,signal.SIGINT)
  try:child.wait(timeout=10)
  except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGTERM);child.wait(timeout=5)
 if child:
  record={'version':1,'topics':a.topic,'started':started,'finished':time.time(),'reason':reason,'exitCode':child.returncode,'sizeLimitMiB':a.max_mib,'durationLimitSeconds':a.seconds,'note':'Size bound is checked every 250 ms; fast sources can exceed it between samples.'}
  (out.parent/(out.name+'-capture.json')).write_text(json.dumps(record,indent=2)+'\n');print(json.dumps(record))

if child:raise SystemExit(0 if child.returncode in (0,130,-signal.SIGINT) else 1)
