#!/usr/bin/env python3
"""Independent persistent dev sessions; resume is always an explicit action."""
import argparse,fcntl,os,re,subprocess
from pathlib import Path
STATE=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))/'sensei-tmux'
def tmux(*args,capture=False):
    return subprocess.run(['tmux',*args],check=True,text=True,stdout=subprocess.PIPE if capture else subprocess.DEVNULL,stderr=subprocess.PIPE)
def create():
    STATE.mkdir(mode=0o700,parents=True,exist_ok=True)
    with (STATE/'launch.lock').open('a+') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        listing=subprocess.run(['tmux','list-sessions','-F','#{session_name}'],capture_output=True,text=True).stdout.splitlines()
        counter=STATE/'counter'
        try:previous=int(counter.read_text())
        except (OSError,ValueError):previous=0
        slot=max([previous]+[int(n[4:]) for n in listing if re.fullmatch(r'dev_\d+',n)])+1
        name=f'dev_{slot:03d}'
        # No -t: each new session owns distinct windows and panes.
        tmux('new-session','-d','-s',name,'-n','Shell','-c',os.getcwd())
        temp=counter.with_suffix('.tmp');temp.write_text(str(slot));temp.chmod(0o600);temp.replace(counter)
        return name

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prepare',action='store_true');parser.add_argument('--create',action='store_true')
    parser.add_argument('--attach');parser.add_argument('--list',action='store_true');args=parser.parse_args()
    if args.prepare:return # The existing tmux -D service owns server lifetime.
    if args.list:tmux('list-sessions');return
    name=args.attach
    if name and not re.fullmatch(r'[A-Za-z0-9_.-]+',name):raise ValueError('Choose a session by exact name')
    if not name:name=create()
    if args.create:print(name);return
    command='switch-client' if os.environ.get('TMUX') else 'attach-session'
    os.execvp('tmux',['tmux',command,'-t','='+name])
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.CalledProcessError) as error:raise SystemExit('tmux setup failed: '+str(error))
