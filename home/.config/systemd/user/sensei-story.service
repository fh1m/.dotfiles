[Unit]
Description=Digital Den per-output wallpaper story and fallback
After=graphical-session.target sensei-awww.service
Wants=sensei-awww.service
PartOf=graphical-session.target
[Service]
ExecStart=%h/.local/bin/sensei-wallpaper-story watch
Restart=on-failure
RestartSec=5
UMask=0077
[Install]
WantedBy=graphical-session.target
