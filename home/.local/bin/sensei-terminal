#!/usr/bin/env python3
"""Launch the daily Alacritty terminal, preserving the Kitty-style caller CLI."""
import os
import sys

args = sys.argv[1:]
out = []
value_options = {'--title', '-T', '--class', '--working-directory', '--directory', '--config-file', '--option', '-o'}
i = 0
explicit_command = False
while i < len(args):
    arg = args[i]
    if arg in ('-e', '--command'):
        explicit_command = True
        out.extend(['-e', *args[i + 1:]])
        break
    if arg in value_options:
        if i + 1 >= len(args):
            raise SystemExit(f'{arg} needs a value')
        out.extend(['--working-directory' if arg == '--directory' else arg, args[i + 1]])
        i += 2
        continue
    if arg == '--hold':
        out.append(arg)
        i += 1
        continue
    if arg.startswith('-'):
        out.append(arg)
        i += 1
        continue
    out.extend(['-e', *args[i:]])
    explicit_command = True
    break
# Option-only launches still join the persistent workbench. Explicit task
# commands stay independent so a package action cannot replace daily work.
if not explicit_command:
    if not any(arg in ('--title', '-T') for arg in args):
        out.extend(['--title', 'Sensei · Terminal'])
    out.extend(['-e', '/home/fh1m/.local/bin/sensei-tmux'])

os.execvp('alacritty', ['alacritty', *out])
