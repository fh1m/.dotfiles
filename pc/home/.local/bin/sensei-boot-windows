#!/usr/bin/python3
"""Explicit user-confirmed one-time Windows reboot; no permanent boot-order change."""
import subprocess

helper = "/usr/local/libexec/homie-boot-windows"
if subprocess.run(["zenity", "--question", "--title=Homie · Windows",
                   "--text=Save your work before restarting into Windows.\n\nThe next boot will use Revenger Windows once. Linux remains the usual default.",
                   "--ok-label=Restart into Windows", "--cancel-label=Stay in Linux"]).returncode:
    raise SystemExit(0)
arm = subprocess.run(["pkexec", helper, "arm"], capture_output=True, text=True)
if arm.returncode:
    subprocess.run(["zenity", "--error", "--title=Homie · Windows", "--text=" + (arm.stderr or arm.stdout or "Windows target could not be verified.")])
    raise SystemExit(1)
reboot = subprocess.run(["systemctl", "reboot"], capture_output=True, text=True)
if reboot.returncode:
    cancel = subprocess.run(["pkexec", helper, "cancel"], capture_output=True, text=True)
    message = "Restart failed. " + ("The Windows request was cleared." if cancel.returncode == 0 else "The Windows request may still be armed; use Cancel Windows next boot.")
    subprocess.run(["zenity", "--error", "--title=Homie · Windows", "--text=" + message])
    raise SystemExit(1)
