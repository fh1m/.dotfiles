+func (s *ConcreteApiServer) GetContextTracks(w http.ResponseWriter, r *http.Request, params GetContextTracksParams) {
+	offset, limit := 0, 50
+	var err error
+	if v := r.URL.Query().Get("offset"); v != "" {
+		offset, err = strconv.Atoi(v)
+		if err != nil {
+			http.Error(w, "invalid offset", 400)
+			return
+		}
+	}
+	if v := r.URL.Query().Get("limit"); v != "" {
+		limit, err = strconv.Atoi(v)
+		if err != nil {
+			http.Error(w, "invalid limit", 400)
+			return
+		}
+	}
+	if offset < 0 || limit < 1 || limit > 500 {
+		http.Error(w, "invalid page", 400)
+		return
+	}
+	s.handleRequest(ApiRequest{Type: ApiRequestTypeContextTracks, Data: ApiRequestDataContextTracks{Uri: params.Uri, Offset: offset, Limit: limit}}, w)
 }
 
