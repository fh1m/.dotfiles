#!/usr/bin/env python3
"""Validated local engineering actions; JSON in/out, no generic command execution."""
import argparse,json,sys,subprocess,socket,shlex,runpy
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'share/sensei'))
import engineering as e

def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('--host',choices=['arete','homie']);s=p.add_subparsers(dest='verb',required=True)
 s.add_parser('overview');s.add_parser('list');s.add_parser('doctor');s.add_parser('projects');s.add_parser('receipts')
 for verb in ('inspect','prepare','run'):
  q=s.add_parser(verb);q.add_argument('action');q.add_argument('--params',default='{}');q.add_argument('--confirmation')
 q=s.add_parser('register');q.add_argument('id');q.add_argument('directory',type=Path);q.add_argument('--title')
 q=s.add_parser('trust-environment');q.add_argument('project');q.add_argument('task')
 q=s.add_parser('trust');q.add_argument('project');q.add_argument('task')
 a=p.parse_args()
 if a.host and a.host!=e.machine():
  remote_args=sys.argv[1:];index=remote_args.index('--host');del remote_args[index:index+2]
  if e.machine()=='arete' and a.host=='homie':
   cfg=Path.home()/'.local/state/homie-control/client.conf'
   den=runpy.run_path(str(Path.home()/'.local/bin/sensei-den'))
   alias='homie';access=den['read'](Path.home()/'.config/sensei-den/access.json')
   if access.get('privateAlias') and not den['connectivity']():alias=access['privateAlias']
   executable=str(Path.home()/'.local/bin/sensei-actions')
  elif e.machine()=='homie' and a.host=='arete':
   cfg=Path.home()/'.local/state/homie-control/master-client.conf';alias='arete-den-control';executable='sensei-actions'
   if a.verb in ('register','trust','trust-environment'):raise ValueError('Edit and trust project definitions on their owning host')
  else:raise ValueError('This remote route is not configured')
  r=subprocess.run(['ssh','-n','-F',str(cfg),alias,shlex.join([executable,*remote_args])],capture_output=True,text=True,timeout=25)
  if r.returncode:raise ValueError('Remote operation unavailable or rejected; no local fallback or automatic retry')
  return json.loads(r.stdout)
 if a.verb=='overview':
  try:jobs=e.command([str(e.home()/'.local/bin/sensei-den'),'job','list'])
  except (ValueError,OSError,subprocess.SubprocessError):jobs=[]
  inventory=e.hardware_inventory()
  experiments=[]
  for folder in sorted((e.home()/'.local/state/sensei-lab').glob('*'),reverse=True)[:30]:
   path=folder/'run.json'
   try:
    if path.is_file() and path.stat().st_size<1048576:experiments.append(dict(e.read(path),id=folder.name))
   except (OSError,ValueError,TypeError):pass
  return {'experiments':experiments,'host':e.machine(),'projects':e.projects(),'jobs':jobs,'hardware':inventory['devices'],'availableHardware':inventory.get('available',[]),'capacity':{'cpuCount':__import__('os').cpu_count(),'load':__import__('os').getloadavg()[0]}}
 if a.verb=='list':return {'version':1,'actions':e.ACTIONS}
 if a.verb=='projects':return e.projects()
 if a.verb=='receipts':return e.read(e.state()/'receipts.json',{'version':1,'sequence':0,'events':[]})
 if a.verb=='doctor':
  import shutil
  return {'version':1,'host':e.machine(),'projects':len(e.projects()),'tools':{x:bool(shutil.which(x)) for x in ('git','tmux','docker','hyprctl','udevadm','restic')},'noesis_ui':all((e.home()/'.local/share/sensei-learning/ui'/name).is_file() for name in ('NoesisStyle.qml','NoesisController.qml')),'noesis_ui_link':(e.home()/'.config/quickshell/sensei/noesis-ui').resolve()==(e.home()/'.local/share/sensei-learning/ui').resolve()}
 if a.verb=='register':
  e.identifier(a.id);directory=a.directory.expanduser().resolve()
  if not directory.is_dir():raise ValueError('Choose an existing project directory')
  with e.locked(e.config()/'projects.lock'):
   rows=e.projects();row=next((x for x in rows if x['id']==a.id),None)
   if row is None:row={'id':a.id,'title':a.title or a.id,'locations':{},'tasks':{},'trusted_tasks':{}};rows.append(row)
   row.setdefault('locations',{})[e.machine()]=str(directory);e.save(e.config()/'projects.json',{'version':1,'projects':rows})
  return row
 if a.verb in ('trust','trust-environment'):
  definitions='tasks' if a.verb=='trust' else 'environments'
  approvals='trusted_tasks' if a.verb=='trust' else 'trusted_environments'
  with e.locked(e.config()/'projects.lock'):
   rows=e.projects();row=next((x for x in rows if x['id']==a.project),None)
   if row is None or a.task not in row.get(definitions,{}):raise ValueError('Unknown task')
   row.setdefault(approvals,{})[a.task]=e.fingerprint(row[definitions][a.task]);e.save(e.config()/'projects.json',{'version':1,'projects':rows})
  return {'trusted':a.task,'definition':row[definitions][a.task]}
 if a.action not in e.ACTIONS:raise ValueError('Unknown action')
 if a.verb=='inspect':return e.ACTIONS[a.action]
 params=json.loads(a.params)
 return e.prepare(a.action,params) if a.verb=='prepare' else e.invoke(a.action,params,a.confirmation)
if __name__=='__main__':
 try:print(json.dumps(main(),ensure_ascii=False,allow_nan=False))
 except (ValueError,OSError,KeyError,TypeError,subprocess.SubprocessError) as error:
  print(json.dumps({'error':str(error)}));sys.exit(1)
