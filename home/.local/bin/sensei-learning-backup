#!/usr/bin/env python3
"""Private incremental-in-time snapshots; never publish or overwrite a vault."""
import argparse, hashlib, json, os, tarfile, tempfile, shutil, fcntl
from datetime import datetime
from pathlib import Path
HOME=Path.home()
STATE=HOME/'.local/state/sensei-learning/snapshots'
EXCLUDE={'.git','plugins','themes','.cache','cache','node_modules','build','__pycache__'}
def sha(path):
 with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
def safe(root,name):
 p=Path(name)
 if p.is_absolute() or '..' in p.parts or not (root/p).resolve().is_relative_to(root.resolve()):raise ValueError('Unsafe manifest path')
 return root/p
def atomic_json(path,record):
 fd,tmp=tempfile.mkstemp(dir=path.parent)
 try:
  with os.fdopen(fd,'w') as stream:json.dump(record,stream,indent=2);stream.flush();os.fsync(stream.fileno())
  os.replace(tmp,path)
 finally:
  if os.path.exists(tmp):os.unlink(tmp)
def eligible(p,root):
 parts=p.relative_to(root).parts
 return not any(x in EXCLUDE for x in parts) and not p.is_symlink() and not p.name.startswith(('workspace','.env')) and p.suffix not in {'.log','.db','.sqlite','.sqlite3'}
def backup(root):
 STATE.mkdir(parents=True,exist_ok=True)
 with (STATE/'.lock').open('a') as stream:
  fcntl.flock(stream,fcntl.LOCK_EX)
  with tempfile.TemporaryDirectory(dir=STATE) as temporary:
   original=root.resolve();stage=Path(temporary)/'vault';stage.mkdir()
   references={}
   for p in sorted(original.rglob('*')):
    if not p.is_file() or not eligible(p,original):continue
    if p.stat().st_size>25*1024*1024 or p.suffix.lower() in {'.mcap','.bag','.mp4','.mkv'}:
     references[str(p.relative_to(original))]={'location':str(p),'size':p.stat().st_size,'protection':'external; not included in text snapshot'};continue
    before=p.stat();target=stage/p.relative_to(original);target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,target)
    after=p.stat()
    if (before.st_mtime_ns,before.st_size,before.st_ino)!=(after.st_mtime_ns,after.st_size,after.st_ino):raise ValueError('File changed during backup; retry: '+str(p))
   snapshot(stage,original,references)
def snapshot(root,original,references):
 root=root.resolve()
 if not ((root/'94 Meta/System.json').is_file() or (root/'System/System.json').is_file()):raise ValueError('Not a Noesis vault')
 key=hashlib.sha256(str(original).encode()).hexdigest()[:12];dest=STATE/key;dest.mkdir(parents=True,exist_ok=True);STATE.chmod(0o700);dest.chmod(0o700)
 files=sorted(p for p in root.rglob('*') if p.is_file() and eligible(p,root))
 hashes={str(p.relative_to(root)):sha(p) for p in files}
 digest=hashlib.sha256(json.dumps([hashes,references],sort_keys=True).encode()).hexdigest()
 old=dest/'latest.json'
 if old.exists() and json.loads(old.read_text()).get('digest')==digest:
  print('Unchanged: '+str(root));return
 stamp=datetime.now().strftime('%Y%m%d-%H%M%S-%f');name=stamp+'.tar.gz';fd,tmp=tempfile.mkstemp(dir=dest);os.close(fd)
 try:
  with tarfile.open(tmp,'w:gz') as tar:
   for p in files:tar.add(p,arcname=str(p.relative_to(root)),recursive=False)
  os.chmod(tmp,0o600);os.replace(tmp,dest/name)
 finally:
  if os.path.exists(tmp):os.unlink(tmp)
 record={'vault':str(original),'archive':name,'digest':digest,'files':hashes,'external_artifacts':references,'archive_sha256':sha(dest/name)}
 atomic_json(dest/(stamp+'.json'),record);atomic_json(old,record)
 # Keep seven newest snapshots plus one per week from the four preceding weeks.
 snapshots=sorted(dest.glob('*.tar.gz'),reverse=True);keep=set(snapshots[:7]);weeks=set()
 for p in snapshots[7:]:
  week=datetime.strptime(p.name[:8],'%Y%m%d').strftime('%G-%V')
  if week not in weeks and len(weeks)<4:keep.add(p);weeks.add(week)
 for p in snapshots:
  if p not in keep:p.unlink();p.with_name(p.name[:-7]+'.json').unlink(missing_ok=True)
 print(dest/name)
def restore(archive,destination):
 if destination.exists() or destination.is_symlink():raise ValueError('Restore destination exists; refusing overwrite')
 metadata=json.loads(archive.with_name(archive.name[:-7]+'.json').read_text())
 if sha(archive)!=metadata['archive_sha256']:raise ValueError('Archive checksum mismatch')
 destination.parent.mkdir(parents=True,exist_ok=True)
 with tempfile.TemporaryDirectory(dir=destination.parent) as temporary:
  stage=Path(temporary)/'vault';stage.mkdir()
  with tarfile.open(archive) as tar:
   for m in tar.getmembers():
    if not m.isfile() or Path(m.name).is_absolute() or '..' in Path(m.name).parts:raise ValueError('Unsafe archive entry')
    p=safe(stage,m.name);p.parent.mkdir(parents=True,exist_ok=True)
    with tar.extractfile(m) as source,p.open('xb') as target:shutil.copyfileobj(source,target)
  for name,digest in metadata['files'].items():
   if sha(safe(stage,name))!=digest:raise ValueError('Restored file checksum mismatch')
  manifest=stage/'System/System.json'
  if not manifest.is_file():manifest=stage/'94 Meta/System.json'
  system=json.loads(manifest.read_text())
  for folder in system['directories']:safe(stage,folder).mkdir(parents=True,exist_ok=True)
  stage.rename(destination)
 print(destination)
def backup_readers():
 import sqlite3,shutil,time
 for root in [HOME/'Zotero',HOME/'.local/share/Sioyek']:
  if not root.is_dir():continue
  dest=STATE/'readers'/root.name/datetime.now().strftime('%Y%m%d-%H%M%S-%f')
  dest.mkdir(parents=True,exist_ok=True);dest.chmod(0o700)
  records={};database_sources={}
  try:
   for p in root.rglob('*'):
    if not p.is_file() or p.is_symlink() or p.name.startswith('fulltext') or p.name.endswith(('-wal','-shm','-journal','.bak')):continue
    relative=p.relative_to(root);target=dest/relative;target.parent.mkdir(parents=True,exist_ok=True)
    if p.suffix in ['.sqlite','.db']:
     candidates=[p]
     # Zotero may hold an exclusive runtime lock; its own last-consistent backup
     # is a safe fallback, explicitly labelled with its actual timestamp.
     if (p.with_name(p.name+'.bak')).is_file():candidates.append(p.with_name(p.name+'.bak'))
     error=None
     for candidate in candidates:
      source=out=None
      try:
       source=sqlite3.connect(candidate.as_uri()+'?mode=ro',uri=True,timeout=2);out=sqlite3.connect(target)
       deadline=time.monotonic()+3
       def progress(status,remaining,total):
        if time.monotonic()>deadline:raise ValueError('Reader database busy')
       source.backup(out,pages=128,progress=progress,sleep=.1)
       if out.execute('PRAGMA quick_check').fetchone()[0]!='ok':raise ValueError('Reader database integrity check failed')
       database_sources[str(relative)]={'source':str(candidate),'source_modified':datetime.fromtimestamp(candidate.stat().st_mtime).isoformat(),'mode':'native-last-consistent-backup' if candidate!=p else 'sqlite-online-backup'}
       error=None;break
      except (ValueError,sqlite3.Error) as e:error=e
      finally:
       if out:out.close()
       if source:source.close()
      target.unlink(missing_ok=True)
     if error:raise ValueError(str(error)+': close '+root.name+' and retry backup')
    else:shutil.copy2(p,target)
    records[str(relative)]=sha(target)
   manifest={'source':str(root),'files':records,'database_sources':database_sources,'restore':'Close the reader, verify checksums, restore into a NEW data directory; never overwrite a live database.'}
   latest=dest.parent/'latest.json'
   if latest.exists() and json.loads(latest.read_text()).get('files')==records:
    shutil.rmtree(dest);print('Reader unchanged: '+str(root));continue
   (dest/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n');store_latest={'snapshot':str(dest),**manifest};latest.write_text(json.dumps(store_latest,indent=2)+'\n')
   print('Reader snapshot: '+str(dest))
   if any(v['mode']=='native-last-consistent-backup' for v in database_sources.values()):print('Zotero was open: snapshot uses its timestamped last internal backup, not a claim of live freshness.')
   for old in sorted((p for p in dest.parent.iterdir() if p.is_dir()),reverse=True)[7:]:shutil.rmtree(old)
  except Exception:
   shutil.rmtree(dest);raise

def restore_reader(snapshot,destination):
 """Verify a reader snapshot in isolation; never write a live reader profile."""
 import sqlite3
 from contextlib import closing
 if destination.exists() or destination.is_symlink():raise ValueError('Reader restore destination exists; refusing overwrite')
 metadata=json.loads((snapshot/'manifest.json').read_text())
 destination.parent.mkdir(parents=True,exist_ok=True)
 databases={}
 with tempfile.TemporaryDirectory(dir=destination.parent) as temporary:
  stage=Path(temporary)/'profile';stage.mkdir()
  for name,digest in metadata['files'].items():
   source=safe(snapshot,name)
   if source.is_symlink() or not source.is_file():raise ValueError('Reader file missing or unsafe')
   target=safe(stage,name);target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(source,target)
   if sha(target)!=digest:raise ValueError('Reader checksum mismatch: '+name)
   if target.suffix in {'.db','.sqlite'}:
    with closing(sqlite3.connect(target.as_uri()+'?mode=ro',uri=True)) as db:
     if db.execute('PRAGMA integrity_check').fetchone()[0]!='ok':raise ValueError('Reader database integrity failed')
     tables=[row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")]
     counts={table:db.execute('SELECT COUNT(*) FROM "'+table.replace('"','""')+'"').fetchone()[0] for table in tables}
     databases[name]={'tables':counts,'source':metadata.get('database_sources',{}).get(name,{})}
  atomic_json(stage/'noesis-reader-recovery.json',{'databases':databases,'source':metadata.get('source'),'database_sources':metadata.get('database_sources',{})})
  stage.rename(destination)
 return {'destination':str(destination),'verified_files':len(metadata['files']),'databases':databases,'live_profile_modified':False}

def main():
 os.umask(0o077);p=argparse.ArgumentParser(description=__doc__);p.add_argument('--vault');p.add_argument('--all',action='store_true');p.add_argument('--restore',type=Path);p.add_argument('--restore-reader',type=Path);p.add_argument('--dest',type=Path);a=p.parse_args()
 try:
  if a.restore_reader:
   if not a.dest:raise ValueError('Reader restore needs --dest pointing to a new directory')
   print(json.dumps(restore_reader(a.restore_reader,a.dest)));return
  if a.restore:
   if not a.dest:raise ValueError('Restore needs --dest pointing to a new directory')
   restore(a.restore,a.dest);return
  c=json.loads((HOME/'.config/sensei-learning/config.json').read_text())
  roots=[Path(a.vault or c['active_vault'])]
  if a.all:
   registry=json.loads((HOME/'.config/obsidian/obsidian.json').read_text())
   roots+= [Path(v['path']) for v in registry.get('vaults',{}).values() if ((Path(v['path'])/'94 Meta/System.json').is_file() or (Path(v['path'])/'System/System.json').is_file())]
  for root in sorted(set(r.resolve() for r in roots)):backup(root)
  if a.all:backup_readers()
 except (ValueError,OSError,KeyError,tarfile.TarError) as e:p.exit(1,str(e)+'\n')
if __name__=='__main__':main()
