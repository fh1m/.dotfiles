#!/usr/bin/env python3
"""Digital Den continuity: explicit modes, private data, owned jobs and a quiet companion."""
import argparse
import base64
import hashlib
import fcntl
import datetime
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import subprocess
import sys
import time

HOME=Path.home()
STATE=HOME/'.local/state/sensei-den'
CONFIG=HOME/'.config/sensei-den'
PRIVATE=HOME/'.local/state/homie-control'


def run(args,timeout=10,**kw):
    if args[0]=='hyprctl' and not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):args=[args[0],'-i','0',*args[1:]]
    return subprocess.run(args,capture_output=True,text=True,timeout=timeout,**kw)


def read(path,default=None):
    try:return json.loads(path.read_text())
    except FileNotFoundError:return {} if default is None else default


def write(path,value):
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    temp=path.with_name(path.name+'.'+str(os.getpid())+'.tmp')
    with temp.open('w') as f:
        os.chmod(temp,0o600);json.dump(value,f,indent=2);f.flush();os.fsync(f.fileno())
    temp.replace(path)


def host():return socket.gethostname().split('.')[0]


def remote(args,timeout=10,private=False):
    if host()!='arete':raise ValueError('Run cross-host administration from Arete')
    alias='homie'
    if private:
        access=read(CONFIG/'access.json')
        # Another network may reuse our LAN address. Verify the pinned peer with
        # a read-only preflight instead of trusting an open TCP port.
        if access.get('privateAlias') and not connectivity():alias=access['privateAlias']
    # Select a route before sending a command. Never replay a job after an SSH error.
    r=run(['ssh','-4','-n','-F',str(PRIVATE/'client.conf'),alias,shlex.join([str(x) for x in args])],timeout=timeout)
    if r.returncode:raise ValueError('Homie unavailable or command failed; existing work is preserved')
    return r.stdout


def service(name):return run(['systemctl','--user','is-active',name]).stdout.strip()


def connectivity():
    try:
        if host()=='arete':return remote(['hostname'],timeout=3).strip().split('.')[0]=='homie'
        r=run(['ssh','-n','-F',str(PRIVATE/'master-client.conf'),'arete-den-control','den-control','status'],timeout=3)
        return r.returncode==0
    except (OSError,ValueError,subprocess.SubprocessError):return False


def current_mode(peer=None):
    wanted=read(CONFIG/'continuity.json').get('mode','auto')
    peer=connectivity() if peer is None else peer
    return {'requested':wanted,'effective':('together' if peer else 'away' if host()=='arete' else 'homie') if wanted=='auto' else wanted}


def status():
    peer=connectivity();settings=read(CONFIG/'sync.json')
    t=run(['tailscale','status','--json']) if shutil.which('tailscale') else None
    try:tail=json.loads(t.stdout).get('BackendState') if t else 'unavailable'
    except ValueError:tail='unavailable'
    return {'host':host(),'mode':current_mode(peer),'peerAvailable':peer,'privateNetwork':tail,
        'sharing':service('den-input'),'sync':service('syncthing'),'backup':read(STATE/'backup-status.json'),
        'mirroredFolders':len(settings.get('folders',[])),'companion':read(CONFIG/'companion.json',{'enabled':True}),
        'hardwareHandoff':'Digital 100 Hz switches/cables must be physically verified'}


def zondo_playing():
    context=read(STATE/'zondo-context.json')
    return context.get('playing') is True and 0<=time.time()-context.get('at',0)<60


def companion_memory():
    sys.path.insert(0,str(HOME/'.local/share/sensei'))
    from companion_roam import memory
    return memory(read(STATE/'zondo-memory.json'))


def companion_available():
    """Only output names leave this geometry query; no titles or application text."""
    monitors=json.loads(run(['hyprctl','-i','0','monitors','-j']).stdout)
    clients=json.loads(run(['hyprctl','-i','0','clients','-j']).stdout)
    out=[]
    for m in monitors:
        if m['name'].startswith('SENSEI-'):continue
        windows=[c for c in clients if c.get('mapped') and not c.get('hidden') and (c.get('workspace',{}).get('id')==m.get('activeWorkspace',{}).get('id') or c.get('pinned'))]
        if any(c.get('fullscreen') for c in windows):continue
        w,h=m['width']/m['scale'],m['height']/m['scale']
        def fits(cw,ch):
            for px in (.05,.25,.5,.75,.95):
                for py in (.05,.25,.5,.75,.95):
                    x=8+px*(w-cw-16);y=54+py*(h-ch-108)
                    if y<52:continue
                    if not any(x<c['at'][0]-m['x']+c['size'][0]+12 and x+cw>c['at'][0]-m['x']-12 and y<c['at'][1]-m['y']+c['size'][1]+12 and y+ch>c['at'][1]-m['y']-12 for c in windows):return True
            return False
        if fits(96,96) and fits(256,156):out.append(m['name'])
    return out


def companion(action,value=None):
    cfg=read(CONFIG/'companion.json',{'enabled':True,'quiet':False,'size':96})
    sys.path.insert(0,str(HOME/'.local/share/sensei'))
    from companion_roam import engineering_events,engineering_acks,music_line,notification_receipt,notification_acks
    if action=='protocol':return {'schema':1,'leases':True,'availableOutputs':companion_available(),'render':read(STATE/'companion-render.json'),'musicPlaying':zondo_playing(),'musicLine':music_line(read(STATE/'zondo-music.json')),'deskNotices':notification_receipt(read(STATE/'companion-notifications.json'),host()),'noticeAcks':notification_acks(read(STATE/'zondo-notice-seen.json',{'ids':[]}).get('ids',[])),'memory':companion_memory(),'engineeringAcks':engineering_acks(read(STATE/'zondo-engineering-seen.json',{'ids':[]}).get('ids',[])),'engineeringEvents':engineering_events(read(HOME/'.local/state/sensei-engineering/receipts.json',{'events':[]}).get('events',[])),'enabled':cfg.get('enabled',True),'quiet':cfg.get('quiet',False),'suspended':cfg.get('suspended',False),'reducedMotion':cfg.get('reducedMotion',False)}
    if action=='grant':
        sys.path.insert(0,str(HOME/'.local/share/sensei'))
        from companion_roam import grant
        payload=json.loads(value);record=grant(read(STATE/'companion-travel.json'),payload['output'],payload['token'],payload.get('ttl',40))
        record['musicPlaying']=payload.get('musicPlaying') is True
        record['musicLine']=music_line(payload.get('musicLine'))
        record['deskNotices']=[notification_receipt(row,row.get('host')) for row in payload.get('deskNotices',[])[:2] if isinstance(row,dict)] if isinstance(payload.get('deskNotices'),list) else []
        record['noticeAcks']=notification_acks(payload.get('noticeAcks',[]))
        record['scene']=payload.get('scene') if payload.get('scene') in ('courier','parcel','detective','wrench') else ''
        record['engineeringEvents']=engineering_events(payload.get('engineeringEvents',[]))
        record['engineeringAcks']=engineering_acks(payload.get('engineeringAcks',[]))
        from companion_roam import memory
        record['memory']=memory(payload.get('memory',{}))
        write(STATE/'companion-travel.json',record);return record
    if action=='guest-frequency':
        try:minutes=int(value)
        except (TypeError,ValueError):raise ValueError('Choose a visit interval from 3 to 120 minutes')
        if not 3<=minutes<=120:raise ValueError('Choose a visit interval from 3 to 120 minutes')
        cfg['guestMinutes']=minutes;write(CONFIG/'companion.json',cfg);return {'frequencyMinutes':minutes}
    if action=='guest-mode':
        if value not in ('mixed','quotes','stories','workshop'):raise ValueError('Choose mixed, quotes, stories or workshop')
        cfg['guestMode']=value;write(CONFIG/'companion.json',cfg);return {'guestMode':value}
    if action in ('guest','guests'):
        catalog=read(HOME/'.local/share/sensei-companion/guests/catalog.json',{'guests':[]})
        ids=[g['id'] for g in catalog['guests']]
        if action=='guests':
            if value not in ('on','off'):return {'enabled':cfg.get('guestsEnabled',True),'people':ids,'frequencyMinutes':cfg.get('guestMinutes',10),'mode':cfg.get('guestMode','mixed'),'entriesPerGuest':{g['id']:len(g.get('quotes',[]))+10*len(g.get('topics',[])) for g in catalog['guests']}}
            cfg['guestsEnabled']=value=='on'
        else:
            if value and value not in ids:raise ValueError('Choose a guest: '+', '.join(ids))
            cfg.update(guestRequest={'id':value or '', 'at':time.time()})
        write(CONFIG/'companion.json',cfg);return {'enabled':cfg.get('guestsEnabled',True),'requested':value or 'random','people':ids}
    if action in ('talk','remember'):
        if not value or not value.strip():raise ValueError('Write a short thought first')
        if action=='talk':
            sys.path.insert(0,str(HOME/'.local/share/sensei'))
            from zondo_dialog import respond
            dialogue=read(STATE/'zondo-dialog.json');reply,pose=respond(value,dialogue);write(STATE/'zondo-dialog.json',dialogue)
            cfg.update(message=reply[:240],messageAt=time.time(),pose=pose,poseAt=time.time())
        else:
            notes=read(CONFIG/'zondo-personal.json',{'notes':[]})
            text=value.strip()[:240]
            if text not in notes['notes']:notes['notes']=(notes['notes']+[text])[-100:]
            write(CONFIG/'zondo-personal.json',notes)
            cfg.update(message='Kept in this desk’s private memory. I will bring it back as your words, not an invented memory.',messageAt=time.time(),pose='read',poseAt=time.time())
        write(CONFIG/'companion.json',cfg);return cfg
    if action in ('activity','activity-hide','activity-favorite'):
        atlas=read(HOME/'.local/share/sensei-companion/activity-atlases.json')
        if value not in atlas:raise ValueError('Unknown Zondo activity')
        if action=='activity':cfg.update(pose=value,poseAt=time.time())
        else:
            key='hiddenActivities' if action=='activity-hide' else 'favoriteActivities'
            cfg[key]=list(dict.fromkeys(cfg.get(key,[])+[value]))[-100:]
    elif action=='roam':
        if value not in ('on','off'):raise ValueError('Use roam on or off')
        cfg['roaming']=value=='on';cfg['anchorManual']=value!='on'
        if value=='on':cfg['reducedMotion']=False
    elif action=='hide-seek':cfg.update(seeking=True,tourAt=time.time(),roaming=True,reducedMotion=False,anchorManual=False,message='Find me on an available patch of wallpaper. Follow the pink engineering trail across the Den.',messageAt=time.time())
    elif action=='found':cfg.update(seeking=False,message='Found! Your reward is a tiny engineer with excellent hiding intentions.',messageAt=time.time(),pose='wave',poseAt=time.time())
    elif action=='tour':cfg.update(tourAt=time.time(),roaming=True,reducedMotion=False,anchorManual=False)
    elif action=='pulse':cfg['focusPulse']=value=='on' if value else not cfg.get('focusPulse',True)
    elif action=='dim':cfg['focusDimming']=value=='on' if value else not cfg.get('focusDimming',False)
    elif action=='toggle':cfg['enabled']=not cfg.get('enabled',True)
    elif action in ('show','hide'):cfg['enabled']=action=='show'
    elif action=='quiet':cfg['quiet']=value=='on' if value else not cfg.get('quiet',False)
    elif action=='suspended':cfg['suspended']=value=='on'
    elif action=='size':cfg['size']=max(64,min(180,int(value)))
    elif action=='here':
        cfg.update(roaming=False,anchorManual=True)
        rows=json.loads(run(['hyprctl','monitors','-j']).stdout)
        cfg['output']=next((m['name'] for m in rows if m.get('focused')),'')
    elif action=='follow':cfg.update(output='',roaming=False,anchorManual=True)
    elif action in ('wave','celebrate','think','sleep','walk','dance','read','sip','stretch','stargaze','juggle','robot','plane','sketch','explore','garden','guitar'):
        cfg.update(pose=action,poseAt=time.time())
        if action=='wave':cfg.update(message='Hello, engineer. What are we building?',messageAt=time.time())
    elif action=='say':
        if not value or not value.strip():raise ValueError('Give the companion a short message')
        cfg.update(message=value.strip()[:160],messageAt=time.time())
    elif action=='chatter':cfg['chatter']=value=='on' if value else not cfg.get('chatter',True)
    elif action=='motion':
        if value not in ('on','off'):raise ValueError('Use motion on or off')
        cfg['reducedMotion']=value=='off'
        if value=='off':cfg.update(roaming=False,anchorManual=True)
    elif action in ('more','less'):
        rendered=read(STATE/'companion-render.json')
        if action=='less' and isinstance(rendered.get('lastNote'),int) and rendered['lastNote']>=0:
            cfg['hiddenNotes']=list(dict.fromkeys(cfg.get('hiddenNotes',[])+[rendered['lastNote']]))
        elif action=='more' and rendered.get('noteKind') in ('wit','memory','wonder','tip'):
            cfg['favoriteKinds']=list(dict.fromkeys(cfg.get('favoriteKinds',[])+[rendered['noteKind']]))
        cfg['tipAt']=time.time()
    elif action=='tip':cfg['tipAt']=time.time()
    elif action!='status':raise ValueError('Unsupported companion action')
    if action!='status':write(CONFIG/'companion.json',cfg)
    if action=='tour':
        presence=read(STATE/'presence.json');companion_tick(bool(presence.get('peer')) and time.time()-presence.get('time',0)<30)
    return cfg


def mode(value):
    cfg=read(CONFIG/'continuity.json');old=cfg.get('mode','auto');cfg['mode']=value
    marker=PRIVATE/'input/user-paused'
    if host()=='arete' and value in ('away','homie') and old not in ('away','homie'):
        cfg['resumeSharing']=service('den-input')=='active' and not marker.exists()
    write(CONFIG/'continuity.json',cfg)
    if host()=='arete' and value in ('away','homie'):
        r=run([str(HOME/'.local/bin/den-control'),'home'],timeout=10)
        if r.returncode:raise ValueError('Could not confirm capture release; use Ctrl+Alt+Esc')
        cfg['awayPauseStamp']=marker.stat().st_mtime_ns if marker.exists() else None
        write(CONFIG/'continuity.json',cfg)
    if host()=='arete':
        try:remote([str(HOME/'.local/bin/sensei-den'),'mode','homie' if value in ('away','homie') else 'auto'])
        except (ValueError,OSError,subprocess.SubprocessError):pass
        if value in ('auto','together') and old in ('away','homie'):
            if cfg.get('resumeSharing') and marker.exists() and marker.stat().st_mtime_ns==cfg.get('awayPauseStamp'):
                marker.unlink()
            cfg.pop('resumeSharing',None);cfg.pop('awayPauseStamp',None);write(CONFIG/'continuity.json',cfg)
    return {**current_mode(),'notice':'Display inputs and USB must be physically connected to their owner; software does not move cables.'}


def sync_status():
    cfg=read(CONFIG/'sync.json')
    result=[]
    for f in cfg.get('folders',[]):
        p=Path(f['path']);disk=shutil.disk_usage(p if p.exists() else p.parent)
        result.append({'label':f['label'],'path':str(p),'exists':p.exists(),'freeGiB':round(disk.free/2**30,1),'floorGiB':f.get('floorGiB',20)})
    api=[]
    if cfg.get('folders') and service('syncthing')=='active':
        from urllib.parse import urlencode
        for f in cfg['folders']:
            d=sync_api('GET','db/status?'+urlencode({'folder':f['id']}))
            api.append({'label':f['label'],'state':d.get('state'),'neededFiles':d.get('needFiles'),
                        'neededBytes':d.get('needBytes'),'localFiles':d.get('localFiles')})
    return {'folders':result,'service':service('syncthing'),'completion':api,'contentPolicy':'Personal files mirrored; Git repositories and application state use separate handoffs.'}


def sync_api(method,path,body=None):
    import urllib.request
    import xml.etree.ElementTree as E
    tree=E.parse(HOME/'.local/state/syncthing/config.xml').getroot()
    address=tree.findtext('gui/address');key=tree.findtext('gui/apikey')
    if not address or not re.fullmatch(r'127\.0\.0\.1:\d+',address):raise ValueError('Syncthing API must remain loopback-only')
    req=__import__('urllib.request',fromlist=['Request']).Request('http://'+address+'/rest/'+path,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'X-API-Key':key,'Content-Type':'application/json'},method=method)
    with urllib.request.urlopen(req,timeout=15) as r:
        data=r.read();return json.loads(data) if data else {}


def backup_reserve(cfg):
    """Fail closed if a mounted target disappears or reaches its free-space floor."""
    repository=cfg['repository']
    if repository.startswith('sftp:'):
        target=cfg.get('remoteTarget')
        if not target:raise ValueError('Remote backup target must be explicitly configured')
        code=('import os,json;from pathlib import Path;p=Path('+repr(target)+');'
              'assert os.path.ismount('+repr(cfg['requiredMount'])+'),"Backup disk is not mounted";'
              's=os.statvfs(p);print(json.dumps({"free":s.f_bavail*s.f_frsize}))')
        free=json.loads(remote(['python3','-c',code],timeout=10))['free']
        floor=cfg.get('remoteMinimumFreeGiB',20)
    else:
        if cfg.get('requiredMount') and not os.path.ismount(cfg['requiredMount']):
            raise ValueError('Backup disk is not mounted')
        free=shutil.disk_usage(Path(repository).parent).free;floor=cfg.get('minimumFreeGiB',20)
    if free<floor*2**30:raise ValueError('Backup target reserve reached; existing snapshots preserved')
    return free


def guarded_backup(command,cfg,env):
    # Logs stay private and bounded; the capacity watchdog survives a quiet Restic.
    import tempfile
    backup_reserve(cfg)
    with tempfile.TemporaryFile(mode='w+') as output,tempfile.TemporaryFile(mode='w+') as errors:
        process=subprocess.Popen(command,stdout=output,stderr=errors,text=True,env=env)
        try:
            deadline=time.monotonic()+7200
            while True:
                try:code=process.wait(timeout=15);break
                except subprocess.TimeoutExpired:
                    if time.monotonic()>deadline:raise ValueError('Backup exceeded its time limit')
                    backup_reserve(cfg)
        except BaseException:
            process.terminate()
            try:process.wait(timeout=15)
            except subprocess.TimeoutExpired:process.kill();process.wait()
            raise
        output.seek(0);return subprocess.CompletedProcess(command,code,output.read(), '')


def backup(action):
    cfg=read(CONFIG/'backup.json')
    if not cfg:return {'configured':False,'reason':'No local backup target configured'}
    repository=cfg['repository'];repo=Path(repository) if not repository.startswith('sftp:') else None;password=Path(cfg['passwordFile'])
    env=dict(os.environ,RESTIC_REPOSITORY=repository,RESTIC_PASSWORD_FILE=str(password))
    binary=shutil.which('restic')
    if not binary:raise ValueError('Restic is not installed')
    if action=='status':return {'configured':True,'repository':repository,'last':read(STATE/'backup-status.json'),'scope':'local only'}
    base=[binary]+(['-o','sftp.command='+cfg['sftpCommand']] if cfg.get('sftpCommand') else [])
    if not password.exists():raise ValueError('Backup password file missing; do not initialize another repository')
    if action=='peer-copy':
        peer=cfg.get('peerCopy')
        if not peer:return {'configured':False,'reason':'No peer snapshot copy configured on this host'}
        target=Path(peer['repository']);target.parent.mkdir(parents=True,exist_ok=True)
        guard={'repository':str(target),'minimumFreeGiB':peer.get('minimumFreeGiB',80)};backup_reserve(guard)
        copyenv=dict(os.environ,RESTIC_REPOSITORY=str(target),RESTIC_PASSWORD_FILE=peer['passwordFile'],
                     RESTIC_FROM_REPOSITORY=peer['fromRepository'],RESTIC_FROM_PASSWORD_FILE=peer['passwordFile'])
        copybase=[binary,'-o','sftp.command='+cfg['sftpCommand']]
        if not (target/'config').exists():
            r=run([*copybase,'init','--copy-chunker-params'],timeout=90,env=copyenv)
            if r.returncode:raise ValueError('Peer snapshot destination initialization failed')
        r=guarded_backup([*copybase,'copy'],guard,copyenv)
        if r.returncode:raise ValueError('Peer snapshot copy failed; existing snapshots remain')
        result={'ok':True,'finished':time.time(),'repository':str(target),'scope':'Homie snapshots copied onto Arete'}
        write(STATE/'peer-copy-status.json',result);return result
    if action=='run':
        paths=[str(Path(p)) for p in cfg['paths'] if Path(p).exists()]
        if not paths:raise ValueError('No backup sources exist')
        command=[*base,'backup','--json','--tag','digital-den']
        for p in cfg.get('exclude',[]):command+=['--exclude',p]
        try:r=guarded_backup([*command,*paths],cfg,env)
        except (OSError,ValueError,subprocess.SubprocessError):
            write(STATE/'backup-status.json',{'finished':datetime.datetime.now(datetime.timezone.utc).isoformat(),
                'ok':False,'reason':'Backup interrupted, target unavailable, or reserve reached; inspect private diagnostics'})
            run(['notify-send','-a','Digital Den','Backup needs attention','Existing snapshots remain available'],timeout=3)
            raise
        # Exit 3 is an incomplete backup, never a successful checkpoint.
        result={'finished':datetime.datetime.now(datetime.timezone.utc).isoformat(),'ok':r.returncode==0,'exitCode':r.returncode}
        summaries=[]
        for line in r.stdout.splitlines():
            try:
                d=json.loads(line)
                if d.get('message_type')=='summary':summaries.append(d)
            except ValueError:pass
        result['summary']=summaries[-1] if summaries else {};write(STATE/'backup-status.json',result)
        if r.returncode:raise ValueError('Backup incomplete; private Restic diagnostics require review')
        return result
    if action in ('retain','retain-preview'):
        # Preview and apply share exactly the same tagged retention policy.
        command=[*base,'forget','--tag','digital-den','--keep-daily','7',
                 '--keep-weekly','4','--keep-monthly','3']
        preview=action=='retain-preview'
        command+=['--dry-run','--json'] if preview else ['--prune']
        r=run(command,timeout=7200,env=env)
        if r.returncode:raise ValueError('Retention did not complete; inspect private Restic diagnostics')
        result={'ok':True,'preview':preview,'policy':'7 daily / 4 weekly / 3 monthly; digital-den snapshots only'}
        if preview:result['snapshots']=json.loads(r.stdout)
        return result
    if action=='check':
        r=run([*base,'check','--read-data-subset=10%'],timeout=3600,env=env)
        return {'ok':r.returncode==0,'scope':'repository metadata and sampled data'}
    if action=='restore-test':
        import tempfile,hashlib
        marker=STATE/'restore-proof.txt';marker.parent.mkdir(parents=True,exist_ok=True);marker.write_text('Digital Den recovery proof\n')
        r=run([*base,'backup','--tag','den-restore-proof',str(marker)],timeout=300,env=env)
        if r.returncode:raise ValueError('Recovery fixture backup failed')
        with tempfile.TemporaryDirectory(prefix='den-restore-') as d:
            r=run([*base,'restore','latest','--tag','den-restore-proof','--target',d],timeout=300,env=env)
            restored=Path(d)/str(marker).lstrip('/')
            ok=r.returncode==0 and restored.exists() and hashlib.sha256(restored.read_bytes()).digest()==hashlib.sha256(marker.read_bytes()).digest()
        if not ok:raise ValueError('Recovery fixture checksum failed')
        result={'ok':True,'checkedAt':time.time(),'method':'Restic snapshot restored to a different temporary directory; SHA256 matched'}
        write(STATE/'restore-status.json',result);return result
    raise ValueError('Unsupported backup action')


def receive_artifact(record,destination):
    if record.get('bytes',0)>8*1024*1024 or len(record.get('data',''))>12*1024*1024:raise ValueError('Artifact exceeds the small-transfer limit')
    data=base64.b64decode(record['data'],validate=True)
    if hashlib.sha256(data).hexdigest()!=record['sha256']:raise ValueError('Artifact checksum mismatch')
    p=Path(destination).expanduser()
    descriptor=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(descriptor,'wb') as f:f.write(data);f.flush();os.fsync(f.fileno())
    return {'path':str(p),'bytes':len(data),'sha256':record['sha256']}


def job(args):
    if args.host and args.host!=host():
        command=[str(HOME/'.local/bin/sensei-den'),'job',args.action]
        if args.project:command+=['--project',args.project]
        if getattr(args,'memory_mib',None):command+=['--memory-mib',str(args.memory_mib)]
        if getattr(args,'cpu_percent',None):command+=['--cpu-percent',str(args.cpu_percent)]
        if args.id:command+=['--id',args.id]
        for item in getattr(args,'input',[]) or []:command+=['--input',item]
        for item in getattr(args,'artifact',[]) or []:command+=['--artifact',item]
        if getattr(args,'file',None):command+=['--file',args.file]
        command+=['--',*args.command] if args.command else []
        result=json.loads(remote(command,timeout=20,private=True))
        if args.action=='fetch' and getattr(args,'output',None):return receive_artifact(result,args.output)
        return result
    directory=STATE/'jobs';directory.mkdir(parents=True,exist_ok=True,mode=0o700)
    if args.action=='run':
        sys.path.insert(0,str(HOME/'.local/share/sensei'))
        from den_job import submission
        with submission(directory):
            if getattr(args,'memory_mib',None) is not None and not 32<=args.memory_mib<=1048576:raise ValueError('Memory limit must be 32–1048576 MiB')
            if getattr(args,'cpu_percent',None) is not None and not 1<=args.cpu_percent<=10000:raise ValueError('Invalid CPU quota')
            project=Path(args.project or Path.cwd()).resolve()
            command=args.command[1:] if args.command[:1]==['--'] else args.command
            if not project.is_dir() or not command:raise ValueError('Choose an existing project and command')
            ident=datetime.datetime.now().strftime('%Y%m%dT%H%M%S')+'-'+os.urandom(3).hex();unit='den-job-'+ident
            log=directory/(ident+'.log');meta={'id':ident,'host':host(),'unit':unit,'project':str(project),'command':command,'created':time.time(),
                'commit':run(['git','-C',str(project),'rev-parse','HEAD']).stdout.strip(),'dirty':bool(run(['git','-C',str(project),'status','--porcelain']).stdout),
                'schema':1,'state':'queued','requestedResources':{'memoryMiB':getattr(args,'memory_mib',None),'cpuPercent':getattr(args,'cpu_percent',None)},'inputs':[],'expectedArtifacts':getattr(args,'artifact',[]) or []}
            sys.path.insert(0,str(HOME/'.local/share/sensei'))
            from den_job import checked_input
            for name in getattr(args,'input',[]) or []:
                meta['inputs'].append(checked_input(project,name))
            for name in meta['expectedArtifacts']:
                if not (project/name).resolve().is_relative_to(project):raise ValueError('Artifact must stay inside the project')
            write(directory/(ident+'.json'),meta)
            limits=[]
            if getattr(args,'memory_mib',None):limits+=['--property=MemoryMax='+str(args.memory_mib)+'M']
            if getattr(args,'cpu_percent',None):limits+=['--property=CPUQuota='+str(args.cpu_percent)+'%']
            r=run(['systemd-run','--user',*limits,'--unit',unit,'--property=WorkingDirectory='+str(project),
                '--property=UMask=0077','--property=Nice=5','--property=StandardOutput=append:'+str(log),
                '--property=StandardError=append:'+str(log),'--',sys.executable,str(HOME/'.local/share/sensei/den_job.py'),str(directory/(ident+'.json'))])
            if r.returncode:
                meta.update(state='start-failed');write(directory/(ident+'.json'),meta)
                raise ValueError('Job could not start; no command was replayed')
            return meta
    if args.action=='list':
        rows=[read(p) for p in sorted(directory.glob('*.json'))][-30:]
        for row in rows:
            row['unitState']=service(row['unit'])
            if row.get('state') in ('queued','running') and row['unitState'] in ('failed','inactive') and time.time()-row.get('created',time.time())>5:
                row.update(state='interrupted',finished=time.time(),reason='Owned unit stopped before its final receipt')
                write(directory/(row['id']+'.json'),row)
        return rows
    if not args.id or not re.fullmatch(r'[A-Za-z0-9-]{1,60}',args.id):raise ValueError('Invalid job ID')
    meta=read(directory/(args.id+'.json'))
    if not meta:raise ValueError('Unknown owned job')
    if args.action=='artifacts':return {'id':args.id,'artifacts':meta.get('artifacts',[]),'errors':meta.get('artifactErrors',[])}
    if args.action=='fetch':
        sys.path.insert(0,str(HOME/'.local/share/sensei'))
        from den_job import artifact
        name=getattr(args,'file',None)
        record=next((x for x in meta.get('artifacts',[]) if x['path']==name),None)
        if not record:raise ValueError('Only a recorded artifact can be fetched')
        current=artifact(meta['project'],name)
        if current!=record:raise ValueError('Artifact changed since this job; original checksum does not match')
        if current['bytes']>8*1024*1024:raise ValueError('Use explicit file transfer for artifacts larger than 8 MiB')
        result={**record,'data':base64.b64encode((Path(meta['project'])/name).read_bytes()).decode()}
        return receive_artifact(result,args.output) if getattr(args,'output',None) else result
    if args.action=='logs':return {'id':args.id,'text':(directory/(args.id+'.log')).read_text(errors='replace')[-24000:]}
    if args.action=='cancel':
        result=run(['systemctl','--user','stop',meta['unit']])
        if result.returncode:raise ValueError('Owned job could not be stopped')
        meta=read(directory/(args.id+'.json'));meta.update(state='cancelled',finished=time.time())
        write(directory/(args.id+'.json'),meta)
        return {'id':args.id,'state':'cancelled'}
    r=run(['systemctl','--user','show',meta['unit'],'--property=ActiveState,Result,ExecMainStatus'])
    return {**meta,'status':r.stdout.strip()}


def service_health():
    """Include restart loops: --failed alone misses activating/auto-restart."""
    issues=[]
    for scope, options in [('user',['--user']),('system',[])]:
        try:
            result=run(['systemctl',*options,'list-units','--all','--output=json','--no-pager'])
            if result.returncode:raise ValueError('Service query failed')
            rows=json.loads(result.stdout)
            if not isinstance(rows,list):raise ValueError('Invalid service response')
            for row in rows:
                if not isinstance(row,dict):raise ValueError('Invalid service entry')
                unit=row.get('unit','')
                if row.get('active')=='failed' or row.get('sub')=='auto-restart' or row.get('load') in ('error','bad-setting'):
                    issues.append({'scope':scope,'unit':unit,'state':row.get('sub') or row.get('active')})
        except (OSError,ValueError,TypeError,subprocess.SubprocessError):
            issues.append({'scope':scope,'unit':None,'state':'diagnostics unavailable'})
    return {'ok':not issues,'issues':issues}


def doctor():
    compositor=run(['hyprctl','configerrors'])
    checks={'layout':(CONFIG/'layout.json').is_file(),'companionAsset':all((HOME/'.local/share/sensei-companion'/name).is_file() for name in ('fh1m-motion-v2.png','zondo-life-v2.png','den-welcome-v1.png')),
        'git':shutil.which('git') is not None,'rsync':shutil.which('rsync') is not None,'ssh':shutil.which('ssh') is not None,
        'syncthing':shutil.which('syncthing') is not None,'restic':shutil.which('restic') is not None,
        'hyprland':compositor.returncode==0 and compositor.stdout.strip()==''}
    health=service_health();checks['services']=health['ok']
    return {'checks':checks,'services':health,'status':status(),'remaining':read(STATE/'pending.json',[]),
            'scope':'Runtime health; physical boot, suspend and cable handoff require separate acceptance'}


def workbench(action):
    unit='app-dev.lizardbyte.app.Sunshine'
    if host()!='arete':raise ValueError('Open the remote workbench from Arete')
    cfg=read(CONFIG/'workbench.json')
    if not cfg:raise ValueError('Private Moonlight pairing has not been configured')
    lock=None
    if action=='open':
        import fcntl
        STATE.mkdir(parents=True,exist_ok=True,mode=0o700);lock=(STATE/'workbench.lock').open('a')
        try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:raise ValueError('Homie desk is already open')
    if action=='status':
        text=remote(['systemctl','--user','show',unit,'--property=ActiveState','--value'],private=True)
        return {'host':'homie','service':text.strip()}
    if action=='stop':remote(['systemctl','--user','stop',unit],private=True);return {'stopped':True}
    code=('import json,subprocess;'
          'x=json.loads(subprocess.check_output(["hyprctl","instances","-j"]))[0];'
          'subprocess.run(["systemctl","--user","set-environment","WAYLAND_DISPLAY="+x["wl_socket"],'
          '"HYPRLAND_INSTANCE_SIGNATURE="+x["instance"],"XDG_SESSION_TYPE=wayland"],check=True);'
          'subprocess.run(["systemctl","--user","start",'+repr(unit)+'],check=True)')
    remote(['python3','-c',code],timeout=25,private=True)
    if action=='start':return {'started':True,'scope':'private network; on demand'}
    if action!='open':raise ValueError('Unsupported workbench action')
    was_sharing=service('den-input')=='active'
    if was_sharing:run([str(HOME/'.local/bin/den-control'),'home'],timeout=10)
    try:
        remote(['python3',str(PRIVATE/'den-cursor.py'),'owner-on'],private=True)
        env=dict(os.environ)
        env['XDG_CONFIG_HOME']=str(HOME/'.config/den-moonlight')
        if not env.get('WAYLAND_DISPLAY'):
            x=json.loads(run(['hyprctl','instances','-j']).stdout)[0]
            env.update(WAYLAND_DISPLAY=x['wl_socket'],HYPRLAND_INSTANCE_SIGNATURE=x['instance'])
        result=subprocess.run(['moonlight','stream',cfg['host'],'Desktop','--1080','--fps','60',
            '--bitrate','25000','--display-mode','windowed','--absolute-mouse','--capture-system-keys','never',
            '--video-codec','HEVC','--audio-on-host'],env=env)
        if result.returncode:raise ValueError('Remote desk closed with an error; local input remains available')
        return {'closed':True}
    finally:
        try:remote(['systemctl','--user','stop',unit],private=True)
        except (ValueError,OSError,subprocess.SubprocessError):pass
        if was_sharing and connectivity():
            try:remote(['python3',str(PRIVATE/'den-cursor.py'),'owner-off'])
            except (ValueError,OSError,subprocess.SubprocessError):pass
            run([str(HOME/'.local/bin/den-control'),'start'],timeout=10)


def companion_tick(peer):
    STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
    with (STATE/'companion-route.lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        return _companion_tick(peer)

def _companion_tick(peer):
    local_host=host()
    if local_host!='arete' and peer:return
    cfg=read(CONFIG/'companion.json')
    if not cfg.get('roaming') or cfg.get('quiet') or cfg.get('suspended') or not cfg.get('enabled',True):return
    state=read(STATE/'companion-route.json');now=time.time()
    # A failed peer transfer keeps the source hidden until its last lease expires.
    remote_until=state.get('remoteUntil',0)
    if not peer and remote_until>now:return
    token=max(time.time_ns(),state.get("lastToken",0)+1)
    state["lastToken"]=token
    local=json.loads(run(['hyprctl','monitors','-j']).stdout)
    music=zondo_playing();repertoire=companion_memory()
    from companion_roam import engineering_events,engineering_acks,music_line,notification_receipt,notification_acks
    line=music_line(read(STATE/'zondo-music.json'))
    desk_notices=[notification_receipt(read(STATE/'companion-notifications.json'),local_host)]
    notice_acks=notification_acks(read(STATE/'zondo-notice-seen.json',{'ids':[]}).get('ids',[]))
    acks=engineering_acks(read(STATE/'zondo-engineering-seen.json',{'ids':[]}).get('ids',[]))
    events=engineering_events(read(HOME/'.local/state/sensei-engineering/receipts.json',{'events':[]}).get('events',[]))
    available=companion_available()
    destinations=[(local_host,m['name']) for m in local if m['name'] in available]
    if peer and local_host=='arete':
        try:
            capability=json.loads(remote([str(HOME/'.local/bin/sensei-den'),'companion','protocol'],timeout=4))
            music=music or capability.get('musicPlaying') is True
            peer_line=music_line(capability.get('musicLine'))
            peer_notice=notification_receipt(capability.get('deskNotices'),'homie')
            if peer_notice:desk_notices.append(peer_notice)
            notice_acks=notification_acks(notice_acks+capability.get('noticeAcks',[]))
            if peer_line.get('at',0)>line.get('at',0):line=peer_line
            events=engineering_events(events+capability.get('engineeringEvents',[]))
            acks=engineering_acks(acks+capability.get('engineeringAcks',[]))
            sys.path.insert(0,str(HOME/'.local/share/sensei'))
            from companion_roam import newer_memory
            repertoire=newer_memory(repertoire,capability.get('memory',{}))
            if capability.get('schema')==1 and capability.get('leases') and capability.get('enabled') and not capability.get('quiet') and not capability.get('suspended') and not capability.get('reducedMotion'):
                destinations += [('homie',m['name']) for m in json.loads(remote(['hyprctl','-i','0','monitors','-j'],timeout=4)) if m['name'] in capability.get('availableOutputs',[])]
        except (ValueError,OSError,subprocess.SubprocessError):pass
    if not destinations:return
    capability=locals().get('capability',{})
    rendered=read(STATE/'companion-render.json')
    talking=(rendered.get('speaking') and rendered.get('speechVisible')) or (peer and capability.get('render',{}).get('speaking') and capability.get('render',{}).get('speechVisible'))
    advance=(now>=state.get('next',0) and not talking) or cfg.get('tourAt',0)>state.get('tourAt',0)
    chosen=state.get('destination')
    if not chosen or tuple(chosen) not in destinations or advance:
        current=destinations.index(tuple(chosen)) if chosen and tuple(chosen) in destinations else -1
        chosen=destinations[(current+1)%len(destinations)]
        state.update(destination=chosen,next=now+25+int.from_bytes(os.urandom(1))%21,tourAt=cfg.get('tourAt',0))
    # Receipts drive a bounded courier story; never infer a finished job.
    scene=''
    submitted=sorted((e for e in events if e['kind']=='job.submitted' and e['host']=='homie' and e.get('data',{}).get('job')),key=lambda e:e['at'])
    finished={e.get('data',{}).get('job'):e for e in events if e['kind']=='job.completed' and e['host']=='homie'}
    courier=state.get('courier',{})
    done=state.get('delivered',[])[-32:]
    if not courier and submitted:
        first=next((e for e in submitted if e['data']['job'] not in done),None)
        if first:courier={'job':first['data']['job'],'stage':'pack','at':now}
    if courier and now-courier.get('at',0)<1800:
        if courier['job'] in finished:
            chosen=(local_host,next((m['name'] for m in local if m.get('focused')),local[0]['name']));scene='parcel'
            if remote_until<=now:done.append(courier['job']);courier={}
        elif courier.get('stage')=='pack':
            chosen=(local_host,next((m['name'] for m in local if m.get('focused')),local[0]['name']));scene='courier'
            courier['stage']='travel'
        else:
            peer_dest=next((d for d in destinations if d[0]=='homie'),None)
            if peer_dest:chosen=peer_dest;scene='courier'
    elif courier:courier={}
    state.update(courier=courier,delivered=done[-32:])
    target_host,output=chosen
    if target_host!=local_host:
        # Hide first; a lost acknowledgement cannot create a second visible character.
        companion('grant',json.dumps({'output':'','token':token,'ttl':45}))
        state['remoteUntil']=now+45;write(STATE/'companion-route.json',state)
        remote([str(HOME/'.local/bin/sensei-den'),'companion','grant',json.dumps({'output':output,'token':token,'ttl':40,'musicPlaying':music,'musicLine':line,'deskNotices':desk_notices,'noticeAcks':notice_acks,'memory':repertoire,'engineeringEvents':events,'engineeringAcks':acks,'scene':scene})],timeout=4)
    else:
        if remote_until>now:
            try:
                remote([str(HOME/'.local/bin/sensei-den'),'companion','grant',json.dumps({'output':'','token':token,'ttl':0})],timeout=4)
                state['remoteUntil']=0
            except (ValueError,OSError,subprocess.SubprocessError):return
        companion('grant',json.dumps({'output':output,'token':token,'ttl':40,'musicPlaying':music,'musicLine':line,'deskNotices':desk_notices,'noticeAcks':notice_acks,'memory':repertoire,'engineeringEvents':events,'engineeringAcks':acks,'scene':scene}))
        state['remoteUntil']=0
    write(STATE/'companion-route.json',state)


def topology_signature():
    rows=json.loads(run(['hyprctl','monitors','-j']).stdout)
    return sorted((m['name'],m.get('x'),m.get('y'),m.get('width'),m.get('height'),m.get('scale')) for m in rows)

def refresh_capture_routes(previous,current,active,usable):
    if previous is None or previous==current or not active:return False
    # Stop the native capture first: its Wayland teardown releases keyboard/mouse.
    # This is a topology update, not a user pause; never clear a real user pause.
    result=run(['systemctl','--user','stop','den-input'],timeout=10)
    if result.returncode:raise ValueError('Capture could not release for a display change')
    if usable and not (PRIVATE/'input/user-paused').exists():
        run([str(HOME/'.local/bin/den-control'),'start'],timeout=10)
    return True


def watch():
    previous=None;previous_mode=None;previous_topology=None
    while True:
        try:
            peer=connectivity();state=current_mode(peer)
            try:companion_tick(peer and state['effective']=='together')
            except (ValueError,OSError,subprocess.SubprocessError):pass
            write(STATE/'presence.json',{'host':host(),'peer':peer,'mode':state,'time':time.time()})
            if host()=='arete':
                active=service('den-input')=='active';paused=(PRIVATE/'input/user-paused').exists()
                usable=peer and state['effective']=='together'
                topology=topology_signature()
                if refresh_capture_routes(previous_topology,topology,active,usable):active=service('den-input')=='active'
                previous_topology=topology
                if (not usable or paused) and active:
                    with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as s:s.sendto(b'peer-lost',str(PRIVATE/'cursor.sock'))
                elif usable and not active and not paused:
                    run([str(HOME/'.local/bin/den-control'),'start'],timeout=10)
            elif not peer or state['effective']=='homie':
                with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as s:s.sendto(b'owner-on',str(PRIVATE/'cursor.sock'))
            elif previous_mode=='homie' and state['effective']=='together':
                with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as s:s.sendto(b'owner-off',str(PRIVATE/'cursor.sock'))
            previous_mode=state['effective']
            if previous is not None and peer!=previous:
                run(['notify-send','-a','Digital Den','Homie connected' if peer else 'Den peer unavailable','Local work remains available'],timeout=3)
            previous=peer
        except (OSError,ValueError,subprocess.SubprocessError):pass
        time.sleep(15)


def main():
    p=argparse.ArgumentParser(description=__doc__);s=p.add_subparsers(dest='command_name',required=True)
    for n in ['status','doctor','watch']:s.add_parser(n)
    q=s.add_parser('mode');q.add_argument('value',nargs='?',choices=['auto','together','away','homie'])
    q=s.add_parser('companion');q.add_argument('action',nargs='?',default='status',choices=['status','activity','activity-hide','activity-favorite','talk','remember','toggle','show','hide','quiet','suspended','here','follow','size','wave','celebrate','think','sleep','walk','dance','read','sip','stretch','stargaze','juggle','robot','plane','sketch','explore','garden','guitar','say','chatter','motion','tip','more','less','roam','tour','hide-seek','found','pulse','dim','grant','protocol','guest','guests','guest-mode','guest-frequency']);q.add_argument('value',nargs='?')
    q=s.add_parser('sync');q.add_argument('action',nargs='?',default='status',choices=['status','scan','pause','resume'])
    q=s.add_parser('backup');q.add_argument('action',nargs='?',default='status',choices=['status','run','check','restore-test','retain','retain-preview','peer-copy'])
    q=s.add_parser('workbench');q.add_argument('action',nargs='?',default='open',choices=['open','start','stop','status'])
    q=s.add_parser('job');q.add_argument('action',choices=['run','list','status','logs','cancel','artifacts','fetch']);q.add_argument('--host');q.add_argument('--project');q.add_argument('--id');q.add_argument('--input',action='append');q.add_argument('--artifact',action='append');q.add_argument('--file');q.add_argument('--output');q.add_argument('--memory-mib',type=int);q.add_argument('--cpu-percent',type=int);
    argv=sys.argv[1:];job_command=[]
    if '--' in argv:
        i=argv.index('--');job_command=argv[i+1:];argv=argv[:i]
    a=p.parse_args(argv);a.command=job_command
    if a.command_name=='status':return status()
    if a.command_name=='doctor':return doctor()
    if a.command_name=='watch':return watch()
    if a.command_name=='mode':return mode(a.value) if a.value else current_mode()
    if a.command_name=='companion':return companion(a.action,a.value)
    if a.command_name=='backup':return backup(a.action)
    if a.command_name=='workbench':return workbench(a.action)
    if a.command_name=='job':return job(a)
    if a.command_name=='sync':
        if a.action=='scan':sync_api('POST','db/scan')
        elif a.action in ('pause','resume'):sync_api('POST','system/'+a.action)
        return sync_status()


if __name__=='__main__':
    os.umask(0o077)
    try:print(json.dumps(main(),ensure_ascii=False,indent=2))
    except (OSError,ValueError,KeyError,subprocess.SubprocessError) as e:
        print(json.dumps({'error':str(e) if isinstance(e,ValueError) else 'Den operation unavailable; existing data preserved'}));sys.exit(1)
