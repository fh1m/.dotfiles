#!/usr/bin/env bun
import { createHash } from "node:crypto";
import { homedir } from "node:os";
import path from "node:path";
import { readProfileUsage } from "/home/fh1m/.local/share/sensei/codex_app_server.ts";
import { openaiCodexUsageProvider } from "/home/fh1m/.bun/install/global/node_modules/@oh-my-pi/pi-ai/src/usage/openai-codex.ts";
import { discoverAuthStorage } from "/home/fh1m/.bun/install/global/node_modules/@oh-my-pi/pi-ai/src/auth-broker/discover.ts";

const home=homedir(), agentDir=process.env.OMP_AGENT_DIR || path.join(home,".omp");
const statePath=path.join(home,".config/sensei/codex-accounts.json");
const args=Bun.argv.slice(2), command=args[0];
const value=(key:string)=>{const at=args.indexOf(key);return at>=0?args[at+1]:undefined};
const hash=(s:string)=>createHash("sha256").update(s).digest("hex").slice(0,24);
const fail=(message:string):never=>{console.error(message);process.exit(2)};
if(!["list","usage","add","remove"].includes(command))fail("Usage: sensei-codex-accounts list|usage|add|remove [--account ID] [--profile DIR --name NAME] [--refresh]");
const stateFile=Bun.file(statePath);
let state:any={schema:1,monitored:{},cache:{},profiles:{}};
if(await stateFile.exists()){try{state=await stateFile.json();if(state.schema!==1||typeof state.monitored!=="object"||typeof state.cache!=="object")throw Error();if(!state.profiles)state.profiles={};if(typeof state.profiles!=="object")throw Error();}catch{fail("Account monitor state is invalid");}}
const save=async()=>{await Bun.write(statePath,JSON.stringify(state));await Bun.$`chmod 600 ${statePath}`;};
const storage=await discoverAuthStorage({agentDir});
try {
 const native=storage.oauth.accounts("openai-codex").map((a:any)=>{const identity=a.accountId||a.email||`credential:${a.credentialId}`;return {id:hash(`omp\0${identity}\0${a.orgId||""}`),identity,source:"omp",credentialId:a.credentialId,name:a.email||a.accountId||`Codex account ${a.position+1}`,email:a.email,accountId:a.accountId};});
 const profileDir=value("--profile");
 if(command==="add"&&profileDir){const resolved=path.resolve(profileDir);if(!await Bun.file(path.join(resolved,"auth.json")).exists())fail("Profile has no existing Codex auth.json");const measured=await readProfileUsage({executable:process.env.CODEX_EXECUTABLE||path.join(home,".local/bin/codex"),profileDir:resolved}).catch(()=>null);if(!measured)fail("Could not identify existing Codex profile without changing authentication");const accountIdentity=measured.identity;const id=hash(`profile\0${resolved}\0${accountIdentity}`);state.profiles[id]={id,profileDir:resolved,identity:accountIdentity,email:measured.account.email,name:value("--name")||path.basename(resolved)};state.monitored[id]={source:"profile",identity:accountIdentity,name:state.profiles[id].name};await save();console.log(JSON.stringify({ok:true,accountId:id}));}
 const profiles=Object.values(state.profiles) as any[];
 const all=[...native,...profiles.map(p=>({id:p.id,identity:p.identity,source:"profile",name:p.name,email:p.email,profileDir:p.profileDir}))];
 if(command==="list") {console.log(JSON.stringify({accounts:all.map(a=>({id:a.id,name:a.name,source:a.source,identity:a.identity,...(a.email?{email:a.email}:{}),monitored:Boolean(state.monitored[a.id])})),fetchedAt:Date.now()/1000}));}
 else if(command==="add") {const id=value("--account");if(!id)fail("add requires --account ID or --profile DIR");const account=all.find(a=>a.id===id);if(!account)fail("Account not discovered");state.monitored[id]={source:account.source,identity:account.identity,name:account.name};await save();console.log(JSON.stringify({ok:true,accountId:id}));}
 else if(command==="remove") {const id=value("--account");if(!id)fail("remove requires --account ID");delete state.monitored[id];delete state.cache[id];await save();console.log(JSON.stringify({ok:true,accountId:id}));}
 else {
  const id=value("--account");if(!id)fail("usage requires --account ID");const account=all.find(a=>a.id===id);const monitored=state.monitored[id];if(!account||!monitored||account.identity!==monitored.identity||account.source!==monitored.source)fail("Monitored account is not currently discovered");
  let result:any;
  try {
   if(account.source==="profile"){
    const report=await readProfileUsage({executable:process.env.CODEX_EXECUTABLE||path.join(home,".local/bin/codex"),profileDir:account.profileDir,expectedIdentity:account.identity,signal:AbortSignal.timeout(15000)});
    result={provider:"codex",account:report.account,rateLimits:report.rateLimits,limits:report.limits,fetchedAt:report.fetchedAt,measurementAt:report.measurementAt,source:report.source,accountId:id,state:"available"};
   } else {
    const resolution=await storage.oauth.accessById("openai-codex",account.credentialId);
    if(!resolution?.ok)throw Error("Native account access unavailable");
    const report=await openaiCodexUsageProvider.fetchUsage({provider:"openai-codex",credential:{type:"oauth",accessToken:resolution.accessToken,accountId:resolution.accountId},signal:AbortSignal.timeout(10000)},{fetch:fetch});
    if(!report)throw Error("Native usage provider returned no report");
    const limits:any={};for(const l of report.limits){const key=l.id.endsWith(":primary")?"primary":l.id.endsWith(":secondary")?"secondary":l.id;limits[key]={usedPercent:l.amount.usedFraction===undefined?undefined:l.amount.usedFraction*100,remainingPercent:l.amount.remainingFraction===undefined?undefined:l.amount.remainingFraction*100,resetsAt:l.window?.resetsAt===undefined?undefined:l.window.resetsAt/1000,windowMinutes:l.window?.durationMs===undefined?undefined:l.window.durationMs/60000};}
    result={provider:"codex",account:{type:"oauth",email:resolution.email,planType:report.metadata?.planType},rateLimits:{primary:limits.primary,secondary:limits.secondary},limits,fetchedAt:report.fetchedAt/1000,measurementAt:report.fetchedAt/1000,source:"OMP 18.16.0 native read-only usage provider",accountId:id,state:"available"};
   }
   const measuredAt=Number(result.measurementAt??result.fetchedAt),windows=result.rateLimits||{};
   const expired=Object.values(windows).some((window:unknown)=>{if(!window||typeof window!=="object"||!("resetsAt" in window))return false;const reset=window.resetsAt;const epoch=typeof reset==="number"?(reset>1e12?reset/1000:reset):typeof reset==="string"?Date.parse(reset)/1000:NaN;return Number.isFinite(epoch)&&epoch<=Date.now()/1000;});
   if(expired){result.state="expired";result.stale=true;}
   if(!Number.isFinite(measuredAt)||measuredAt>Date.now()/1000+30)throw Error("Invalid native measurement timestamp");
   state.cache[id]={source:account.source,identity:account.identity,result};await save();
  }catch(e){const cached=state.cache[id];result=cached?.source===account.source&&cached?.identity===account.identity?{...cached.result,stale:true,state:"stale",error:"Usage unavailable"}:{provider:"codex",accountId:id,state:"unknown",stale:true,error:"Usage unavailable"};}
  console.log(JSON.stringify(result));
 }
} finally {storage.close();}
