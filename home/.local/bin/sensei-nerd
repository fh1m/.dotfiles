#!/usr/bin/env python3
"""On-demand public GitHub discovery. One-hour cache, offline-safe, no scraper."""
import concurrent.futures
import datetime
import html
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.request
import urllib.parse
import xml.etree.ElementTree as ET

CACHE = Path(os.environ.get('XDG_CACHE_HOME', Path.home()/'.cache'))/'sensei-code/nerd-talk.json'
FEED = 'https://github.blog/changelog/feed/'
QUOTES = [
    {'text':'Don’t be a hero.', 'context':'Start with a proven baseline.', 'author':'Andrej Karpathy'},
    {'text':'overfit one batch', 'context':'Check the smallest case before scaling.', 'author':'Andrej Karpathy'},
    {'text':'complexify only one at a time', 'context':'Make each added mechanism earn its place.', 'author':'Andrej Karpathy'},
]

def repositories(query):
    endpoint='search/repositories?'+urllib.parse.urlencode({'q':query,'sort':'stars','order':'desc','per_page':12})
    result=subprocess.run(['gh','api',endpoint],capture_output=True,text=True,timeout=12)
    if result.returncode:raise RuntimeError('GitHub discovery unavailable; check connection or API allowance.')
    return [{k:r.get(k) for k in ('full_name','description','html_url','stargazers_count','forks_count','open_issues_count','language','pushed_at')} for r in json.loads(result.stdout).get('items',[])]

def news():
    request=urllib.request.Request(FEED,headers={'User-Agent':'fh1m-desktop/1.0'})
    with urllib.request.urlopen(request,timeout=10) as response:
        payload=response.read(2*1024*1024+1)
    if len(payload)>2*1024*1024:raise ValueError('Feed exceeds size limit')
    return [{'title':html.unescape(r.findtext('title','')),'url':r.findtext('link',''),'date':r.findtext('pubDate',''),'summary':html.unescape(re.sub('<[^>]+>',' ',r.findtext('description',''))).strip()[:240]} for r in ET.fromstring(payload).findall('./channel/item')[:12]]

def snapshot(force=False):
    old={}
    try:old=json.loads(CACHE.read_text())
    except (OSError,ValueError):pass
    if not force and time.time()-old.get('fetchedAt',0)<3600:return old
    week=(datetime.date.today()-datetime.timedelta(days=7)).isoformat()
    result={'fetchedAt':time.time(),'quotes':QUOTES,'quoteSource':'https://karpathy.github.io/2019/04/25/recipe/','week':week,'errors':[]}
    for key,fn in [('new',lambda:repositories('created:>='+week+' archived:false fork:false')),('lab',lambda:repositories('(robotics OR slam OR ros2) pushed:>='+week+' archived:false fork:false')),('news',news)]:
        try:result[key]=fn()
        except (OSError,ValueError,RuntimeError,subprocess.SubprocessError,ET.ParseError):result[key]=old.get(key,[]);result['errors'].append(key+' unavailable · cached results retained')
    # A failed refresh must not replace the previous successful timestamp.
    if result['errors']:result['fetchedAt']=old.get('fetchedAt',0)
    CACHE.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    temporary=CACHE.with_suffix('.tmp-'+str(os.getpid()))
    temporary.write_text(json.dumps(result));temporary.chmod(0o600);temporary.replace(CACHE)
    return result


def hn_json(endpoint):
    request=urllib.request.Request('https://hacker-news.firebaseio.com/v0/'+endpoint+'.json',headers={'User-Agent':'fh1m-desktop/1.0'})
    with urllib.request.urlopen(request,timeout=6) as response:
        payload=response.read(1024*1024+1)
    if len(payload)>1024*1024:raise ValueError('HN response exceeds size limit')
    return json.loads(payload)

def curiosity(force=False):
    path=CACHE.with_name('curiosity.json');old={}
    try:old=json.loads(path.read_text())
    except (OSError,ValueError):pass
    if not force and time.time()-old.get('fetchedAt',0)<3600:return old
    result={'fetchedAt':time.time(),'errors':[]}
    for key in ('show','ask'):
        try:
            ids=hn_json(key+'stories')[:8]
            with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
                items=list(pool.map(lambda i:hn_json('item/'+str(i)),ids))
            result[key]=[dict(title=i.get('title',''),score=i.get('score',0),comments=i.get('descendants',0),url='https://news.ycombinator.com/item?id='+str(i['id']),by=i.get('by',''),time=i.get('time',0)) for i in items if i and not i.get('dead') and not i.get('deleted')]
        except (OSError,ValueError,RuntimeError):
            result[key]=old.get(key,[]);result['errors'].append(key+' unavailable · cached stories retained')
    if result['errors']:result['fetchedAt']=old.get('fetchedAt',0)
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    tmp=path.with_suffix('.tmp-'+str(os.getpid()));tmp.write_text(json.dumps(result));tmp.chmod(0o600);tmp.replace(path)
    return result

if __name__=='__main__':print(json.dumps((curiosity if '--curiosity' in sys.argv else snapshot)('--refresh' in sys.argv)))
