#!/usr/bin/env python3
"""Explicit bounded ROS capture. Never controls a vehicle or overwrites a recording."""
import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'share/sensei'))
from job_runtime import terminate_group

INTERRUPT_GRACE_SECONDS=10
TERMINATE_GRACE_SECONDS=5


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',type=Path,required=True)
    parser.add_argument('--seconds',type=int,default=15)
    parser.add_argument('--max-mib',type=int,default=128)
    parser.add_argument('--topic',action='append',required=True)
    args=parser.parse_args(argv)
    if not 1<=args.seconds<=60 or not 1<=args.max_mib<=512:
        parser.error('Capture bounds: 1–60 seconds, 1–512 MiB')
    if len(args.topic)>32 or any(not re.fullmatch(r'/[A-Za-z0-9_/]+',topic) for topic in args.topic):
        parser.error('Select at most 32 explicit topic names')
    output=args.output.expanduser().resolve()
    receipt=output.parent/(output.name+'-capture.json')
    if output.exists() or receipt.exists():
        parser.error('Output or receipt already exists; never overwrite a recording')
    output.parent.mkdir(parents=True,exist_ok=True)
    os.umask(0o077)
    help_result=subprocess.run(['ros2','bag','record','--help'],capture_output=True,text=True,timeout=5)
    if help_result.returncode:
        parser.error('ROS bag recorder unavailable in this environment')
    selection=['--topics'] if '--topics' in help_result.stdout else []
    command=['ros2','bag','record','-s','mcap','-o',str(output),*selection,*args.topic]
    child=None
    reason='duration'
    stop_requested=False
    forced_stop=False
    cleanup_error=None
    started=time.time()
    deadline=time.monotonic()+args.seconds

    def request_stop(signum,_frame):
        nonlocal reason,stop_requested
        reason='cancelled' if signum==signal.SIGTERM else 'user-stop'
        stop_requested=True

    previous={number:signal.signal(number,request_stop) for number in (signal.SIGINT,signal.SIGTERM)}
    try:
        child=subprocess.Popen(command,start_new_session=True)
        while not stop_requested and time.monotonic()<deadline:
            # Keep the leader unreaped until its owned process group is stopped.
            if os.waitid(os.P_PID,child.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT) is not None:
                reason='recorder-exit'
                break
            if output.exists() and sum(path.stat().st_size for path in output.rglob('*') if path.is_file())>=args.max_mib*1048576:
                reason='size-limit'
                break
            time.sleep(.25)
    finally:
        try:
            if child is not None:
                try:
                    os.killpg(child.pid,signal.SIGINT)
                except ProcessLookupError:
                    pass
                flush_deadline=time.monotonic()+INTERRUPT_GRACE_SECONDS
                while os.waitid(os.P_PID,child.pid,os.WEXITED|os.WNOHANG|os.WNOWAIT) is None:
                    if time.monotonic()>=flush_deadline:
                        forced_stop=True
                        break
                    time.sleep(.02)
                try:
                    terminate_group(child,grace=TERMINATE_GRACE_SECONDS)
                except subprocess.TimeoutExpired:
                    cleanup_error='Recorder did not exit after SIGKILL; kernel cleanup is still pending'
                record={
                    'version':1,'topics':args.topic,'started':started,'finished':time.time(),
                    'reason':reason,'exitCode':child.returncode,'forcedStop':forced_stop,
                    'partial':forced_stop or stop_requested or cleanup_error is not None,
                    'sizeLimitMiB':args.max_mib,'durationLimitSeconds':args.seconds,
                    'note':'Size target is checked every 250 ms; fast sources can exceed it between samples.',
                }
                if cleanup_error:record['error']=cleanup_error
                with receipt.open('x') as stream:
                    json.dump(record,stream,indent=2)
                    stream.write('\n')
                print(json.dumps(record),flush=True)
        finally:
            for number,handler in previous.items():signal.signal(number,handler)
    if reason=='cancelled':return 143
    return 0 if child and not forced_stop and not cleanup_error and child.returncode in (0,130,-signal.SIGINT) else 1


if __name__=='__main__':
    raise SystemExit(main())
