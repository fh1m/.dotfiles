#!/usr/bin/python3
"""Cached Open-Meteo weather for the Sensei desktop. No location tracking."""
import datetime,json,os,sys,time,urllib.request,urllib.parse
from zoneinfo import ZoneInfo
from pathlib import Path
CACHE=Path.home()/'.cache/sensei-weather';CACHE.mkdir(parents=True,exist_ok=True)
CONFIG=Path.home()/'.config/sensei-weather.json'
DEFAULT={'name':'Dhaka','latitude':23.8103,'longitude':90.4125,'timezone':'Asia/Dhaka'}
HOURLY='temperature_2m,relative_humidity_2m,apparent_temperature,precipitation_probability,precipitation,weather_code,pressure_msl,cloud_cover,visibility,wind_speed_10m,wind_direction_10m,wind_gusts_10m,uv_index'
DAILY='weather_code,temperature_2m_max,temperature_2m_min,apparent_temperature_max,apparent_temperature_min,sunrise,sunset,daylight_duration,uv_index_max,precipitation_sum,precipitation_probability_max,wind_speed_10m_max,wind_gusts_10m_max'
def load(path,default=None):
 try:return json.loads(path.read_text())
 except (OSError,ValueError):return default

def save(path,data):
 temp=path.with_suffix('.tmp');temp.write_text(json.dumps(data));temp.replace(path)

def fetch(host,path,params):
 url='https://'+host+path+'?'+urllib.parse.urlencode(params)
 req=urllib.request.Request(url,headers={'User-Agent':'SenseiDesktop/1.0 (personal weather widget)'})
 with urllib.request.urlopen(req,timeout=18) as r:return json.load(r)

def main():
 args=sys.argv[1:];command=args[0] if args else 'current';city=load(CONFIG,DEFAULT)
 if command=='city':
  text=' '.join(args[1:]).strip()
  if not text:raise ValueError('Enter a city name')
  matches=fetch('geocoding-api.open-meteo.com','/v1/search',{'name':text,'count':1,'language':'en','format':'json'}).get('results',[])
  if not matches:raise ValueError('City not found')
  m=matches[0];city={k:m[k] for k in ('name','latitude','longitude','timezone')};city['country']=m.get('country','');save(CONFIG,city);command='force'
 date=args[1] if command=='history' and len(args)>1 else ''
 key=str(city['latitude'])+'-'+str(city['longitude'])
 path=CACHE/(key+('-history-'+date if date else '-weather')+'.json')
 cached=load(path);ttl=86400 if date else 900
 if cached and command!='force' and time.time()-cached.get('fetched',0)<ttl:
  print(json.dumps(cached));return
 params={'latitude':city['latitude'],'longitude':city['longitude'],'timezone':city['timezone'],'wind_speed_unit':'kmh'}
 result={'city':city,'fetched':time.time(),'stale':False,'error':''}
 try:
  if date:
   day=datetime.date.fromisoformat(date);today=datetime.datetime.now(ZoneInfo(city["timezone"])).date()
   if day>today:raise ValueError('Choose a past date')
   recent=(today-day).days<=92
   result['history']=fetch('api.open-meteo.com' if recent else 'archive-api.open-meteo.com','/v1/forecast' if recent else '/v1/archive',dict(params,start_date=date,end_date=date,hourly=HOURLY if recent else HOURLY.replace('precipitation_probability,','').replace(',uv_index',''),daily=DAILY if recent else DAILY.replace(',precipitation_probability_max','').replace(',uv_index_max','')))
   result['historyLabel']='Archived forecast' if recent else 'Historical model / reanalysis';result['date']=date
  else:
   current_fields='temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,rain,weather_code,cloud_cover,pressure_msl,wind_speed_10m,wind_direction_10m,wind_gusts_10m'
   full=not cached or command=='force' or time.time()-cached.get('forecastFetched',cached.get('fetched',0))>=3600
   if full:
    result['weather']=fetch('api.open-meteo.com','/v1/forecast',dict(params,current=current_fields,hourly=HOURLY,daily=DAILY,forecast_days=16,past_days=30))
    result['forecastFetched']=time.time()
    try:result['air']=fetch('air-quality-api.open-meteo.com','/v1/air-quality',dict(params,current='us_aqi,pm2_5,pm10',hourly='us_aqi,pm2_5,pm10',forecast_days=5))
    except Exception as e:
     result['airError']=str(e)
     if cached and cached.get('air'):result['air']=cached['air']
   else:
    fresh=fetch('api.open-meteo.com','/v1/forecast',dict(params,current=current_fields,forecast_days=0))
    result['weather']=dict(cached['weather']);result['weather']['current']=fresh['current']
    result['forecastFetched']=cached.get('forecastFetched',cached['fetched'])
    if cached.get('air'):result['air']=cached['air']
  save(path,result);print(json.dumps(result))
 except Exception as e:
  if cached:cached.update(stale=True,error=str(e));print(json.dumps(cached))
  else:print(json.dumps(dict(result,error=str(e))));sys.exit(1)
if __name__=='__main__':
 try:main()
 except Exception as e:print(json.dumps({'error':str(e)}));sys.exit(1)
