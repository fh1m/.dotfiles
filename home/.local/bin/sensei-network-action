#!/usr/bin/python3
import subprocess,sys,re
op=sys.argv[1];value=sys.argv[2] if len(sys.argv)>2 else ''
if op=='ssh':
 if not re.fullmatch(r'[A-Za-z0-9_.@:-]+',value) or value.startswith('-'):raise SystemExit('Enter user@host or an SSH host alias')
 args=['ssh',value]
elif op=='ping':
 if not re.fullmatch(r'[A-Za-z0-9_.:-]+',value) or value.startswith('-'):raise SystemExit('Enter a hostname or IP address')
 args=['ping','-c','5',value]
elif op=='ssh-on':args=['sudo','systemctl','start','sshd']
elif op=='ssh-off':args=['sudo','systemctl','stop','sshd']
elif op=='ssh-config':args=['nano',str(__import__('pathlib').Path.home()/'.ssh/config')]
# The host firewall is the nftables table inet sensei_fw (system/etc/nftables.conf).
# ufw is installed but not the firewall in use; its rules would sit beside ours.
elif op=='firewall':args=['sudo','nft','list','table','inet','sensei_fw']
elif op=='connections':args=['nmtui']
elif op=='ssh-edit':args=['sudo','nano','/etc/ssh/sshd_config']
elif op=='vpn':args=['nmcli','connection','edit']
elif op=='ssh-check':args=['sudo','sshd','-t']
elif op=='ssh-reload':
 if subprocess.run(['sudo','sshd','-t']).returncode:raise SystemExit('SSH configuration failed validation; server was not reloaded')
 args=['sudo','systemctl','reload','sshd']
else:raise SystemExit('Unknown network action')
subprocess.run(args);input('\nPress Enter to close…')
