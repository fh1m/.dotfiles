#!/usr/bin/env python3
"""Bounded, local-only desk context. No keys, clipboard, document contents or network access. Explicit Noesis/project selection only."""
import json, os, shutil, subprocess, time
from pathlib import Path

def sample(home=Path.home()):
    playing=False
    try:
        try:backend=json.loads((home/'.config/sensei-den/music.json').read_text()).get('backend','native')
        except (OSError,ValueError):backend='native'
        player={'headless':'go-librespot','native':'spotify_player','official':'spotify'}.get(backend,'spotify')
        p=subprocess.run(['playerctl','--player='+player,'status'],capture_output=True,text=True,timeout=1)
        playing=p.returncode==0 and p.stdout.strip()=='Playing'
    except (OSError,subprocess.SubprocessError):pass
    mem={}
    for line in Path('/proc/meminfo').read_text().splitlines():
        k,v=line.split(':',1);mem[k]=int(v.split()[0])
    used=100*(1-mem['MemAvailable']/mem['MemTotal'])
    disk=shutil.disk_usage(home);free=disk.free/2**30
    uptime=float(Path('/proc/uptime').read_text().split()[0])/3600
    temps=[]
    for p in Path('/sys/class/thermal').glob('thermal_zone*/temp'):
        try:
            v=int(p.read_text())/1000
            if 0<v<130:temps.append(v)
        except (OSError,ValueError):pass
    temperature=max(temps,default=None)
    summary=f'Memory {used:.0f}% in use · home volume {free:.0f} GiB free · uptime {uptime:.1f} h.'
    warning=''
    if free<5:warning=f'Home volume has {free:.1f} GiB free. Worth checking before a large recording.'
    elif used>94:warning=f'Memory use is {used:.0f}%. A large job may need some breathing room.'
    elif temperature and temperature>90:warning=f'A thermal sensor reports {temperature:.0f} °C. Check cooling and the current workload.'
    # Warnings repeat at most once per 30 minutes, not on every telemetry sample.
    state=home/'.local/state/sensei-den/zondo-warning.json'
    now=time.time()
    try:last=json.loads(state.read_text())
    except (OSError,ValueError):last={}
    if warning:
        if last.get('kind')==warning.split(' ',1)[0] and now-last.get('at',0)<1800:warning=''
        else:
            state.parent.mkdir(parents=True,exist_ok=True)
            tmp=state.with_suffix('.tmp');tmp.write_text(json.dumps({'kind':warning.split(' ',1)[0],'text':warning,'at':now}));tmp.chmod(0o600);tmp.replace(state)
    suggestions=[]
    try:
        projection=json.loads((home/'.local/state/sensei-learning/companion.json').read_text())
        ctx=projection.get('context',{})
        if 0<=now-projection.get('updated_at',0)<900 and ctx.get('title'):
            title=str(ctx['title'])[:75]
            suggestions.extend(["Working on “"+title+"”? We could sketch the mechanism before writing another paragraph.","For “"+title+"”, what would a tiny counterexample look like? I can keep the drawing tools nearby."])
    except (OSError,ValueError,TypeError):pass
    try:
        pen=json.loads((home/'.local/state/sensei-drawing/mapped.json').read_text())
        if now-pen.get('at',0)<600:suggestions.append("Your pen is mapped to "+pen['output']+". Super+Ctrl+N is our scratch paper; the rear of the pen is the eraser.")
    except (OSError,ValueError,KeyError):pass
    try:
        selected=json.loads((home/'.config/sensei-engineering/instrument.json').read_text()).get('project')
        if selected:
            projects=json.loads((home/'.config/sensei-engineering/projects.json').read_text()).get('projects',[])
            title=next((p.get('title',p['id']) for p in projects if p['id']==selected),'')
            if title:suggestions.append("“"+title[:70]+"” is our selected project. Small baseline, inspect the evidence, then the magnificent machine.")
    except (OSError,ValueError,KeyError):pass
    result=dict(suggestions=suggestions,playing=playing,summary=summary,warning=warning,memoryPercent=round(used),freeGiB=round(free,1),temperature=temperature,at=now)
    state=home/'.local/state/sensei-den/zondo-context.json'
    state.parent.mkdir(parents=True,exist_ok=True)
    tmp=state.with_suffix('.tmp');tmp.write_text(json.dumps(result));tmp.chmod(0o600);tmp.replace(state)
    return result

if __name__=='__main__':
    try:print(json.dumps(sample()))
    except (OSError,ValueError,KeyError):print(json.dumps({'playing':False,'summary':'','warning':''}))
