+#[derive(Default)]
+struct CtrlTaps { down: Option<Instant>, last: Option<Instant>, count:u8, dirty:bool }
+impl CtrlTaps {
+    fn key(&mut self,key:u32,state:u8,now:Instant)->u8 {
+        if key!=29 && key!=97 { if state==1 { self.dirty=true; self.count=0; } return 0; }
+        if state==1 {
+            if self.down.is_some() { self.dirty=true; }
+            else { self.down=Some(now); self.dirty=false; }
+            return 0;
+        }
+        if state!=0 { return 0; }
+        let valid=self.down.take().is_some_and(|start| now.duration_since(start)<Duration::from_millis(260)) && !self.dirty;
+        if !valid { self.count=0; return 0; }
+        if self.last.is_none_or(|last| now.duration_since(last)>Duration::from_millis(360)) { self.count=0; }
+        self.last=Some(now); self.count+=1;
+        let result=self.count;
+        if result==3 { self.count=0; }
+        result
+    }
+}
