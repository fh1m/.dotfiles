#!/usr/bin/env python3
"""Explicit local microphone checks and transcription; never background recording."""
import argparse,array,hashlib,json,math,os,signal,subprocess,sys,tempfile,selectors,time
from pathlib import Path
MODEL_SHA='60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe'

def call(*args):return subprocess.check_output(['pactl',*args],text=True,timeout=5)
def nodes():return [n for n in json.loads(call('-f','json','list','sources')) if not n['name'].endswith('.monitor')]
def doctor():
 default=call('get-default-source').strip();sources=nodes();streams=json.loads(call('-f','json','list','source-outputs'))
 return {'default':default,'sources':[{'name':n['name'],'label':n['description'],'index':n['index'],'muted':n['mute'],'state':n['state'],'gainPercent':round(sum(float(v['value_percent'].rstrip('%')) for v in n['volume'].values())/max(1,len(n['volume'])))} for n in sources], 'streams':[{'index':s['index'],'app':s.get('properties',{}).get('application.name','Unknown app'),'sourceIndex':s['source'],'muted':s.get('mute',False)} for s in streams]}
def source():
 data=doctor();row=next((s for s in data['sources'] if s['name']==data['default']),None)
 if not row:raise ValueError('No usable default microphone')
 if row['muted']:raise ValueError('Default microphone is muted; unmute intentionally before testing')
 return row

def metrics(raw,rate=48000):
 samples=array.array('f');samples.frombytes(raw[:len(raw)//4*4]);values=[float(v) for v in samples if math.isfinite(v)]
 if not values:raise ValueError('The microphone delivered no samples')
 peak=max(abs(v) for v in values);rms=math.sqrt(sum(v*v for v in values)/len(values));mean=sum(values)/len(values);ac=math.sqrt(sum((v-mean)**2 for v in values)/len(values));acpeak=max(abs(v-mean) for v in values)
 return {'seconds':round(len(values)/rate,2),'peakDbFS':round(20*math.log10(max(peak,1e-9)),1),'rmsDbFS':round(20*math.log10(max(rms,1e-9)),1),'clippedPercent':round(100*sum(abs(v)>=.999 for v in values)/len(values),3),'dcOffset':round(mean,6),'dcOffsetWarning':abs(mean)>.01,'acRmsDbFS':round(20*math.log10(max(ac,1e-9)),1),'signalDetected':acpeak>.002}

def probe(seconds):
 row=source()
 r=subprocess.run(['timeout','--kill-after=2','--signal=INT',str(seconds+2),'parec','--device='+row['name'],'--format=float32le','--rate=48000','--channels=1'],capture_output=True,timeout=seconds+6)
 if r.returncode not in (0,124,130):raise ValueError('Microphone capture failed; inspect PipeWire routing')
 return dict(metrics(r.stdout),source=row['label'],note='Signal is not proof of intelligible speech. No recording was saved.')

def meter(seconds):
 row=source();recorder=subprocess.Popen(['parec','--device='+row['name'],'--format=float32le','--rate=48000','--channels=1'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
 selector=selectors.DefaultSelector();selector.register(recorder.stdout,selectors.EVENT_READ);end=time.monotonic()+seconds;last=time.monotonic();buffer=b''
 try:
  while time.monotonic()<end:
   if not selector.select(.2):continue
   data=os.read(recorder.stdout.fileno(),16384)
   if not data:break
   buffer=(buffer+data)[-96000:]
   if time.monotonic()-last>=.25:
    print(json.dumps(dict(metrics(buffer),type='meter',source=row['label'])),flush=True);buffer=b'';last=time.monotonic()
 finally:
  selector.close();recorder.stdout.close();recorder.terminate()
  try:recorder.wait(timeout=2)
  except subprocess.TimeoutExpired:recorder.kill();recorder.wait()
 return {'note':'Meter stopped. No audio saved.'}

def transcribe(seconds,file=None,language='auto'):
 model=Path.home()/'.local/share/sensei-voice/models/ggml-base.bin'
 if not model.is_file():raise ValueError('Local model missing. Run scripts/setup-den-voice.py --apply first.')
 with model.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()
 if digest!=MODEL_SHA:raise ValueError('Local speech model checksum mismatch')
 with tempfile.TemporaryDirectory(prefix='sensei-voice-') as work:
  wav=Path(work)/'capture.wav';recorder=None
  try:
   if file:
    file=Path(file).expanduser().resolve(strict=True)
    if not file.is_file():raise ValueError('Choose an existing local audio file')
    argv=['ffmpeg','-nostdin','-v','error','-i',str(file),'-t','30','-ar','16000','-ac','1',str(wav)]
    result=subprocess.run(argv,capture_output=True,timeout=40)
   else:
    row=source()
    recorder=subprocess.Popen(['parec','--device='+row['name'],'--format=s16le','--rate=16000','--channels=1'],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
    result=subprocess.run(['ffmpeg','-v','error','-f','s16le','-ar','16000','-ac','1','-i','pipe:0','-t',str(seconds),str(wav)],stdin=recorder.stdout,capture_output=True,timeout=seconds+10)
   if result.returncode:raise ValueError('Local audio conversion failed')
  finally:
   if recorder:
    recorder.stdout.close();recorder.terminate()
    try:recorder.wait(timeout=2)
    except subprocess.TimeoutExpired:recorder.kill();recorder.wait()
  target=Path(work)/'transcript'
  subprocess.run([str(Path.home()/'.local/bin/whisper-cli'),'-m',str(model),'-f',str(wav),'-l',language,'-t','2','-nt','-of',str(target),'-otxt'],capture_output=True,check=True,timeout=90)
  text=target.with_suffix('.txt').read_text().strip()
  return {'transcript':text,'note':'Local model output; review before copying. Temporary audio was deleted. Nothing was typed into an application.'}

def route_default():
 data=doctor();row=next((s for s in data['sources'] if s['name']==data['default']),None)
 if not row:raise ValueError('No default microphone')
 physical={s['index'] for s in data['sources']};routed=0
 for stream in data['streams']:
  if stream['sourceIndex'] not in physical:continue
  call('move-source-output',str(stream['index']),row['name']);routed+=1
 return {'routed':routed,'source':row['label'],'note':'Mute states preserved; future apps use the system default unless they override it.'}

def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['doctor','probe','route-default','transcribe','meter']);p.add_argument('--seconds',type=int,default=3,choices=range(1,31));p.add_argument('--file',type=Path);p.add_argument('--language',choices=['auto','en','bn'],default='auto');a=p.parse_args()
 if a.action=='doctor':return doctor()
 if a.action=='probe':return probe(min(a.seconds,8))
 if a.action=='meter':return meter(a.seconds)
 if a.action=='transcribe':return transcribe(a.seconds,a.file,a.language)
 return route_default()
if __name__=='__main__':
 def cancel(*_):raise KeyboardInterrupt
 signal.signal(signal.SIGTERM,cancel)
 try:print(json.dumps(main(),allow_nan=False))
 except KeyboardInterrupt:print(json.dumps({'error':'Cancelled; temporary audio removed.'}));sys.exit(130)
 except (ValueError,OSError,KeyError,subprocess.SubprocessError) as error:print(json.dumps({'error':str(error)}));sys.exit(1)
