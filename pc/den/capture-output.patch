 fn get_output_configuration(state: &State, pos: Position) -> Vec<Output> {
+    // Den: per-edge physical output selection, independent of compositor geometry.
+    if let Ok(mapping) = env::var("DEN_CAPTURE_OUTPUTS") {
+        let name = mapping.split(',').filter_map(|entry| entry.split_once('='))
+            .find(|(edge, _)| *edge == pos.to_string()).map(|(_, name)| name);
+        return state.outputs.iter().filter(|output| {
+            output.info.as_ref().is_some_and(|info| Some(info.name.as_str()) == name)
+        }).cloned().collect();
+    }
     // get all output edges corresponding to the position
     let edges = get_edges(&state.outputs, pos);
     let opposite_edges = get_edges(&state.outputs, pos.opposite());
