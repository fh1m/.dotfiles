[Unit]
Description=Digital Den input sharing
After=graphical-session.target network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/state/homie-control/den-session.py input
Restart=always
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
UMask=0077
[Install]
WantedBy=default.target
