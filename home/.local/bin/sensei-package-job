#!/usr/bin/env python3
"""Private, persistent package transactions with an in-shell output/input bridge."""
import argparse
import fcntl
import json
import os
import pty
import re
import selectors
import shutil
import signal
import subprocess
import sys
import time
import termios
import uuid
from pathlib import Path

STATE=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))/'sensei-packages'
SCRIPT=Path(__file__).resolve()
NAMES={'selected','install','remove','info'}

def directory():
    STATE.mkdir(parents=True,exist_ok=True,mode=0o700);STATE.chmod(0o700)

def read_state():
    try:return json.loads((STATE/'job.json').read_text())
    except (OSError,ValueError):return {'status':'idle','log':'','phase':'Ready'}

def save(data):
    directory();temp=STATE/('state-'+str(os.getpid())+'.tmp')
    with os.fdopen(os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600),'w') as file:json.dump(data,file)
    temp.replace(STATE/'job.json')

def command(action,name=''):
    if action in NAMES and not re.fullmatch(r'[A-Za-z0-9@+_.:][A-Za-z0-9@+_.:-]*',name):raise ValueError('Choose one valid package name')
    paru=['paru','--color','never','--sudo','sudo','--sudoflags','-A','--review','--noupgrademenu']
    if action=='selected':
        native=subprocess.run(['pacman','-Qn',name],capture_output=True).returncode==0
        return paru+(['-Syu','--repo',name] if native else ['-S',name])
    actions={'all':paru+['-Syu'], 'repo':paru+['-Syu','--repo'], 'aur':paru+['-Sua'],
             'install':paru+['-Syu',name], 'remove':paru+['-Rns',name],
             'info':['paru','-Si',name], 'orphans':['pacman','-Qtd'],
             'clean':paru+['-Sc'], 'log':['tail','-n','160','/var/log/pacman.log'],
             'flatpak':['flatpak','update'], 'firmware':['fwupdmgr','update']}
    if action=='orphan-clean':
        names=subprocess.run(['pacman','-Qtdq'],capture_output=True,text=True).stdout.split()
        if not names:return ['true']
        return paru+['-Rns',*names]
    if action not in actions:raise ValueError('Unknown operation')
    return actions[action]

def phase(text,previous):
    lowered=text.lower()
    if any(x in lowered for x in ['[y/n]','[y/n','[n/y]','[yes/no]','proceed with','enter a selection','password','review?','packages to exclude','which provider',':: import pgp']):return 'Your confirmation is needed'
    if 'upgrading ' in lowered or 'installing ' in lowered or 'transaction hooks' in lowered:return 'Installing'
    if 'building' in lowered or 'making package' in lowered:return 'Building AUR packages'
    if 'downloading' in lowered or 'retrieving packages' in lowered:return 'Downloading'
    if 'synchronizing' in lowered:return 'Checking repositories'
    return previous

def run(action,name):
    directory()
    lock=open(STATE/'lock','a')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:raise ValueError('An update is already running')
    args=command(action,name)
    fifo=STATE/'input'
    if fifo.exists():fifo.unlink()
    os.mkfifo(fifo,0o600)
    control=os.open(fifo,os.O_RDWR|os.O_NONBLOCK)
    master,slave=pty.openpty()
    tty=termios.tcgetattr(slave);tty[3]&=~termios.ECHO;termios.tcsetattr(slave,termios.TCSANOW,tty)
    env=dict(os.environ,TERM='dumb',NO_COLOR='1',PAGER='cat',BAT_PAGER='cat',PARU_PAGER='cat',
             SUDO_ASKPASS=str(Path.home()/'.local/bin/sensei-package-askpass'))
    data={'id':str(uuid.uuid4()),'pid':os.getpid(),'action':action,'status':'running','phase':'Starting','startedAt':time.time(),'log':'','exitCode':None}
    save(data)
    try:child=subprocess.Popen(args,stdin=slave,stdout=slave,stderr=slave,env=env,start_new_session=True)
    except OSError:
        data.update(status='attention',phase='Required package tool is unavailable');save(data)
        os.close(slave);os.close(master);os.close(control);fifo.unlink(missing_ok=True);lock.close();raise
    os.close(slave)
    selector=selectors.DefaultSelector();selector.register(master,selectors.EVENT_READ);selector.register(control,selectors.EVENT_READ)
    input_buffer=b'';prompt_buffer='';last_write=0;last_prompt_notice=0
    def cancel(*_):
        # SIGINT is delegated to the package manager. Never SIGKILL a transaction.
        try:os.killpg(child.pid,signal.SIGINT)
        except ProcessLookupError:pass
        data['phase']='Cancellation requested; waiting for package manager'
    signal.signal(signal.SIGTERM,cancel);signal.signal(signal.SIGINT,cancel)
    try:
        while True:
            for key,_ in selector.select(.2):
                if key.fd==master:
                    try:chunk=os.read(master,65536)
                    except OSError:chunk=b''
                    if chunk:
                        text=re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]','',chunk.decode(errors='replace')).replace('\r','\n')
                        data['log']=(data['log']+text)[-40000:]
                        prompt_buffer=(prompt_buffer+text)[-2000:]
                        data['phase']=phase(prompt_buffer,data['phase'])
                        if data['phase']=='Your confirmation is needed':data['prompt']='\n'.join(data['log'].strip().splitlines()[-5:])
                        if data['phase']=='Your confirmation is needed' and time.monotonic()-last_prompt_notice>10 and shutil.which('notify-send'):
                            subprocess.run(['notify-send','--app-name=System updates','Update needs confirmation','Open System → Packages to review and continue.'],timeout=5)
                            last_prompt_notice=time.monotonic()
                    elif child.poll() is not None:selector.unregister(master)
                else:
                    input_buffer+=os.read(control,8192)
                    while b'\n' in input_buffer:
                        line,_,input_buffer=input_buffer.partition(b'\n')
                        try:request=json.loads(line)
                        except ValueError:continue
                        if request.get('id')!=data['id']:continue
                        if request.get('cancel'):cancel();continue
                        answer=request.get('answer','')
                        if isinstance(answer,str) and len(answer)<=2048:
                            os.write(master,(answer+'\n').encode())
                            data['phase']='Continuing';data['prompt']='';prompt_buffer=''
            if time.monotonic()-last_write>.4:
                save(data);last_write=time.monotonic()
            if child.poll() is not None and master not in selector.get_map():break
        code=child.wait();data.update(exitCode=code,status='done' if code==0 else 'attention',phase='Completed' if code==0 else 'Needs attention',finishedAt=time.time());save(data)
        history=STATE/'history';history.mkdir(exist_ok=True,mode=0o700)
        archive=history/(data['id']+'.json')
        with os.fdopen(os.open(archive,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600),'w') as file:json.dump(data,file)
        if shutil.which('notify-send'):
            subprocess.run(['notify-send','--app-name=System updates','System updates',data['phase']+' · '+action],timeout=5)
    finally:
        selector.close();os.close(master);os.close(control);fifo.unlink(missing_ok=True)
        lock.close()

def send(job,answer=None,cancel=False):
    state=read_state()
    if state.get('status')!='running' or state.get('id')!=job:raise ValueError('This transaction is no longer active')
    if answer is not None and (len(answer)>2048 or '\n' in answer or '\r' in answer):raise ValueError('Enter one short response')
    fd=os.open(STATE/'input',os.O_WRONLY|os.O_NONBLOCK)
    try:os.write(fd,(json.dumps({'id':job,'answer':answer or '', 'cancel':cancel})+'\n').encode())
    finally:os.close(fd)

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('operation',choices=['start','run','state','respond','cancel']);parser.add_argument('value',nargs='?',default='');parser.add_argument('extra',nargs='?',default='');args=parser.parse_args()
    if args.operation=='state':
        data=read_state()
        if data.get('status')=='running':
            try:os.kill(data['pid'],0)
            except (OSError,KeyError):data.update(status='attention',phase='Job interrupted · inspect transaction log')
        print(json.dumps(data));return
    if args.operation=='run':run(args.value,args.extra);return
    if args.operation in ['respond','cancel']:send(args.value,args.extra,args.operation=='cancel');return
    command(args.value,args.extra) # Validate before launching; no shell interpolation.
    session=[f'--setenv={key}={os.environ[key]}' for key in ['DISPLAY','WAYLAND_DISPLAY','XDG_CURRENT_DESKTOP','XDG_SESSION_TYPE'] if key in os.environ]
    result=subprocess.run(['systemd-run','--user','--quiet','--collect','--unit=sensei-package-job',*session,str(SCRIPT),'run',args.value,args.extra],capture_output=True,text=True)
    print(json.dumps({'started':result.returncode==0,'error':'' if result.returncode==0 else 'Could not start; another transaction may be running.'}))

if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        print(json.dumps({'error':str(error)}));sys.exit(1)
