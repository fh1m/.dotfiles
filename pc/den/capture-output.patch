+        let mut taps=CtrlTaps::default(); let start=Instant::now();
+        for n in 0..3 {
+            assert_eq!(taps.key(29,1,start+Duration::from_millis(n*120)),0);
+            assert_eq!(taps.key(29,0,start+Duration::from_millis(n*120+40)),(n+1) as u8);
+        }
+        taps.key(29,1,start+Duration::from_secs(1));
+        taps.key(46,1,start+Duration::from_millis(1010));
+        assert_eq!(taps.key(29,0,start+Duration::from_millis(1040)),0);
+        taps.key(29,1,start+Duration::from_secs(2));
+        assert_eq!(taps.key(29,0,start+Duration::from_millis(2500)),0);
+    }
+}
