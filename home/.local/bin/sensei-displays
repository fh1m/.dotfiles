#!/usr/bin/env python3
"""Event-driven external-display layout, DDC brightness and a shared workspace pool."""
import argparse
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
sys.path.insert(0,str(Path.home()/".local/share/sensei"))
try:
    from den_layout import role_for, roles as display_roles
except ImportError:
    role_for = None

STATE = Path(os.environ.get('XDG_CACHE_HOME', Path.home()/'.cache'))/'sensei-displays'
DRM = Path('/sys/class/drm')
WORKSPACE_NAMES = ('Terminal','Web','Code','Study','Sim','Work')


def run(command, timeout=15):
    if command[0]=='hyprctl' and not os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):command=[command[0],'-i','0',*command[1:]]
    return subprocess.check_output(command, text=True, stderr=subprocess.PIPE, timeout=timeout)


def monitors():
    rows=json.loads(run(['hyprctl','monitors','-j']));globals()['_role_monitors']=rows;return rows
def known_workspaces():return json.loads(run(['hyprctl','workspaces','-j']))
def clients():return json.loads(run(['hyprctl','clients','-j']))
def dispatch(expression):run(['hyprctl','dispatch',expression])
def external(name):
    current=globals().get('_role_monitors')
    if role_for and current is not None:
        return role_for(name,current) not in ('main','screenpad') and (name.startswith(('HDMI-','DP-','DVI-')) or name.startswith('SENSEI-'))
    desktop=globals().get('MACHINE',{}).get('profile')=='pc'
    return name != globals().get('PRIMARY','eDP-1') and (desktop or name!='DP-2') and (name.startswith(('HDMI-','DP-','DVI-')) or name.startswith('SENSEI-'))




def workspace_slots(outputs=None):
    # Stable connector slots survive unplug/replug and never share workspace IDs.
    result={'HDMI-A-1':1,'DP-1':2}
    path=STATE/'workspace-slots.json'
    if path.exists():
        saved=json.loads(path.read_text())
        if not isinstance(saved,dict) or any(not re.fullmatch(r'(?:HDMI-|DP-|DVI-|SENSEI-)[A-Za-z0-9_-]+',k) or not isinstance(v,int) or not 1<=v<=32 for k,v in saved.items()) or len(set(saved.values()))!=len(saved):
            raise ValueError('Invalid display workspace registry; existing windows preserved')
        result=saved
    changed=False
    for monitor in outputs or []:
        name=monitor['name']
        if not external(name) or name in result:continue
        preferred=1 if name=='SENSEI-HDMI-TEST' else 2 if name=='SENSEI-UPPER-TEST' else None
        active={m['name'] for m in outputs}
        used={v for k,v in result.items() if k in active} if preferred else set(result.values())
        slot=preferred if preferred and preferred not in used else next((n for n in range(1,33) if n not in set(result.values())),None)
        if slot is None:raise ValueError('No free display workspace slot')
        # Headless acceptance outputs are temporary aliases, never persisted.
        result[name]=slot
        if not name.startswith('SENSEI-'):changed=True
    if changed:
        STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
        saved={k:v for k,v in result.items() if not k.startswith('SENSEI-')}
        temp=path.with_suffix('.tmp');temp.write_text(json.dumps(saved));temp.chmod(0o600);temp.replace(path)
    return result


def bar_edge(output):
    if role_for and role_for(output,globals().get('_role_monitors') or [])=='upper':return 'top'
    return 'top' if output=='SENSEI-UPPER-TEST' or workspace_slots().get(output,1)>1 else 'bottom'

def selector(name):
    if not re.fullmatch(r'[A-Za-z0-9_-]+',name):raise ValueError('Invalid output name')
    return json.dumps(name)


def connected():
    result={}
    for node in DRM.glob('card*-*'):
        try:
            if (node/'status').read_text().strip()!='connected':continue
            name=re.sub(r'^card\d+-','',node.name)
            if not external(name):continue
            edid=(node/'edid').read_bytes()
            result[name]={'id':hashlib.sha256(edid).hexdigest(),'label':name}
            for start in (54,72,90,108):
                block=edid[start:start+18]
                if block[:5]==b'\x00\x00\x00\xfc\x00':result[name]['label']=block[5:18].decode(errors='replace').strip()
        except OSError:continue
    return result


def ddc_devices(text):
    devices={};record={}
    for line in text.splitlines()+['Display END']:
        if re.match(r'^(?:Display |Invalid display)',line):
            if record.get('valid') and 'output' in record and 'bus' in record:devices[record['output']]=record['bus']
            record={'valid':line.startswith('Display ')}
        bus=re.search(r'I2C bus:\s+/dev/i2c-(\d+)',line)
        output=re.search(r'DRM connector:\s+card\d+-((?:HDMI|DP|DVI)-[A-Za-z0-9_-]+)',line)
        if bus:record['bus']=int(bus[1])
        if output and external(output[1]):record['output']=output[1]
    return devices


def brightness(bus):
    text=run(['ddcutil','--bus',str(bus),'getvcp','10','--terse'],timeout=12)
    match=re.search(r'^VCP 10 C (\d+) (\d+)',text,re.M)
    if not match or int(match[2])<=0:raise ValueError('Monitor does not expose brightness through DDC')
    raw,maximum=map(int,match.groups())
    return {'raw':raw,'maximum':maximum,'level':round(100*raw/maximum)}


def read_state():
    try:return json.loads((STATE/'state.json').read_text())
    except (OSError,ValueError):return {}


def write_state(data):
    STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
    temp=STATE/('state.tmp-'+str(os.getpid()));temp.write_text(json.dumps(data));temp.chmod(0o600);temp.replace(STATE/'state.json')


def optimal_mode(monitor):
    modes=[]
    for text in monitor.get('availableModes',[]):
        match=re.fullmatch(r'(\d+)x(\d+)@(\d+(?:\.\d+)?)Hz',text)
        if match:
            width,height=int(match[1]),int(match[2]);rate=float(match[3])
            modes.append((width*height,rate,width,height))
    if not modes:return ('preferred',monitor['width'],monitor['height'],monitor.get('refreshRate',60))
    _,rate,width,height=max(modes)
    return (f'{width}x{height}@{rate:g}',width,height,rate)


def configure(outputs):
    selected=sorted((m for m in outputs if external(m['name'])),key=lambda m:((role_for(m['name'],outputs)!='lower') if role_for else m['name']!='HDMI-A-1',m['name']))
    lower=None
    for monitor in selected:
        mode,width,height,rate=optimal_mode(monitor)
        scale=2 if width>=3200 and height>=1800 else 1
        rotated=monitor.get('transform',0)%2
        logical_width=round((height if rotated else width)/scale)
        logical_height=round((width if rotated else height)/scale)
        if lower is None:x,y=-logical_width,0
        else:x,y=lower[0]+round((lower[2]-logical_width)/2),lower[1]-logical_height
        lower=(x,y,logical_width,logical_height)
        mode_changed=(width!=monitor['width'] or height!=monitor['height'] or abs(rate-monitor.get('refreshRate',rate))>.1)
        if mode_changed or monitor.get('scale',1)!=scale or monitor.get('x')!=x or monitor.get('y')!=y:
            run(['hyprctl','eval','hl.monitor({output='+selector(monitor['name'])+',mode='+json.dumps(mode)+',position="'+str(x)+'x'+str(y)+'",scale='+str(scale)+'})'])


def sync(layout=True,notify=True):
    previous=read_state();physical=connected();outputs=monitors()
    if layout:
        configure(outputs)
        STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
        with (STATE/'workspace.lock').open('w') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX)
            reconcile()
        outputs=monitors()
    old={d['output']:d for d in previous.get('displays',[])}
    changed=any(name not in old or old[name].get('id')!=record['id'] or old[name].get('bus') is None for name,record in physical.items())
    buses={name:d.get('bus') for name,d in old.items() if d.get('bus') is not None}
    if physical and changed:
        try:buses=ddc_devices(run(['ddcutil','detect','--brief'],timeout=20))
        except (OSError,subprocess.SubprocessError):buses={}
    data={'workspaceSlots':workspace_slots(),'displays':[],'session':os.environ.get('HYPRLAND_INSTANCE_SIGNATURE',''),'outputs':[m['name'] for m in outputs if external(m['name'])]}
    for name,record in physical.items():
        record=dict(record,output=name,bus=buses.get(name),ready=False,active=name in data['outputs'],barEdge=bar_edge(name))
        monitor=next((m for m in outputs if m['name']==name),None)
        if monitor:
            record.update(width=monitor['width'],height=monitor['height'],refresh=monitor.get('refreshRate',60),scale=monitor.get('scale',1),format=monitor.get('currentFormat','Unknown'))
        if record['bus'] is not None:
            try:record.update(brightness(record['bus']),ready=True)
            except (OSError,ValueError,subprocess.SubprocessError):record['error']='DDC brightness unavailable; use the monitor controls'
        else:record['error']='DDC brightness unavailable; use the monitor controls'
        data['displays'].append(record)
    if notify:
        before=set(previous.get('outputs',[])) if previous.get('session')==data['session'] else set()
        after=set(data['outputs'])
        for name in sorted(after-before):
            label=physical.get(name,{}).get('label',name)
            subprocess.run(['notify-send','-a','Sensei','-i','video-display','Display connected',label+(' · above HDMI display' if bar_edge(name)=='top' and 'HDMI-A-1' in after else ' · left of main display')+' · shared workspaces'],check=False)
        for name in sorted(before-after):
            subprocess.run(['notify-send','-a','Sensei','-i','video-display','Display disconnected',name+' · workspaces returned to the remaining displays'],check=False)
    write_state(data);return data


def set_brightness(output,percent):
    selector(output)
    if not math.isfinite(percent) or not 0<=percent<=100:raise ValueError('Brightness must be between 0 and 100')
    data=read_state();record=next((d for d in data.get('displays',[]) if d['output']==output),None)
    actual=connected().get(output)
    if not record or not record.get('ready') or not actual or actual['id']!=record.get('id'):
        data=sync(layout=False,notify=False);record=next((d for d in data['displays'] if d['output']==output),None)
    if not record or not record.get('ready'):raise ValueError('Monitor brightness is unavailable')
    raw=round(percent*record['maximum']/100)
    run(['ddcutil','--bus',str(record['bus']),'setvcp','10',str(raw)],timeout=12)
    record.update(brightness(record['bus']))
    write_state(data);return data


# Each output owns a physical half; all halves form the same logical desktop.
def logical(number):
    return number%100 if 100<number<3300 and number%100 in range(1,7) else number


def physical(number,output,slots=None):
    return number+100*(slots or workspace_slots()).get(output,1) if external(output) and number in range(1,7) else number


def main_display(outputs):
    return next((m for m in outputs if m['name']=='eDP-1'),next((m for m in outputs if m['name']!='DP-2' and not external(m['name'])),None))


def workspace(number,output=None):
    if number not in range(1,8):raise ValueError('Workspace must be 1–7')
    outputs=monitors()
    current=next((m for m in outputs if m.get('focused')),outputs[0] if outputs else None)
    name=output or (current['name'] if current else '')
    target=next((m for m in outputs if m['name']==name),None)
    if not target:raise ValueError('Display is not connected')
    main=main_display(outputs)
    if number==7 or name=='DP-2':
        if number==7:
            dispatch('hl.dsp.focus({workspace="7"})');return
        name=main['name'] if main else name
    joined=[m for m in outputs if external(m['name']) or (main and m['name']==main['name'])]
    if not joined:joined=[target]
    existing={w['id']:w for w in known_workspaces()}
    slots=workspace_slots(joined)
    actions=[]
    for monitor in joined:
        output_name=monitor['name'];wid=physical(number,output_name,slots)
        if monitor.get('activeWorkspace',{}).get('id')==wid and not monitor.get('specialWorkspace',{}).get('name'):continue
        if wid in existing and existing[wid].get('monitor')!=output_name:
            actions.append('hl.dsp.workspace.move({workspace="'+str(wid)+'",monitor='+selector(output_name)+'})')
        actions.append('hl.dsp.focus({monitor='+selector(output_name)+'})')
        special=monitor.get('specialWorkspace',{}).get('name','')
        if special.startswith('special:'):
            actions.append('hl.dsp.workspace.toggle_special('+json.dumps(special.removeprefix('special:'))+')')
        actions.append('hl.dsp.focus({workspace="'+str(wid)+'"})')
    actions.append('hl.dsp.focus({monitor='+selector(name)+'})')
    # One compositor transaction prevents a reconciliation process observing
    # half a pair and avoids a visible intermediate workspace swap.
    dispatch('(function() '+''.join('hl.dispatch('+a+');' for a in actions[:-1])+' return '+actions[-1]+' end)()')


def reconcile():
    outputs=monitors();main=main_display(outputs)
    if not main:return
    slots=workspace_slots(outputs)
    attached={slots[m['name']] for m in outputs if external(m['name'])}
    records=known_workspaces()
    for ws in records:
        wid=ws['id'];subject=logical(wid)
        if subject!=wid and ws.get('name') in (WORKSPACE_NAMES[subject-1],WORKSPACE_NAMES[subject-1]+' · External'):
            suffix='Lower' if wid//100==1 else 'Upper' if wid//100==2 else 'External '+str(wid//100)
            dispatch('hl.dsp.workspace.rename({workspace="'+str(wid)+'",name='+json.dumps(WORKSPACE_NAMES[subject-1]+' · '+suffix,ensure_ascii=False)+'})')
    by_id={m['id']:m for m in outputs}
    previous=set(read_state().get('outputs',[]))
    frontier=logical(main.get('activeWorkspace',{}).get('id',1))
    if frontier not in range(1,7):frontier=1
    for window in clients():
        wid=window.get('workspace',{}).get('id',0);subject=logical(wid)
        monitor=by_id.get(window.get('monitor'));destination=None
        if monitor and external(monitor['name']) and subject in range(1,7):
            expected=physical(subject,monitor['name'],slots)
            if wid!=expected:destination=expected
        elif subject!=wid and (wid//100 not in attached or (monitor and monitor['name']==main['name'])):
            destination=subject
        elif monitor and external(monitor['name']) and monitor['name'] not in previous and wid>7 and subject==wid and window.get('workspace',{}).get('name')==str(wid):
            destination=physical(frontier,monitor['name'],slots)
        if destination is not None:
            dispatch('hl.dsp.window.move({window='+json.dumps('address:'+window['address'])+',workspace="'+str(destination)+'",follow=false})')
    outputs=monitors();main=main_display(outputs)
    focused=next((m for m in outputs if m.get('focused')),main)
    origin=focused if external(focused['name']) or focused['name']==main['name'] else main
    number=logical(origin.get('activeWorkspace',{}).get('id',1))
    if number not in range(1,7):number=frontier
    joined=[m for m in outputs if external(m['name']) or m['name']==main['name']]
    if any(m['activeWorkspace']['id']!=physical(number,m['name'],slots) for m in joined):
        workspace(number,origin['name'])
        if focused['name']!=origin['name']:dispatch('hl.dsp.focus({monitor='+selector(focused['name'])+'})')


def move_window(number,address=None):
    if number not in range(1,8):raise ValueError('Workspace must be 1–7')
    window=next((w for w in clients() if w['address']==address),None) if address else json.loads(run(['hyprctl','activewindow','-j']))
    if not window or not window.get('address'):raise ValueError('No window to move')
    output=next((m['name'] for m in monitors() if m['id']==window.get('monitor')),'eDP-1')
    wid=physical(number,output)
    dispatch('hl.dsp.window.move({window='+json.dumps('address:'+window['address'])+',workspace="'+str(wid)+'",follow=false})')



def main():
    parser=argparse.ArgumentParser(description=__doc__);sub=parser.add_subparsers(dest='command',required=True)
    status=sub.add_parser('sync');status.add_argument('--no-layout',action='store_true');status.add_argument('--no-notify',action='store_true')
    control=sub.add_parser('brightness');control.add_argument('output');control.add_argument('percent',type=float)
    focus=sub.add_parser('workspace');focus.add_argument('number',type=int);focus.add_argument('output',nargs='?')
    sub.add_parser('reconcile')
    move=sub.add_parser('move');move.add_argument('number',type=int);move.add_argument('address',nargs='?')
    args=parser.parse_args()
    # Navigation never waits for a slow monitor's I2C transaction.
    if args.command in ('workspace','reconcile','move'):
        STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
        with (STATE/'workspace.lock').open('w') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX)
            if args.command=='workspace':workspace(args.number,args.output)
            elif args.command=='move':move_window(args.number,args.address)
            else:reconcile()
        return
    STATE.mkdir(parents=True,exist_ok=True,mode=0o700)
    with (STATE/'lock').open('w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if args.command=='sync':print(json.dumps(sync(not args.no_layout,not args.no_notify)))
        elif args.command=='brightness':print(json.dumps(set_brightness(args.output,args.percent)))

if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        print(json.dumps({'error':str(error)}));sys.exit(1)
