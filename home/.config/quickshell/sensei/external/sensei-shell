#!/usr/bin/env bash
#
# sensei-shell -- start the sensei shell, and never leave a locked session
# without a lockscreen.
#
# Hyprland's start-up runs this instead of `qs -c sensei` directly. It runs the
# shell in the foreground and waits. When the shell exits:
#
#   - if Hyprland says the session is still locked (`hyprctl locked`), the lock
#     client has died -- a crash, a kill, or the lockscreen handing itself to a
#     fresh process after it lost the keyboard -- so the shell is started again
#     at once. The new shell sees the lock at start-up and takes it over
#     (Hyprland allows that with misc:allow_session_lock_restore, which
#     hypr-sensei.lua sets). The session is never unlocked in between: the old
#     client never sent an unlock, so Hyprland kept the session locked;
#   - if it fails while unlocked, it is started again with the same backoff
#     (more than five starts in thirty seconds waits five seconds between them);
#     it never gives up, because giving up is the wedge;
#   - a clean, intentional stop while unlocked ends the supervisor.
#
# Nothing here can unlock anything. It only ever starts a lockscreen.
#
# SENSEI_QS_ARGS overrides how the shell is started (default `-c sensei`); the
# build's lock tests use it to point at a scratch copy with a test PAM stack.

set -u

# Display-manager sessions have a minimal PATH. Widget actions and launchers
# must resolve the same user tools that an interactive shell can see.
export PATH="$HOME/.local/bin:$PATH"
export QSG_RHI_BACKEND="${QSG_RHI_BACKEND:-opengl}"
export QML_IMPORT_PATH="$HOME/.local/lib/qt6/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"

# Native video must not import decoder-owned DMA-BUF textures into the shell's
# multi-output EGL contexts. A Mesa dri2_query_image crash was observed during
# cross-output playback. Keep hardware decoding available, upload mapped frames.
# Qt documents this diagnostic switch; leave an explicit opt-out for validation.
export QT_DISABLE_HW_TEXTURES_CONVERSION="${QT_DISABLE_HW_TEXTURES_CONVERSION:-1}"


read -r -a QS_ARGS <<< "${SENSEI_QS_ARGS:--c sensei}"

# A private rebuild tracks Qt's private ABI without replacing the distro
# package. Never launch it after a Qt version change; the fallback remains the
# packaged binary until the local build is refreshed.
qs_bin="${SENSEI_QS_BIN:-qs}"
local_qs="${HOME}/.local/opt/sensei-quickshell/bin/qs"
qt_stamp="${HOME}/.local/opt/sensei-quickshell/qt-version"
if [ -z "${SENSEI_QS_BIN:-}" ] && [ -x "$local_qs" ] && [ -r "$qt_stamp" ]; then
    current_qt="$(/usr/lib/qt6/bin/qtpaths --query QT_VERSION 2>/dev/null || true)"
    if [ -n "$current_qt" ] && [ "$(cat "$qt_stamp")" = "$current_qt" ]; then
        qs_bin="$local_qs"
    fi
fi

# QTBUG-146671 can crash a non-focusing panel on a right-click at (0,0).
# Filter only the invalid synthesized context-menu event, keeping mouse actions.
# Public Qt API plugin; rebuild after Qt updates instead of loading stale code.
qt_plugins="$HOME/.local/share/sensei-qt-plugins"
current_qt="$(/usr/lib/qt6/bin/qtpaths --query QT_VERSION 2>/dev/null || true)"
if [ -f "$qt_plugins/generic/libsensei_context_guard.so" ] && [ -r "$qt_plugins/qt-version" ] && [ "$(cat "$qt_plugins/qt-version")" = "$current_qt" ]; then
    export QT_PLUGIN_PATH="$qt_plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
    export QT_QPA_GENERIC_PLUGINS="sensei-context-guard${QT_QPA_GENERIC_PLUGINS:+,$QT_QPA_GENERIC_PLUGINS}"
fi

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
tag="$(printf '%s' "${QS_ARGS[*]}" | cksum | cut -d' ' -f1)"

# One supervisor per shell per login: a second one exits at once.
exec 9> "$runtime/sensei-shell-$tag.lock"
flock -w 3 9 || exit 0

locked() {
    [ "$(hyprctl locked 2> /dev/null)" = "true" ]
}

# A live instance answers IPC; -n below makes a duplicate exit at once, and
# this tells that apart from a death.
alive() {
    "$qs_bin" "${QS_ARGS[@]}" ipc show > /dev/null 2>&1
}

starts=()
logdir="${XDG_STATE_HOME:-$HOME/.local/state}/sensei"
mkdir -p "$logdir"
while :; do
    # Do not respawn into a new login using a dead compositor's environment.
    # Persistent tmux/user-manager processes can outlive a desktop session.
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && ! hyprctl version >/dev/null 2>&1; then
        printf 'Compositor session ended; stopping this shell supervisor.\n' >> "$logdir/shell.log"
        exit 0
    fi
    SENSEI_SUPERVISED=1 QS_NO_RELOAD_POPUP=1 "$qs_bin" "${QS_ARGS[@]}" -n >> "$logdir/shell.log" 2>&1 9>&-
    rc=$?

    if ! locked && [ "$rc" -eq 0 ]; then
        exit 0
    fi
    # Another instance is running and holding things; leave it be.
    alive && exit 0

    # Relaunch straight away, but back off if the shell keeps dying: more than
    # five starts in thirty seconds waits five seconds between tries. It never
    # gives up after a crash or while locked -- giving up is the wedge.
    now=$(date +%s)
    kept=()
    for t in "${starts[@]}"; do
        [ $((now - t)) -lt 30 ] && kept+=("$t")
    done
    starts=("${kept[@]}" "$now")
    if [ "${#starts[@]}" -gt 5 ]; then
        if [ "$qs_bin" = "$local_qs" ]; then
            printf 'Local Quickshell failed repeatedly; falling back to packaged qs.\n' >> "$logdir/shell.log"
            qs_bin=qs
            starts=()
        fi
        sleep 5
    else
        sleep 0.2
    fi
done
