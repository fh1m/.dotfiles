[Unit]
Description=Homie drives through pinned encrypted SSH
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/sshfs -f homie:/mnt/homie %h/Den/Homie -F %h/.local/state/homie-control/client.conf -o reconnect,auto_unmount,idmap=user,ServerAliveInterval=15,ServerAliveCountMax=3,ConnectTimeout=5
ExecStop=/usr/bin/fusermount3 -u %h/Den/Homie
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
[Install]
WantedBy=default.target
