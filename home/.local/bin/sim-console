#!/usr/bin/python3
"""Open a CUDA workbench on workspace 4, offloading the terminal when available."""
import os
import subprocess

subprocess.run(['hyprctl', 'dispatch', 'hl.dsp.focus({workspace="4"})'], check=True)
os.execv('@HOME@/.local/bin/sensei-gpu-run', ['@HOME@/.local/bin/sensei-gpu-run', 'nvidia', '@HOME@/.local/bin/sensei-terminal',
                            '--class', 'robot-sim', '--title', 'SIM-CUDA', 'zsh'])
