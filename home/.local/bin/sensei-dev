#!/usr/bin/env python3
"""Environment-aware development, learning and persistent tmux companions."""
import argparse
import hashlib
import gzip
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import parse_qs, urlparse
from datetime import datetime

SOURCE = Path(__file__).resolve()
HOST = Path(os.environ.get('SENSEI_HOST_HOME', str(SOURCE.parents[4] if SOURCE.parents[3].name == '.dotfiles' else Path.home())))
STATE = HOST / '.local/state/sensei-dev/projects.json'
REPO = HOST / '.dotfiles'
sys.path.insert(0, str(REPO / 'home/.local/lib'))

def read():
    if not STATE.exists(): return {'version': 1, 'projects': []}
    try:
        data = json.loads(STATE.read_text())
        if data.get('version') != 1 or not isinstance(data.get('projects'), list):
            raise ValueError('unsupported registry')
        return data
    except (ValueError, OSError) as e:
        raise SystemExit(f'Cannot read {STATE}: {e}; the original file has not been changed.')

def write(data):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile('w', dir=STATE.parent, delete=False) as f:
        json.dump(data, f, indent=2); f.write('\n'); tmp = Path(f.name)
    tmp.chmod(0o600); tmp.replace(STATE)

def containers():
    r = subprocess.run(['distrobox', 'list', '--no-color'], text=True, capture_output=True, check=True)
    names = []
    for row in r.stdout.splitlines()[1:]:
        fields = row.split('|')
        if len(fields) >= 2: names.append(fields[1].strip())
    return names

def profile(value):
    path = Path(value).expanduser().resolve()
    if not path.is_dir(): raise SystemExit(f'Project directory does not exist: {path}')
    matches = [p for p in read()['projects'] if path == Path(p['root']) or Path(p['root']) in path.parents]
    if matches:
        p = max(matches, key=lambda x: len(x['root'])).copy()
        p['cwd'] = str(path)
        return p
    p = {'root': str(path), 'cwd': str(path), 'container': None}
    # Container homes are your convention, not a hardcoded auv-only special case.
    try:
        name = path.relative_to(HOST / 'Envs/dockers').parts[0]
        if name in containers(): p['container'] = name
    except (ValueError, IndexError): pass
    if p['container']:
        p['ros_setup'] = []
        p['overlay'] = str(path / 'install/setup.zsh')
    return p

def command(p, argv):
    # Arguments are separate argv entries: project paths and prompts are never shell code.
    data = {k: v for k, v in p.items() if k != 'cwd'}
    body = '''cd -- "$1" || exit; shift
export SENSEI_HOST_HOME="$1"; shift
export SENSEI_DEV_PROFILE="$1"; shift
export PATH="$HOME/.local/bin:$HOME/.local/opt/node/bin:$PATH"
if [[ "$SENSEI_DEV_PROFILE" != "" ]]; then
  while IFS= read -r setup; do [[ -f "$setup" ]] && source "$setup"; done < <(python3 -c 'import json,os; p=json.loads(os.environ["SENSEI_DEV_PROFILE"]); print("\\n".join(p.get("ros_setup",[])+([p["overlay"]] if p.get("overlay") else [])))')
fi
exec "$@"'''
    args = ['zsh', '-lic', body, 'sensei-dev', p.get('cwd', p['root']), str(HOST), json.dumps(data), *argv]
    if p.get('container'):
        return ['distrobox', 'enter', '--name', p['container'], '--', *args]
    return args

def configure(args):
    data = read(); p = profile(args.path)
    p['root'] = str(Path(args.path).expanduser().resolve())
    p.pop('cwd', None)
    if args.container is not None:
        if args.container != 'host' and args.container not in containers(): raise SystemExit('Unknown Distrobox: ' + args.container)
        p['container'] = None if args.container == 'host' else args.container
    if args.python: p['python'] = str(Path(args.python).expanduser().resolve())
    if args.ros_setup is not None: p['ros_setup'] = args.ros_setup
    if args.overlay is not None: p['overlay'] = str(Path(args.overlay).expanduser().resolve())
    if args.container and args.container != 'host' and args.ros_setup is None:
        # Discover actual underlays in the selected environment, not guessed distro names.
        r = subprocess.run(command(p, ['python3', '-c', 'from pathlib import Path; print("\\n".join(str(x) for x in sorted(Path("/opt/ros").glob("*/setup.zsh"))))']), text=True, capture_output=True, check=True)
        setups = [s for s in r.stdout.splitlines() if s.startswith('/opt/ros/')]
        if len(setups) == 1: p['ros_setup'] = setups
        elif len(setups) > 1: raise SystemExit('Multiple ROS distros: select --ros-setup explicitly.')
    data['projects'] = [x for x in data['projects'] if x['root'] != p['root']] + [p]
    write(data); print(json.dumps(p, indent=2))

def tmux_open(p, argv, role, new=False):
    if not shutil.which('tmux'): raise SystemExit('tmux is required')
    # Keep the existing daily_dev server/session convention.
    session = subprocess.run(['tmux', 'display-message', '-p', '#{session_name}'], text=True, capture_output=True).stdout.strip() if os.environ.get('TMUX') else 'daily_dev'
    if subprocess.run(['tmux', 'has-session', '-t', '=' + session], capture_output=True).returncode:
        prepare = HOST / '.local/bin/sensei-tmux'
        if prepare.exists(): subprocess.run([str(prepare), '--prepare'], check=True)
        else: subprocess.run(['tmux', 'new-session', '-d', '-s', session], check=True)
    identity = hashlib.sha256((p['root'] + ':' + str(p.get('container')) + ':' + role).encode()).hexdigest()[:20]
    target = None
    if not new:
        r = subprocess.run(['tmux', 'list-panes', '-a', '-F', '#{window_id}\t#{pane_dead}\t#{@sensei_dev_id}'], text=True, capture_output=True)
        for line in r.stdout.splitlines():
            fields = line.split('\t')
            if len(fields) == 3 and fields[1] == '0' and fields[2] == identity: target = fields[0]; break
    if not target:
        label = f'{Path(p["root"]).name[:20]}:{role}'
        target = subprocess.check_output(['tmux', 'new-window', '-P', '-F', '#{window_id}', '-t', session + ':', '-n', label,
            '-c', p['root'], shlex.join(command(p, argv))], text=True).strip()
        subprocess.run(['tmux', 'set-option', '-w', '-t', target, '@sensei_dev_id', identity], check=True)
    if os.environ.get('TMUX'): subprocess.run(['tmux', 'switch-client', '-t', target], check=True)
    else:
        subprocess.run(['tmux', 'select-window', '-t', target], check=True)
        subprocess.Popen([str(HOST / '.local/bin/sensei-terminal'), '-e', 'tmux', 'attach-session', '-t', target], start_new_session=True)
    return target

def ensure(p):
    if not p.get('container'): return
    # On-demand provisioning is visible; no container is kept running for the editor.
    r = subprocess.run(command(p, ['sh', '-c', 'test -f "$HOME/.local/state/sensei-dev/ready.json"']), capture_output=True)
    if r.returncode:
        print(f'Preparing editor tools in {p["container"]} (first use only)…', flush=True)
        subprocess.run(command(p, ['python3', str(REPO / 'scripts/setup-dev.py'), '--activate']), check=True)

def doctor(p):
    script = '''import os,json,shutil,subprocess
from pathlib import Path
p=json.loads(os.environ['SENSEI_DEV_PROFILE']); py=p.get('python') or shutil.which('python3')
tools={k:shutil.which(k) for k in ['nvim','rg','fd','fzf','bat','node','gh','clangd','ruff','basedpyright-langserver','debugpy','colcon','cmake','gdb','codex','claude','wl-copy']}
print(json.dumps({'project':p,'home':os.environ['HOME'],'tools':tools,'python':py,'pythonpath':os.environ.get('PYTHONPATH'),'overlay_exists':Path(p.get('overlay','/nonexistent')).exists()},indent=2))
if py:
 r=subprocess.run([py,'-c','import sys; print("Interpreter:",sys.executable); import rclpy; print("rclpy:",rclpy.__file__)'],capture_output=True,text=True)
 print(r.stdout.strip()); print(r.stderr.strip() if p.get('ros_setup') and r.returncode else '')
'''
    return subprocess.run(command(p, ['python3', '-c', script])).returncode

def compile_db(p):
    root = Path(p['root']); entries = []
    for file in sorted((root / 'build').glob('**/compile_commands.json')):
        entries.extend(json.loads(file.read_text()))
    if not entries: raise SystemExit('No build compile databases. Run an explicit CMake/colcon configure with CMAKE_EXPORT_COMPILE_COMMANDS=ON first.')
    dest = root / 'compile_commands.json'
    if dest.exists() and not dest.is_symlink():
        raise SystemExit('An existing project compile_commands.json is preserved; merge it manually or move it first.')
    cache = Path.home() / '.cache/sensei-dev' / hashlib.sha256(str(root).encode()).hexdigest()[:16]
    cache.mkdir(parents=True, exist_ok=True)
    db = cache / 'compile_commands.json'; db.write_text(json.dumps(entries, indent=2))
    if dest.is_symlink(): dest.unlink()
    dest.symlink_to(db); print(f'{len(entries)} compile commands → {db}')

def learn(p, diff=False):
    import sensei_knowledge as k
    excerpt = ''
    if diff:
        for flags in [[], ['--cached']]:
            excerpt += subprocess.run(['git', '-C', p['root'], 'diff', *flags, '--no-ext-diff', '--'], text=True, capture_output=True, check=True).stdout
        if not excerpt.strip(): raise SystemExit('No changes to capture.')
    file, _ = k.action(HOST, p, 'review' if diff else 'scratchpad', excerpt=excerpt, filetype='diff' if diff else '')
    tmux_open(p, ['nvim', str(file)], 'review' if diff else 'notes')
    print(file)

def host_action(argv):
    # Launch desktop tools on the host even when invoked inside a container.
    if Path('/run/.containerenv').exists() or Path('/.dockerenv').exists():
        return subprocess.run(['distrobox-host-exec', *argv]).returncode
    return subprocess.run(argv).returncode

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    for name in ['open', 'doctor', 'configure', 'setup', 'compile-db', 'learn', 'sketch']:
        s = sub.add_parser(name); s.add_argument('path', nargs='?', default=os.getcwd())
        if name in ['open', 'configure', 'setup']: s.add_argument('--container')
        if name in ['open', 'configure']: s.add_argument('--python')
        if name == 'configure':
            s.add_argument('--ros-setup', action='append'); s.add_argument('--overlay')
        if name == 'open': s.add_argument('--new', action='store_true')
        if name == 'learn': s.add_argument('--diff', action='store_true')
    s = sub.add_parser('agent'); s.add_argument('agent', choices=['codex', 'claude']); s.add_argument('path', nargs='?', default=os.getcwd()); s.add_argument('--new', action='store_true')
    s = sub.add_parser('browse'); s.add_argument('url')
    s = sub.add_parser('knowledge'); s.add_argument('path', nargs='?', default=os.getcwd())
    s.add_argument('--kind', choices=['project','scratchpad','review','canvas','base','daily','open','draw','config'], default='project')
    s.add_argument('--vault'); s.add_argument('--source-file', default=''); s.add_argument('--excerpt')
    s.add_argument('--start', type=int, default=1); s.add_argument('--end', type=int, default=1); s.add_argument('--filetype', default='')
    s = sub.add_parser('uri'); s.add_argument('url')
    args = parser.parse_args()
    if args.action == 'uri':
        url = urlparse(args.url)
        if url.scheme != 'sensei-dev' or url.netloc != 'open': raise SystemExit('Unsupported development URI')
        values = parse_qs(url.query); p = profile(values.get('project', [''])[0]); ensure(p)
        file = values.get('file', [''])[0]
        if file:
            path = Path(file).resolve()
            if not path.is_file() or Path(p['root']) not in path.parents: raise SystemExit('Code link must point inside its project')
            line = int(values.get('line', ['1'])[0])
            if not 1 <= line <= 10000000: raise SystemExit('Invalid line')
            tmux_open(p, ['nvim', '+' + str(line), '--', str(path)], 'editor', new=True)
        else: tmux_open(p, ['nvim', p['root']], 'editor')
        return 0
    if args.action == 'browse':
        if not args.url.startswith(('https://', 'http://')): raise SystemExit('Only web URLs are accepted.')
        return host_action(['xdg-open', args.url])
    if args.action == 'configure': configure(args); return 0
    p = profile(args.path)
    if args.action == 'knowledge':
        import sensei_knowledge as k
        if args.kind == 'config': print(json.dumps(k.configuration(HOST))); return 0
        excerpt = Path(args.excerpt).read_text() if args.excerpt else ''
        file, gui = k.action(HOST, p, args.kind, args.vault, args.source_file, excerpt, args.start, args.end, args.filetype)
        if gui:
            cfg = k.configuration(HOST)
            vault = next(Path(v['path']) for v in cfg['vaults'] if Path(v['path']) in file.parents)
            return host_action(['xdg-open', k.uri(vault, file.relative_to(vault))])
        print(file); return 0
    if getattr(args, 'container', None):
        if args.container not in containers(): raise SystemExit('Unknown Distrobox')
        p['container'] = args.container
    if getattr(args, 'python', None): p['python'] = str(Path(args.python).expanduser().resolve())
    if args.action == 'doctor': return doctor(p)
    if args.action == 'setup':
        return subprocess.run(command(p, ['python3', str(REPO / 'scripts/setup-dev.py'), '--activate'])).returncode
    if args.action == 'compile-db': compile_db(p); return 0
    if args.action == 'learn': learn(p, args.diff); return 0
    if args.action == 'sketch':
        import sensei_knowledge as k
        file, _ = k.action(HOST, p, 'draw')
        return host_action(['xdg-open', k.uri(file.parent, file.name)])
    ensure(p)
    if args.action == 'open': tmux_open(p, ['nvim', p.get('cwd', p['root'])], 'editor', args.new)
    elif args.action == 'agent':
        check = subprocess.run(command(p, ['sh', '-c', 'command -v "$1" >/dev/null', 'sensei-check', args.agent]), capture_output=True)
        if check.returncode:
            subprocess.run(command(p, ['python3', str(REPO / 'scripts/setup-dev.py'), '--agents-only']), check=True)
        tmux_open(p, [args.agent, '--no-alt-screen'] if args.agent == 'codex' else [args.agent], args.agent, args.new)
    return 0

if __name__ == '__main__':
    try: sys.exit(main())
    except (subprocess.CalledProcessError, OSError) as e: raise SystemExit(str(e))
