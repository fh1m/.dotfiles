#!/usr/bin/env python3
"""Hold the seat's short power-key inhibitor; no shutdown authority or polling."""
import signal
import threading
import os
import ctypes
import fcntl
import dbus
stop=threading.Event()
for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,lambda *_:stop.set())
parent=os.getppid()
# A crashed/restarted shell must not leave a login1 inhibitor behind.
if ctypes.CDLL(None,use_errno=True).prctl(1,signal.SIGTERM,0,0,0)!=0:
 raise OSError(ctypes.get_errno(),"Cannot bind power-key helper to shell lifetime")
if os.getppid()!=parent or parent==1:raise SystemExit(0)
lock=open(os.path.join(os.environ.get('XDG_RUNTIME_DIR','/run/user/'+str(os.getuid())),'sensei-power-key.lock'),'a')
try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:raise SystemExit(0)
bus=dbus.SystemBus()
manager=dbus.Interface(bus.get_object('org.freedesktop.login1','/org/freedesktop/login1'),'org.freedesktop.login1.Manager')
fd=manager.Inhibit('handle-power-key','Sensei','Physical power key opens session choices','block').take()
try:stop.wait()
finally:
 import os
 os.close(fd)
