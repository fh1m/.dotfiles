#!/usr/bin/python3
"""Personal screenshot and recording shortcuts for this dual-output Hyprland session."""
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

HOME_DIR = Path('@HOME@')
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
STATE = RUNTIME / 'desktop-recording.json'
UNIT = 'desktop-recording.service'

def run(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)

def notify(title, message, urgent=False):
    subprocess.run(['notify-send', '-a', 'Desktop Capture', '-u', 'critical' if urgent else 'normal', title, str(message)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def filename(folder, prefix, suffix):
    folder.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime('%Y-%m-%d_%H-%M-%S_%f')
    return folder / f'{prefix}_{stamp}.{suffix}'

def monitors():
    return json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], text=True))

def geometry_monitor(geometry, displays):
    match = re.fullmatch(r'(-?\d+),(-?\d+) (\d+)x(\d+)', geometry)
    if not match:
        raise ValueError('Invalid selection geometry')
    x, y, w, h = map(int, match.groups())
    if w < 1 or h < 1:
        raise ValueError('Empty selection')
    for display in displays:
        width, height = display['width'] / display['scale'], display['height'] / display['scale']
        if display.get('transform', 0) % 2:
            width, height = height, width
        if display['x'] <= x and display['y'] <= y and x + w <= display['x'] + width and y + h <= display['y'] + height:
            return display['name']
    raise ValueError('For recording, select an area inside one display')

def screenshot(args):
    output = filename(HOME_DIR / 'Pictures/Screenshots', 'Screenshot', 'png')
    if args.geometry:
        run(['grim', '-g', args.geometry, str(output)])
        with output.open('rb') as data:
            run(['wl-copy', '--type', 'image/png'], stdin=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        command = ['grimblast']
        if args.mode == 'area' and shutil.which('hyprpicker'):
            command.append('--freeze')
        command += ['copysave', args.mode, str(output)]
        logpath = HOME_DIR / ".local/state/wrayth/capture.log"
        logpath.parent.mkdir(parents=True, exist_ok=True)
        with logpath.open("a") as errors:
            result = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=errors)
        if result.returncode != 0:
            if args.mode == 'area' and not output.exists():
                return  # Escape is a normal cancellation.
            raise RuntimeError('Screenshot failed; check grimblast output')
    if not output.exists() or output.stat().st_size == 0:
        return
    notify('Screenshot saved and copied', output)
    print(output)

def recording(args):
    with (RUNTIME / 'desktop-recording.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        active = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', UNIT]).returncode == 0
        if active:
            run(['systemctl', '--user', 'stop', UNIT])
            return
        if args.mode == 'stop':
            return
        displays = monitors()
        geometry = args.geometry
        if args.mode == 'area' and not geometry:
            selection = subprocess.run(['slurp'], capture_output=True, text=True)
            if selection.returncode or not selection.stdout.strip():
                return
            geometry = selection.stdout.strip()
        display = geometry_monitor(geometry, displays) if geometry else next((m['name'] for m in displays if m.get('focused')), displays[0]['name'])
        output = filename(HOME_DIR / 'Videos/Screencasts', 'Screencast', 'mp4')
        command = ['wf-recorder', '--no-dmabuf', '-o', display, '-r', '30', '-c', 'libx264', '-p', 'preset=ultrafast', '-p', 'crf=23', '-x', 'yuv420p', '-F', 'scale=trunc(min(iw\\,1920)/2)*2:-2', '-f', str(output)]
        if geometry:
            command += ['-g', geometry]
        # Capture system playback, not the microphone. Silent mode is available.
        if not args.silent:
            sink = subprocess.check_output(['pactl', 'get-default-sink'], text=True).strip()
            command.append(f'--audio={sink}.monitor')
        state = {'file': str(output), 'display': display, 'command': command}
        STATE.write_text(json.dumps(state));STATE.chmod(0o600)
        subprocess.run(['systemctl', '--user', 'reset-failed', UNIT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        run(['systemctl', '--user', 'start', UNIT])
        time.sleep(.7)
        if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', UNIT]).returncode:
            raise RuntimeError('Recorder did not start; inspect journalctl --user -u desktop-recording')
        notify('Recording started • system audio' if not args.silent else 'Recording started • silent', f'{display} — press Super+Print Screen again to stop')
        print(output)

def worker():
    state = json.loads(STATE.read_text())
    os.execvp(state['command'][0], state['command'])

def finished():
    if not STATE.exists():
        return
    state = json.loads(STATE.read_text());output = Path(state['file'])
    good = output.exists() and output.stat().st_size > 0 and subprocess.run(['ffprobe', '-v', 'error', str(output)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    notify('Recording saved' if good else 'Recording failed', output if good else 'See journalctl --user -u desktop-recording', not good)
    state['completed'] = True;state['valid'] = good;STATE.write_text(json.dumps(state))

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['screenshot', 'record', 'worker', 'finished', 'status'])
    parser.add_argument('mode', nargs='?', default='area', choices=['area', 'output', 'active', 'screen', 'stop'])
    parser.add_argument('--geometry', help='Explicit logical region, mainly for verification')
    parser.add_argument('--silent', action='store_true')
    args = parser.parse_args()
    try:
        if args.action == 'screenshot': screenshot(args)
        elif args.action == 'record': recording(args)
        elif args.action == 'worker': worker()
        elif args.action == 'finished': finished()
        else: print(STATE.read_text() if STATE.exists() else 'No recording started')
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        notify('Capture error', str(error), True)
        print(str(error), file=sys.stderr);sys.exit(1)
