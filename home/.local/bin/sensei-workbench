#!/usr/bin/env python3
"""Open a durable scratchpad or capture visual lab evidence into the active vault."""
import datetime
import json
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

BIN=Path.home()/'.local/bin'


def scratch(api,root):
    folder=root/'Scratchpad';folder.mkdir(exist_ok=True)
    note=folder/'Scratchpad.md';canvas=folder/'Scratchpad.canvas'
    if not note.exists():
        with note.open('x') as f:f.write('# Scratchpad\n\nIdeas, equations, sketches. No required structure.\n\n')
    if not canvas.exists():
        with canvas.open('x') as f:json.dump({'nodes':[{'id':'scratch-note','type':'file','file':'Scratchpad/Scratchpad.md','x':0,'y':0,'width':540,'height':500}],'edges':[]},f)
    api['navigate'](root,canvas.relative_to(root))


def capture(api,root):
    # Focus metadata is captured before selection opens. No clipboard text is read.
    window=json.loads(subprocess.check_output(['hyprctl','activewindow','-j'],text=True))
    result=subprocess.run([str(BIN/'desktop-capture'),'screenshot','area'],capture_output=True,text=True,check=True)
    paths=[Path(line) for line in result.stdout.splitlines() if Path(line).is_file()]
    if not paths:return
    source=paths[-1];folder=root/'Scratchpad/Evidence';folder.mkdir(parents=True,exist_ok=True)
    target=folder/source.name
    if target.exists():raise ValueError('Evidence already exists; original kept')
    shutil.copy2(source,target)
    stamp=datetime.datetime.now().strftime('%Y-%m-%d %H%M%S-%f')
    note=root/'Scratchpad'/('Lab capture '+stamp+'.md')
    with note.open('x') as f:
        f.write('# Lab capture\n\n'+datetime.datetime.now().astimezone().isoformat()+'\n\n')
        f.write('![[Evidence/'+target.name+']]\n\n')
        f.write('Context: '+window.get('class','Unknown application')+' · '+window.get('title','').replace('\n',' ')+'\n\n')
        f.write('## Observation\n\n## Expected vs actual\n\n## Next test\n\n')
    api['navigate'](root,note.relative_to(root))

if __name__=='__main__':
    try:
        if len(sys.argv)!=2 or sys.argv[1] not in ('scratch','capture'):raise ValueError('Use scratch or capture')
        api=runpy.run_path(str(BIN/'sensei-learn'));root=api['vault']()
        (scratch if sys.argv[1]=='scratch' else capture)(api,root)
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        subprocess.run(['notify-send','Workbench',str(error)])
        sys.exit(1)
