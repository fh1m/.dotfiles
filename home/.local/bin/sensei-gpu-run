#!/usr/bin/env python3
"""Compatibility launcher for a single NVIDIA desktop; CUDA is never disabled."""
import os, sys
from _sensei_machine import clean_graphics_env
args = sys.argv[1:]
if len(args) < 2 or args[0] not in ('auto', 'nvidia', 'intel'):
    raise SystemExit('Usage: sensei-gpu-run auto|nvidia COMMAND [ARGS...]')
if args[0] == 'intel':
    raise SystemExit('This desktop has no Intel display GPU; use auto or nvidia.')
os.execvpe(args[1], args[1:], clean_graphics_env())
