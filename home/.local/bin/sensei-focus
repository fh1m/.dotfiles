#!/usr/bin/env python3
"""Arrow navigation respects the focused window's native tab group."""
import json
import subprocess
import sys
import os,socket,time
from pathlib import Path
sys.path.insert(0,str(Path.home()/".local/share/sensei"))
from den_layout import roles

if len(sys.argv)!=2 or sys.argv[1] not in ('left','right','up','down'):
    raise SystemExit('Use left, right, up or down')
direction=sys.argv[1]
hypr=['hyprctl','-i','0']
window=json.loads(subprocess.check_output(hypr+['activewindow','-j'],text=True))
home=Path.home();state=home/'.local/state/homie-control'
try:
 presence=json.loads((home/'.local/state/sensei-den/presence.json').read_text())
 together=presence.get('peer') is True and presence.get('mode',{}).get('effective')=='together' and time.time()-presence.get('time',0)<35
 if together and len(window.get('grouped',[]))<2:
  monitors=json.loads(subprocess.check_output(hypr+['monitors','-j'],text=True));display_roles=roles(monitors);focused=next((m for m in monitors if m.get('focused')),None)
  if socket.gethostname().split('.')[0]=='homie' and direction in ('left','down') and (state/'input/return-armed').read_text().strip()=='1':
   subprocess.run([str(state/'bin/lan-mouse'),'cli','return-edge','2' if direction=='left' else '1'],check=True,timeout=2);raise SystemExit(0)
  if socket.gethostname().split('.')[0]=='arete' and direction=='right' and focused and focused['name']==display_roles.get('upper',{}).get('name') and (state/'bin/den-edge-nudge').is_file():
   if subprocess.run(['systemctl','--user','is-active','--quiet','den-input']).returncode==0:
    m=display_roles['upper'];x=m['x']+m['width']/m['scale']-8;y=m['y']+m['height']/m['scale']/2
    subprocess.run(hypr+['dispatch','hl.dsp.cursor.move({x='+str(round(x))+',y='+str(round(y))+'})'],check=True,capture_output=True)
    instance=json.loads(subprocess.check_output(['hyprctl','instances','-j'],text=True))[0];env=dict(os.environ,WAYLAND_DISPLAY=instance['wl_socket'])
    subprocess.run([str(state/'bin/den-edge-nudge'),'7','0'],env=env,check=True,timeout=2)
    subprocess.run([str(state/'bin/den-edge-nudge'),'1','0'],env=env,check=True,timeout=2);raise SystemExit(0)
except (OSError,ValueError,TypeError,KeyError,StopIteration,subprocess.SubprocessError):pass

if direction in ('left','right') and len(window.get('grouped',[]))>1:
    dispatch='hl.dsp.group.'+('prev' if direction=='left' else 'next')+'()'
else:dispatch='hl.dsp.focus({direction='+json.dumps(direction)+'})'
subprocess.run(hypr+['dispatch',dispatch],check=True,capture_output=True)
