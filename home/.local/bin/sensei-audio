#!/usr/bin/python3
import subprocess,json,sys

def fetch(what):
 command=['pactl','-f','json']+(['info'] if what=='info' else ['list']+([what] if what else []))
 result=subprocess.run(command,capture_output=True,text=True,timeout=3)
 if result.returncode:raise RuntimeError('Audio server query failed')
 data=json.loads(result.stdout)
 if not isinstance(data,dict):raise ValueError('Invalid audio inventory')
 return data
a=sys.argv[1:]
if not a or a[0]=='list':
 try:
  all_nodes=fetch('')
  data={k:all_nodes.get(k.replace('-','_'),[]) for k in ['sinks','sources','sink-inputs','source-outputs','cards']}
  info=fetch('info')
  data['defaultSink']=info.get('default_sink_name','');data['defaultSource']=info.get('default_source_name','')
  for kind in ('sinks','sources','cards'):
   for node in data[kind]:
    node['_source']=kind=='sources'
    for field in ('ports','profiles'):
     if isinstance(node.get(field),list):node[field]={v['name']:v for v in node[field]}
  print(json.dumps(data))
 except (OSError,ValueError,KeyError,TypeError,RuntimeError,subprocess.SubprocessError):
  print(json.dumps({'error':'Audio server unavailable or its device inventory could not be read. Refresh after PipeWire reconnects.'}))
  sys.exit(1)
else:
 commands={'output':['set-default-sink'],'input':['set-default-source'],'mute':['set-sink-mute'],'micmute':['set-source-mute'],'volume':['set-sink-volume'],'micvolume':['set-source-volume'],'appvolume':['set-sink-input-volume'],'appmute':['set-sink-input-mute'],'capturevolume':['set-source-output-volume'],'capturemute':['set-source-output-mute'],'route':['move-sink-input'],'capture-route':['move-source-output'],'port':['set-sink-port'],'inputport':['set-source-port'],'profile':['set-card-profile']}
 if a[0] not in commands:raise SystemExit('Unknown audio action')
 import re
 # pactl would read a leading dash as an option; only signed numbers such as -5% or -3dB may start with one.
 args=[v for v in a[1:] if v!='']
 for v in args:
  if v.startswith('-') and not re.fullmatch(r'-\d+(\.\d+)?(%|dB)?',v):raise SystemExit('Refusing an argument that looks like an option: '+v)
 subprocess.run(['pactl']+commands[a[0]]+args,check=True)
