#!/usr/bin/python3
import os,time,json,re,platform,subprocess
from pathlib import Path
now=time.monotonic(); cache=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/'fh1m-monitor.json'
details=os.environ.get('SENSEI_MONITOR_DETAIL')=='1'
inventory=os.environ.get('SENSEI_MONITOR_INVENTORY')=='1'
try: old=json.loads(cache.read_text())
except Exception: old={}
dt=max(.1,now-old.get('time',now-2)); tick=os.sysconf('SC_CLK_TCK'); page=os.sysconf('SC_PAGE_SIZE')
cpus={}; usage=[]
for line in Path('/proc/stat').read_text().splitlines():
    if not line.startswith('cpu'):continue
    fields=line.split();values=list(map(int,fields[1:9]));total=sum(values);idle=values[3]+values[4];key=fields[0];cpus[key]=[total,idle];before=old.get('cpus',{}).get(key,[total,idle]);delta=total-before[0];usage.append(round(max(0,min(100,100*(1-(idle-before[1])/delta))),1) if delta else 0)
mem={k:int(v.split()[0])*1024 for k,v in [line.split(':',1) for line in Path('/proc/meminfo').read_text().splitlines()]}
processes=[];pids={};processCount=0
for path in Path('/proc').iterdir():
    if not path.name.isdigit():continue
    processCount+=1
    if not details:continue
    try:
        raw=(path/'stat').read_text();name=raw[raw.index('(')+1:raw.rindex(')')];fields=raw[raw.rindex(')')+2:].split();pid=int(path.name);start=int(fields[19]);ticks=int(fields[11])+int(fields[12]);rss=int(fields[21])*page;io={}
        try: io={k:int(v) for k,v in [x.split(':',1) for x in (path/'io').read_text().splitlines()]}
        except PermissionError:pass
        previous=old.get('pids',{}).get(path.name,{});same=previous.get('start')==start
        cpu=max(0,(ticks-previous.get('ticks',ticks))/tick/dt*100) if same else 0
        read=max(0,(io.get('read_bytes',0)-previous.get('read',io.get('read_bytes',0)))/dt) if same and io else None
        write=max(0,(io.get('write_bytes',0)-previous.get('write',io.get('write_bytes',0)))/dt) if same and io else None
        pids[path.name]={'start':start,'ticks':ticks,'read':io.get('read_bytes',0),'write':io.get('write_bytes',0)}
        command=(path/'cmdline').read_bytes().replace(b'\0',b' ').decode(errors='replace').strip()
        processes.append({'pid':pid,'name':name,'cpu':round(cpu,1),'ram':rss,'memory':round(rss/mem['MemTotal']*100,2),'read':read,'write':write,'threads':int(fields[17]),'command':command or name,'uid':path.stat().st_uid})
    except (OSError,ValueError,IndexError):pass
mounts=[];seen=set()
for line in Path('/proc/mounts').read_text().splitlines():
    device,mount,fs,*_=line.split();mount=mount.replace('\\040',' ')
    if not device.startswith('/dev/') or fs in ('squashfs',):continue
    try:
        st=os.statvfs(mount);key=os.stat(mount).st_dev
        if key in seen:continue
        seen.add(key);total=st.f_blocks*st.f_frsize;free=st.f_bavail*st.f_frsize;used=(st.f_blocks-st.f_bfree)*st.f_frsize
        mounts.append({'mount':mount,'device':device,'fs':fs,'total':total,'free':free,'used':used,'percent':round(used/total*100,1) if total else 0})
    except OSError:pass
nets={};network=[]
for line in Path('/proc/net/dev').read_text().splitlines()[2:]:
    name,data=line.split(':');name=name.strip();v=list(map(int,data.split()));nets[name]=[v[0],v[8]];prev=old.get('nets',{}).get(name,[v[0],v[8]])
    if name!='lo':network.append({'name':name,'rx':max(0,(v[0]-prev[0])/dt),'tx':max(0,(v[8]-prev[1])/dt)})
disks={};storage=[]
for line in Path('/proc/diskstats').read_text().splitlines():
    v=line.split();name=v[2]
    if not re.fullmatch(r'nvme\d+n\d+|sd[a-z]+|mmcblk\d+',name):continue
    counters=[int(v[5])*512,int(v[9])*512,int(v[12])];disks[name]=counters;prev=old.get('disks',{}).get(name,counters)
    storage.append({'name':name,'read':max(0,(counters[0]-prev[0])/dt),'write':max(0,(counters[1]-prev[1])/dt),'busy':min(100,max(0,(counters[2]-prev[2])/dt/10))})
try:
    addresses=json.loads(subprocess.run(['ip','-j','address'],capture_output=True,text=True,timeout=2).stdout);ips=[a['local'] for interface in addresses for a in interface.get('addr_info',[]) if a['family']=='inet' and a.get('scope')=='global']
except Exception:ips=[]

# Expensive inventory is refreshed at most every five seconds, while live rates remain fast.
extra=old.get('extra',{});extraTime=old.get('extraTime',0)
if inventory and (now-extraTime>=5 or not extra):
    def read(path,default='—'):
        try:return Path(path).read_text().strip()
        except OSError:return default
    def command(args):
        try:return subprocess.run(args,capture_output=True,text=True,timeout=2).stdout.strip()[:30000]
        except (OSError,subprocess.SubprocessError):return 'Unavailable'
    batteries=[]
    for b in Path('/sys/class/power_supply').glob('*'):
        if read(b/'type')!='Battery':continue
        batteries.append({k:read(b/k) for k in ['manufacturer','model_name','status','capacity','energy_now','energy_full','energy_full_design','power_now','voltage_now','cycle_count','charge_control_end_threshold']})
    sensors=[]
    for h in Path('/sys/class/hwmon').glob('*'):
        name=read(h/'name')
        for sensor in h.glob('temp*_input'):
            try:sensors.append({'name':name+' / '+read(sensor.with_name(sensor.name.replace('_input','_label')),sensor.stem),'value':int(read(sensor))/1000})
            except ValueError:pass
    extra={'os':read('/etc/os-release'),'cpuInfo':read('/proc/cpuinfo').split('processor\t: 1')[0], 'batteries':batteries,'sensors':sensors,'usb':command(['lsusb']),'pci':'\n'.join(d.name+' · vendor '+read(d/'vendor')+' · device '+read(d/'device')+' · class '+read(d/'class')+' · driver '+(d/'driver').resolve().name for d in Path('/sys/bus/pci/devices').glob('*')), 'routes':command(['ip','route']), 'addresses':command(['ip','-br','address']), 'dns':read('/etc/resolv.conf'), 'connections':command(['ss','-tunap']), 'audio':command(['wpctl','status','-n']), 'profile':command(['@HOME@/.local/bin/sensei-power','name']), 'displays':command(['hyprctl','monitors','-j']), 'services':command(['systemctl','--user','--failed','--no-pager']), 'gpuDetails':'Dedicated GPU asleep — telemetry intentionally avoids waking it.'}
    nvidia=[d for d in Path('/sys/bus/pci/devices').glob('*') if read(d/'vendor')=='0x10de' and read(d/'class').startswith('0x03')]
    if nvidia and read(nvidia[0]/'power/runtime_status')=='active':
        fields='name,driver_version,pstate,temperature.gpu,utilization.gpu,utilization.memory,memory.used,memory.total,power.draw,power.limit,clocks.current.graphics,clocks.current.memory,clocks.current.sm,pcie.link.gen.current,pcie.link.width.current'
        values=command(['nvidia-smi','--query-gpu='+fields,'--format=csv,noheader'])
        extra['gpuDetails']='\n'.join(k.replace('.',' ').replace('_',' ').capitalize()+': '+v.strip() for k,v in zip(fields.split(','),values.split(',')))
    staticGpu='Driver module: '+read('/sys/module/nvidia/version')+'\nCUDA toolkit: '+('installed' if Path('/opt/cuda/bin/nvcc').exists() else 'not installed')
    if nvidia:
        d=nvidia[0]
        staticGpu+='\nPCI address: '+d.name+'\nVendor / device: '+read(d/'vendor')+' / '+read(d/'device')+'\nRuntime power: '+read(d/'power/runtime_status')+'\nPower policy: '+read(d/'power/control')
    extra['gpuDetails']=staticGpu+'\n\n'+extra['gpuDetails']
    extraTime=now
state={'time':now,'cpus':cpus,'pids':pids,'nets':nets,'disks':disks,'extra':extra,'extraTime':extraTime};tmp=cache.with_suffix('.tmp');tmp.write_text(json.dumps(state));tmp.chmod(0o600);tmp.replace(cache)
print(json.dumps({'extra':extra if inventory else {},'cpu':usage[0], 'cores':usage[1:],'memory':{'total':mem['MemTotal'],'used':mem['MemTotal']-mem['MemAvailable'],'available':mem['MemAvailable'],'cache':mem.get('Cached',0)+mem.get('Buffers',0),'swapTotal':mem['SwapTotal'],'swapUsed':mem['SwapTotal']-mem['SwapFree']},'processes':sorted(processes,key=lambda p:p['cpu'],reverse=True),'processCount':processCount,'mounts':mounts,'network':network,'storage':storage,'uptime':float(Path('/proc/uptime').read_text().split()[0]),'load':os.getloadavg(),'kernel':platform.release(),'host':platform.node(),'ips':ips,'sampleTime':time.time()}))
