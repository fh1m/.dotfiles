#!/usr/bin/env python3
"""Bounded, private frame-stall evidence. No window titles, audio or credentials."""
import argparse,json,os,subprocess,time
from pathlib import Path

def memory():
 values={}
 for line in Path('/proc/meminfo').read_text().splitlines():
  key,_,value=line.partition(':')
  if key in ('MemAvailable','SwapFree','SwapTotal'):values[key+'KiB']=int(value.split()[0])
 for row in Path('/proc/pressure/memory').read_text().splitlines():
  kind,*fields=row.split();values['memoryPsi_'+kind]={k:float(v) for k,v in (f.split('=') for f in fields)}
 return values

def main():
 parser=argparse.ArgumentParser(description=__doc__)
 parser.add_argument('--seconds',type=int,default=120)
 parser.add_argument('--output',type=Path)
 args=parser.parse_args()
 if not 1<=args.seconds<=3600:parser.error('--seconds must be 1–3600')
 dest=args.output or Path.home()/'.local/state/den-diagnostics'/time.strftime('frames-%Y%m%d-%H%M%S.jsonl')
 dest.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
 # Refuse overwrites and symlinks; samples can be shared after inspection.
 fd=os.open(dest,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
 deadline=time.monotonic()+args.seconds;count=0
 with os.fdopen(fd,'w') as out:
  while time.monotonic()<deadline:
   start=time.monotonic();sample={'at':time.time(),**memory()}
   try:
    result=subprocess.run(['hyprctl','-j','monitors'],capture_output=True,text=True,timeout=2)
    sample['compositorResponsive']=result.returncode==0
    if result.returncode==0:sample['outputs']=len(json.loads(result.stdout))
   except (OSError,ValueError,subprocess.TimeoutExpired):sample['compositorResponsive']=False
   sample['ipcMs']=round((time.monotonic()-start)*1000,2)
   out.write(json.dumps(sample)+'\n');out.flush();count+=1
   time.sleep(max(0,min(deadline-time.monotonic(),1-(time.monotonic()-start))))
 print(json.dumps({'samples':count,'path':str(dest),'note':'IPC responsiveness is not proof of presented frames.'}))
if __name__=='__main__':main()
