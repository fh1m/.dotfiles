#!/usr/bin/env python3
"""Saved and recent projects, opened on demand in persistent tmux windows."""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
STATE = HOME / '.local/state/sensei-projects.json'
ROOTS = [HOME / p for p in ('Projects', 'Work/Projects', 'Ros_workspaces', 'tmp', 'Documents/Report')]
SKIP = {'node_modules', 'build', 'install', 'log', '.venv', 'venv', '__pycache__', '.git', 'target'}
MARKERS = {'.git', 'package.xml', 'pyproject.toml', 'Cargo.toml', 'CMakeLists.txt', 'colcon.meta'}


def read():
    try:
        data = json.loads(STATE.read_text())
        return {k: [p for p in data.get(k, []) if Path(p).is_dir()] for k in ('saved', 'recent')}
    except (OSError, ValueError, TypeError):
        return {'saved': [], 'recent': []}


def write(data):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile('w', dir=STATE.parent, delete=False) as file:
        json.dump(data, file, indent=2)
        file.write('\n')
        temporary = file.name
    os.replace(temporary, STATE)


def discover():
    found = set()
    for root in ROOTS:
        if not root.is_dir():
            continue
        for base, dirs, files in os.walk(root):
            path = Path(base)
            depth = len(path.relative_to(root).parts)
            has_git = (path / '.git').exists()
            dirs[:] = [d for d in dirs if not d.startswith('.') and d not in SKIP] if depth < 3 else []
            if depth and (depth == 1 or MARKERS.intersection(files) or has_git):
                found.add(str(path))
    return found


def resolve(value, data):
    path = Path(value).expanduser()
    if path.is_dir():
        return str(path.resolve())
    matches = {p for p in data['saved'] + data['recent'] if Path(p).name == value}
    if len(matches) == 1:
        return matches.pop()
    raise SystemExit(f'Project not found or name ambiguous: {value}')


def open_project(path, data):
    if not Path(path).is_dir():
        raise SystemExit(f'Project unavailable: {path}')
    data['recent'] = [path] + [p for p in data['recent'] if p != path][:29]
    write(data)
    inside = bool(os.environ.get('TMUX'))
    if not inside and subprocess.run(['tmux', 'has-session', '-t', '=daily_dev'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
        subprocess.run([str(HOME / '.local/bin/sensei-tmux'), '--prepare'], check=True)
    command = ['tmux', 'new-window'] + ([] if inside else ['-t', 'daily_dev']) + ['-c', path, '-n', Path(path).name[:24]]
    subprocess.run(command, check=True)
    if not inside:
        subprocess.Popen([str(HOME / '.local/bin/sensei-terminal'), '--title', Path(path).name,
                          '-e', 'tmux', 'attach-session', '-t', 'daily_dev'], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def picker(data):
    while True:
        paths = list(dict.fromkeys(p for p in data['saved'] + data['recent'] + sorted(discover()) if Path(p).is_dir()))
        if not paths:
            raise SystemExit('No projects found. Add one with --add PATH.')
        rows = [('★ ' if p in data['saved'] else '↺ ' if p in data['recent'] else '  ') + Path(p).name + '\t' + p for p in paths]
        result = subprocess.run(['fzf', '--reverse', '--border=rounded', '--delimiter=\t', '--with-nth=1,2',
                                 '--expect=ctrl-s,ctrl-d', '--prompt=Project › ',
                                 '--header=Enter open · Ctrl-S save/unsave · Ctrl-D forget'],
                                input='\n'.join(rows) + '\n', text=True, capture_output=True)
        if result.returncode:
            return
        lines = result.stdout.splitlines()
        if len(lines) < 2 or '\t' not in lines[1]:
            return
        key, path = lines[0], lines[1].rsplit('\t', 1)[1]
        if key == 'ctrl-s':
            data['saved'] = [p for p in data['saved'] if p != path] if path in data['saved'] else data['saved'] + [path]
            write(data)
        elif key == 'ctrl-d':
            data['saved'] = [p for p in data['saved'] if p != path]
            data['recent'] = [p for p in data['recent'] if p != path]
            write(data)
        else:
            open_project(path, data)
            return


def main():
    data = read()
    command = sys.argv[1] if len(sys.argv) > 1 else '--pick'
    if command == '--list':
        for key, glyph in (('saved', '★'), ('recent', '↺')):
            for path in data[key]:
                if key == 'saved' or path not in data['saved']:
                    print(glyph, path)
    elif command == '--add' and len(sys.argv) > 2:
        path = resolve(sys.argv[2], data)
        if path not in data['saved']:
            data['saved'].append(path)
            write(data)
        print(path)
    elif command == '--remove' and len(sys.argv) > 2:
        path = resolve(sys.argv[2], data)
        data['saved'] = [p for p in data['saved'] if p != path]
        write(data)
    elif command == '--open' and len(sys.argv) > 2:
        open_project(resolve(sys.argv[2], data), data)
    elif command == '--pick':
        picker(data)
    else:
        raise SystemExit('Usage: sensei-project-picker [--pick|--list|--add PATH|--remove PATH|--open PATH/NAME]')


if __name__ == '__main__':
    main()
