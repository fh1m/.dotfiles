#!/usr/bin/python3
"""Focus a matching app across workspaces, or launch; Shift uses new-window."""
import fcntl,json,os,subprocess,sys,time
from pathlib import Path
APPS={
 'terminal':(['kitty'],['kitty'],['kitty']),
 'web':(['google-chrome','google-chrome-stable','chromium'],['google-chrome-stable'],['google-chrome-stable','--new-window']),
 'files':(['org.gnome.nautilus','nautilus'],['nautilus'],['nautilus','--new-window']),
 'calculator':(['org.gnome.calculator','gnome-calculator'],['gnome-calculator'],['gnome-calculator'])}
def main():
 app=sys.argv[1];mode=sys.argv[2] if len(sys.argv)>2 else 'focus-or-launch';dry='--dry-run' in sys.argv
 if app not in APPS or mode not in ('focus-or-launch','new-window'):raise ValueError('Unknown app/action')
 aliases,normal,new=APPS[app]
 runtime=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))
 with (runtime/f'sensei-app-{app}.lock').open('a+') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  clients=json.loads(subprocess.check_output(['hyprctl','clients','-j'],text=True))
  windows=[c for c in clients if c.get('class','').lower() in aliases or c.get('initialClass','').lower() in aliases]
  windows.sort(key=lambda c:c.get('focusHistoryID',999))
  if windows and mode=='focus-or-launch':
   address=windows[0]['address'];result={'action':'focus','app':app,'address':address,'workspace':windows[0]['workspace']['id']}
   if not dry:subprocess.run(['hyprctl','dispatch','hl.dsp.focus({window="address:'+address+'"})'],check=True,stdout=subprocess.DEVNULL)
  else:
   stamp=runtime/f'sensei-app-{app}.pending'
   if mode=='focus-or-launch' and stamp.exists() and time.time()-stamp.stat().st_mtime<5:
    result={'action':'pending','app':app}
   else:
    command=new if mode=='new-window' else normal
    result={'action':'launch','app':app,'command':command}
    if not dry:
     stamp.touch();subprocess.Popen(command,start_new_session=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
  print(json.dumps(result))
if __name__=='__main__':
 try:main()
 except Exception as e:print(str(e),file=sys.stderr);sys.exit(1)
