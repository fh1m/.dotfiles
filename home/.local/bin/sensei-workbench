#!/usr/bin/env python3
"""Open a durable scratchpad or capture visual lab evidence into the active vault."""
import argparse
import hashlib
import datetime
import json
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

BIN=Path.home()/'.local/bin'


def scratch(api,root):
    folder=root/'Scratchpad';folder.mkdir(exist_ok=True)
    note=folder/'Scratchpad.md';canvas=folder/'Scratchpad.canvas'
    if not note.exists():
        with note.open('x') as f:f.write('# Scratchpad\n\nIdeas, equations, sketches. No required structure.\n\n')
    if not canvas.exists():
        with canvas.open('x') as f:json.dump({'nodes':[{'id':'scratch-note','type':'file','file':'Scratchpad/Scratchpad.md','x':0,'y':0,'width':540,'height':500}],'edges':[]},f)
    api['navigate'](root,canvas.relative_to(root))


def capture(api,root,project=None,run=None):
    # Focus metadata is captured before selection opens. No clipboard text is read.
    window=json.loads(subprocess.check_output(['hyprctl','activewindow','-j'],text=True))
    result=subprocess.run([str(BIN/'desktop-capture'),'screenshot','area'],capture_output=True,text=True)
    if result.returncode in (1,130):return
    result.check_returncode()
    paths=[Path(line) for line in result.stdout.splitlines() if Path(line).is_file()]
    if not paths:return
    source=paths[-1];folder=root/'Scratchpad/Evidence';folder.mkdir(parents=True,exist_ok=True)
    target=folder/source.name
    if target.exists():raise ValueError('Evidence already exists; original kept')
    shutil.copy2(source,target)
    stamp=datetime.datetime.now().strftime('%Y-%m-%d %H%M%S-%f')
    note=root/'Scratchpad'/('Lab capture '+stamp+'.md')
    with note.open('x') as f:
        f.write('# Lab capture\n\n'+datetime.datetime.now().astimezone().isoformat()+'\n\n')
        f.write('![[Evidence/'+target.name+']]\n\n')
        f.write('Context: '+window.get('class','Unknown application')+' · '+window.get('title','').replace('\n',' ')+'\n\n')
        if project:
            revision=subprocess.run(['git','-C',str(project),'rev-parse','HEAD'],capture_output=True,text=True).stdout.strip()
            dirty=bool(subprocess.run(['git','-C',str(project),'status','--porcelain'],capture_output=True,text=True).stdout.strip())
            f.write('Project: '+str(project)+'\nRevision: '+revision+'\nWorking tree modified: '+str(dirty)+'\n\n')
        if run:
            f.write('Run receipt: '+str(run)+'\nReceipt SHA256: '+hashlib.sha256(run.read_bytes()).hexdigest()+'\n\n')
            log=run.parent/(run.stem+'.log') if run.parent.name=='jobs' else run.parent/'output.log'
            if log.is_file():
                with log.open('rb') as stream:
                    stream.seek(0,2);stream.seek(max(0,stream.tell()-16384));excerpt=stream.read().decode(errors='replace')
                # Preserve literal logs as an attachment rather than Markdown execution/content.
                evidence=folder/(stamp+'-log.txt');evidence.write_text(excerpt);f.write('Selected run log excerpt: [[Evidence/'+evidence.name+']]\n\n')
        f.write('Screenshot SHA256: '+hashlib.sha256(target.read_bytes()).hexdigest()+'\n\n')
        f.write('## Observation\n\n## Expected vs actual\n\n## Next test\n\n')
    api['navigate'](root,note.relative_to(root))

if __name__=='__main__':
    try:
        parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('action',choices=['scratch','capture']);parser.add_argument('--project',type=Path);parser.add_argument('--run',type=Path);args=parser.parse_args()
        project=args.project.expanduser().resolve() if args.project else None
        if project and not project.is_dir():raise ValueError('Project directory unavailable')
        run=args.run.expanduser().resolve() if args.run else None
        if run:
            permitted=[(Path.home()/'.local/state/sensei-den/jobs').resolve(),(Path.home()/'.local/state/sensei-lab').resolve()]
            if not run.is_file() or not any(run.is_relative_to(base) for base in permitted):raise ValueError('Choose an existing owned experiment/job receipt')
        api=runpy.run_path(str(BIN/'sensei-learn'));root=api['vault']()
        scratch(api,root) if args.action=='scratch' else capture(api,root,project,run)
    except (OSError,ValueError,subprocess.SubprocessError) as error:
        subprocess.run(['notify-send','Workbench',str(error)]);sys.exit(1)
