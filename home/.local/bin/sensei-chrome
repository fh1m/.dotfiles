#!/usr/bin/env python3
"""Profile-safe Chrome launcher for a single NVIDIA desktop.

Default graphics use native Wayland. Experimental video flags require a
matching observed browser/driver/kernel validation record; no PRIME/Intel path.
"""
import json, os, signal, subprocess, sys, time
from pathlib import Path
from _sensei_machine import command, clean_graphics_env, gpu_pci
os.umask(0o077)
home=Path.home()
state=home/'.config/hypr/chrome-gpu.json'
profile=home/'.config/google-chrome'
def config():
    try:return json.loads(state.read_text())
    except (OSError,ValueError):return {'mode':'auto'}
def fingerprint():
    return {'kernel':os.uname().release,'driver':command(['nvidia-smi','--query-gpu=driver_version','--format=csv,noheader']),
            'browser':command(['/usr/bin/google-chrome-stable','--version'])}
def validated():
    saved=config()
    return saved.get('validatedDesktop')==fingerprint() and bool(saved.get('decodeFlags'))
def browsers():
    result=[]
    for p in Path('/proc').glob('[0-9]*'):
        try:
            if p.stat().st_uid!=os.getuid() or (p/'comm').read_text().strip()!='chrome':continue
            args=(p/'cmdline').read_bytes().split(b'\0')
            if not any(a.startswith((b'--type=',b'--user-data-dir=')) for a in args):result.append(int(p.name))
        except OSError:pass
    return result
def status():
    actual='closed'
    node=Path('/dev/dri/by-path')/('pci-'+gpu_pci()+'-render')
    for p in Path('/proc').glob('[0-9]*'):
        try:
            if p.stat().st_uid!=os.getuid() or (p/'comm').read_text().strip()!='chrome':continue
            args=(p/'cmdline').read_bytes()
            if b'--type=gpu-process' not in args or b'--user-data-dir=' in args:continue
            for fd in (p/'fd').iterdir():
                try:
                    if os.readlink(fd)==str(node.resolve()):actual='NVIDIA'
                except OSError:pass
        except OSError:pass
    saved=config()
    return {**saved,'actual':actual,'running':bool(browsers()),'nvidiaAvailable':validated(),
            'settingsPending':False,'videoDecodeValidated':validated(),
            'note':'Single NVIDIA GPU · native Wayland. Video decoding '+('passed the recorded configuration.' if validated() else 'needs separate playback validation; default rendering retained.')}
def launch(args):
    env=clean_graphics_env()
    flags=['--ozone-platform=wayland','--password-store=gnome-libsecret']
    if config().get('mode')=='nvidia' and validated():
        env.update(LIBVA_DRIVER_NAME='nvidia',NVD_BACKEND='direct')
        flags+=config()['decodeFlags']
    os.execvpe('/usr/bin/google-chrome-stable',['/usr/bin/google-chrome-stable',*flags,*args],env)
def save(value):
    state.parent.mkdir(parents=True,exist_ok=True)
    temp=state.with_suffix('.tmp');temp.write_text(json.dumps(value));temp.replace(state)
try:
    args=sys.argv[1:];action=args[0] if args else 'launch'
    if action=='status':print(json.dumps(status()))
    elif action=='mode':
        mode=args[1]
        if mode not in ('auto','nvidia'):raise ValueError('This desktop supports default rendering or a tested NVIDIA decode profile.')
        if mode=='nvidia' and not validated():raise ValueError('Video decoding has not passed testing for this browser/driver/kernel.')
        save({**config(),'mode':mode});print(json.dumps(status()))
    elif action=='restart':
        # Graceful closure only, keeping profile/session databases intact.
        for pid in browsers():
            try:os.kill(pid,signal.SIGTERM)
            except ProcessLookupError:pass
        for _ in range(150):
            if not browsers():break
            time.sleep(.1)
        if browsers():raise RuntimeError('Close Chrome normally before retrying; nothing was forced.')
        log=home/'.local/state/sensei/chrome-launch.log';log.parent.mkdir(parents=True,exist_ok=True)
        with log.open('a') as output:
            subprocess.Popen([str(home/'.local/bin/sensei-chrome'),'launch','--restore-last-session'],stdin=subprocess.DEVNULL,stdout=output,stderr=output,start_new_session=True)
        print(json.dumps(status()))
    elif action=='launch':launch(args[1:])
    else:raise ValueError('Unknown action')
except (ValueError,IndexError,OSError,RuntimeError,subprocess.SubprocessError) as error:
    print(json.dumps({'error':str(error)}));sys.exit(1)
