#!/usr/bin/env python3
"""Publish the palette of the main wallpaper for the shell and terminal tools.

The wallpaper is the visual guide: its most vivid, readable colour becomes the
accent and its hue tints the surrounding surfaces. Achromatic images produce
a neutral palette instead of imposing a preset accent.
"""

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import colorsys
import shutil
import tomllib

from PIL import Image

home = Path.home()
state = home / ".config/sensei"
out = state / "wallpaper-palette.json"


NEUTRAL = {
    "ground": "#090909", "surface": "#111111", "raised": "#1a1a1a",
    "primary": "#c5c5c5", "vibrant": "#eeeeee", "secondary": "#b0b0b0",
    "tertiary": "#a4a4a4", "text": "#ebebeb", "muted": "#a8a8a8",
    "outline": "#383838", "error": "#ff647f",
}
DANGER = "#ff647f"


def _clamp(value, low, high):
    return max(low, min(high, value))


def _hex(hue, lightness, saturation):
    rgb = colorsys.hls_to_rgb(hue % 1.0, _clamp(lightness, 0, 1), _clamp(saturation, 0, 1))
    return "#%02x%02x%02x" % tuple(round(channel * 255) for channel in rgb)


def luminance(colour):
    rgb = tuple(int(colour[i:i + 2], 16) / 255 for i in (1, 3, 5))
    channels = (v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4 for v in rgb)
    return sum(c * w for c, w in zip(channels, (0.2126, 0.7152, 0.0722)))


def readable_accent(hue, lightness, saturation, surface):
    minimum = 4.5 * (luminance(surface) + 0.05) - 0.05
    for step in range(16):
        candidate = _hex(hue, lightness + step * 0.025, saturation)
        if luminance(candidate) >= minimum:
            return candidate
    return _hex(hue, 0.92, saturation)


def _hue_gap(a, b):
    gap = abs(a - b) % 1.0
    return min(gap, 1.0 - gap)


def palette_from_image(image):
    """Derive the UI palette from the image's own colours."""
    with Image.open(image) as source:
        source.thumbnail((160, 160))
        picture = source.convert("RGB")
    quantised = picture.quantize(colors=40, method=Image.Quantize.MEDIANCUT)
    raw = quantised.getpalette()
    counts = quantised.getcolors()
    total = sum(count for count, _ in counts) or 1
    swatches = []
    for count, index in counts:
        red, green, blue = (raw[index * 3 + i] / 255 for i in range(3))
        hue, lightness, saturation = colorsys.rgb_to_hls(red, green, blue)
        swatches.append((count / total, hue, lightness, saturation))
    # Vivid enough to see, and not so dark or pale that it disappears on black.
    usable = [item for item in swatches if item[3] >= 0.18 and 0.055 <= item[2] <= 0.92]
    if not usable:
        return dict(NEUTRAL)
    # Quantization often assigns a smooth sky one large swatch and splits
    # textured leaves across shades. Rank their combined hue families first.
    def support(candidate):
        return sum(fraction * (0.65 + 0.35 * saturation)
                   * max(0, 1 - _hue_gap(candidate[1], hue) / 0.10)
                   for fraction, hue, _, saturation in usable)

    accent = max(usable, key=support)
    hue = accent[1]
    raised = _hex(hue, 0.10, 0.20)
    primary = readable_accent(hue, _clamp(accent[2], 0.54, 0.66), max(accent[3], 0.75), raised)
    others = [item for item in usable if _hue_gap(item[1], hue) >= 0.12]
    if others:
        other = max(others, key=support)
        secondary = _hex(other[1], 0.64, max(other[3], 0.45))
    else:
        secondary = _hex(hue + 0.5, 0.64, 0.45)
    return {
        "ground": _hex(hue, 0.035, 0.22),
        "surface": _hex(hue, 0.065, 0.20),
        "raised": raised,
        "primary": primary,
        "vibrant": readable_accent(hue, 0.66, 1.0, raised),
        "secondary": secondary,
        "tertiary": _hex(hue - 0.06, 0.66, 0.60),
        "text": _hex(hue, 0.92, 0.12),
        "muted": _hex(hue, 0.66, 0.08),
        "outline": _hex(hue, 0.22, 0.12),
        "error": DANGER,
    }


def write_if_changed(path, value):
    if path.exists() and path.read_text() == value:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as tmp:
        tmp.write(value)
        name = tmp.name
    os.replace(name, path)
    return True


def replace_section(text, section, changes):
    match = re.search(r"(?ms)^\[" + re.escape(section) + r"\]\n(.*?)(?=^\[|\Z)", text)
    if not match:
        return text
    body = match.group(1)
    for key, value in changes.items():
        body = re.sub(r"(?m)^" + re.escape(key) + r"\s*=\s*\"[^\"]*\"", f'{key} = "{value}"', body)
    return text[:match.start(1)] + body + text[match.end(1):]


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError("Pass the actual leader wallpaper path")
        image = Path(sys.argv[1]).expanduser()
        info = image.stat()
        fingerprint = [str(image), info.st_mtime_ns, info.st_size, "wallpaper-derived-4"]
        try:
            cached = json.loads(out.read_text())
        except (OSError, ValueError):
            cached = {}
        palette = cached if cached.get("fingerprint") == fingerprint else {
            "wallpaper": str(image), "fingerprint": fingerprint, **palette_from_image(image)
        }
        write_if_changed(out, json.dumps(palette, indent=2) + "\n")

        terminal = home / ".config/alacritty/alacritty.toml"
        if terminal.is_file():
            imports = tomllib.loads(terminal.read_text()).get("general", {}).get("import", [])
            if any(Path(path).expanduser().name == "sensei-colors.toml" for path in imports):
                terminal = terminal.with_name("sensei-colors.toml")
        if terminal.exists():
            content = terminal.read_text()
            content = replace_section(content, "colors.primary", {
                "background": "#000000", "foreground": palette["text"],
                "dim_foreground": palette["muted"]})
            content = replace_section(content, "colors.selection", {
                "background": palette["primary"]})
            content = replace_section(content, "colors.normal", {
                "black": "#171311", "red": "#ff567a", "green": "#9dbf9e",
                "yellow": "#d6b59a", "blue": "#a6b9d1",
                "magenta": palette["primary"], "cyan": palette["secondary"], "white": palette["text"]})
            content = replace_section(content, "colors.bright", {
                "black": "#706963", "red": "#ff8099", "green": "#b5d3b1",
                "yellow": "#e8caa9", "blue": "#c1d0e4", "magenta": palette["vibrant"],
                "cyan": palette["secondary"], "white": "#fff3ea"})
            write_if_changed(terminal, content)

        # Color only. The status placement, fields, and key bindings stay in
        # their existing tmux files; do not source all of .tmux.conf.
        theme = home / ".config/tmux/sensei-theme.conf"
        template = theme.with_name("sensei-theme.template.conf")
        if template.is_file():
            text = template.read_text()
            for token, role in {
                "GROUND": "ground", "TEXT": "text", "ACCENT": "primary",
                "OUTLINE": "outline", "MUTED": "muted", "INACTIVE": "muted",
            }.items():
                text = text.replace(f"@{token}@", palette[role])
            if write_if_changed(theme, text) and shutil.which("tmux"):
                result = subprocess.run(["tmux", "source-file", str(theme)],
                                        capture_output=True, text=True, timeout=2)
                if result.returncode and "server" not in result.stderr:
                    print("sensei-palette: tmux did not reload the generated theme", file=sys.stderr)

        for gtk in ("gtk-3.0", "gtk-4.0"):
            css = home / ".config" / gtk / "colors.css"
            if not css.exists():
                continue
            content = css.read_text()
            for name, value in {
                "window_bg_color": "#000000", "view_bg_color": "#000000",
                "headerbar_bg_color": "#000000", "popover_bg_color": "#000000",
                "card_bg_color": palette["surface"],
                "window_fg_color": palette["text"],
                "accent_bg_color": palette["primary"],
                "accent_color": palette["primary"],
                "accent_fg_color": "#000000",
            }.items():
                content = re.sub(r"(?m)^(@define-color " + name + r" )#[0-9a-fA-F]{6};",
                                 lambda m: m.group(1) + value + ";", content)
            write_if_changed(css, content)
        for qt in ("qt5ct", "qt6ct"):
            scheme = home / ".config" / qt / "colors/matugen.conf"
            if scheme.exists():
                active = [palette['text'], palette['surface'], palette['raised'], palette['raised'],
                          palette['surface'], palette['outline'], palette['text'], '#ffffff',
                          palette['text'], '#000000', '#000000', '#000000',
                          palette['primary'], '#000000', palette['primary'], palette['primary'],
                          palette['surface'], '#000000', palette['surface'], palette['text'], palette['muted']]
                disabled = active.copy()
                for index in (0, 6, 8, 19, 20):
                    disabled[index] = palette['muted']
                content = '[ColorScheme]\n' + ''.join(
                    name + '=' + ', '.join(disabled if name == 'disabled_colors' else active) + '\n'
                    for name in ('active_colors', 'disabled_colors', 'inactive_colors'))
                write_if_changed(scheme, content)
        # Shells and tmux read these tiny generated files; wallpaper changes
        # never rerun a heavy prompt command or refresh the entire terminal.
        prompt = home / ".config/zsh/sensei-palette.zsh"
        prompt_text = "# Generated by sensei-palette\n" + "\n".join(
            f'{name}="%F{{{palette[key]}}}"' for name, key in (
                ("BLUE", "primary"), ("GREEN", "secondary"),
                ("YELLOW", "tertiary"), ("RED", "error"),
                ("CYAN", "secondary"), ("MAGENTA", "vibrant"),
                ("WHITE", "text"))) + ('\nRESET="%f"\n'
                f'BADGE="%K{{{palette["primary"]}}}%F{{{palette["ground"]}}}"\n'
                'BADGE_END="%k%f"\n')
        write_if_changed(prompt, prompt_text)
        fzf = home / ".config/fzf/sensei-colors"
        fzf_colors = '--color=bg:' + palette['ground'] + ',bg+:' + palette['raised'] + \
            ',fg:' + palette['text'] + ',fg+:' + palette['text'] + \
            ',hl:' + palette['primary'] + ',hl+:' + palette['tertiary'] + \
            ',info:' + palette['muted'] + ',prompt:' + palette['primary'] + \
            ',pointer:' + palette['vibrant'] + ',marker:' + palette['secondary'] + \
            ',spinner:' + palette['primary'] + ',header:' + palette['muted'] + '\n'
        write_if_changed(fzf, fzf_colors)
        border = palette['primary'].lstrip('#') + 'FF'
        outline = palette['outline'].lstrip('#') + 'FF'
        # Group borders match the window borders, and the deck's frame sits on
        # the outline colour whether it is focused or not. The profile script
        # no longer writes borders, so this is the only place they are set.
        subprocess.run(['hyprctl','eval',
                        'hl.config({["general.col.active_border"]="rgba(' + border +
                        ')",["general.col.inactive_border"]="rgba(' + outline + ')",'
                        '["group.col.border_active"]="rgba(' + border + ')",'
                        '["group.col.border_inactive"]="rgba(' + outline + ')"})'],
                       capture_output=True,timeout=2)
        subprocess.run(['hyprctl','eval',
                        'hl.window_rule({name="sensei-deck-border",match={class="sensei-deck"},'
                        'border_color="rgba(' + outline + ') rgba(' + outline + ')"})'],
                       capture_output=True,timeout=2)
        print(json.dumps(palette))
    except (OSError, KeyError, ValueError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        print(f"sensei-palette: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
