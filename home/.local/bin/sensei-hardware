#!/usr/bin/env python3
"""Read-only device passports and transition receipts. Never opens or flashes a board."""
import argparse,json,os,select,signal,subprocess,sys,time
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'share/sensei'))
import engineering as e

def properties(node):
 p=Path(node).resolve()
 if not str(p).startswith('/dev/') or not p.exists():raise ValueError('Choose an existing /dev device')
 result=subprocess.run(['udevadm','info','--query=property','--name',str(p)],capture_output=True,text=True,timeout=3)
 if result.returncode:raise ValueError('No udev identity is available')
 return dict(line.split('=',1) for line in result.stdout.splitlines() if '=' in line)

def inventory():
 profiles=e.read(e.config()/'hardware.json',{'version':1,'devices':[]})
 nodes=list(Path('/dev').glob('ttyACM*'))+list(Path('/dev').glob('ttyUSB*'))+list(Path('/dev').glob('video*'))
 found=[]
 for node in nodes:
  try:found.append((str(node),properties(node)))
  except (ValueError,OSError,subprocess.SubprocessError):pass
 rows=[]
 for profile in profiles.get('devices',[]):
  matches=[dict(node=node,identity=props.get('ID_SERIAL_SHORT') or props.get('ID_PATH','')) for node,props in found if all(props.get(k)==v for k,v in profile.get('match',{}).items()) and profile.get('match')]
  rows.append(dict(profile,nodes=matches,connected=len(matches)==1,ambiguous=len(matches)>1))
 return {'version':1,'devices':rows,'available':[{'node':node,'label':props.get('ID_V4L_PRODUCT') or props.get('ID_MODEL') or Path(node).name} for node,props in found]}

def watch():
 from child_lifetime import bind_parent
 bind_parent()
 child=subprocess.Popen(['stdbuf','-oL','udevadm','monitor','--udev','--property','--subsystem-match=tty','--subsystem-match=video4linux','--subsystem-match=usb'],stdout=subprocess.PIPE,text=True)
 def stop(*_):raise SystemExit(0)
 signal.signal(signal.SIGTERM,stop);signal.signal(signal.SIGINT,stop)
 previous={};first=True
 try:
  while True:
   current=inventory();lookup={row['id']:row for row in current['devices']}
   if not first:
    for identity,row in lookup.items():
     old=previous.get(identity)
     if old and old['connected']!=row['connected']:
      e.receipt('hardware.returned' if row['connected'] else 'hardware.disconnected',{'device':identity,'label':row.get('label',identity),'ambiguous':row['ambiguous']},project=row.get('project'))
   print(json.dumps(current),flush=True);previous=lookup;first=False
   # Wait for a completed event then debounce a burst. No periodic collection.
   while True:
    line=child.stdout.readline()
    if not line:return
    if line.strip()=='' :break
   quiet=time.monotonic()+.5
   while select.select([child.stdout],[],[],max(0,quiet-time.monotonic()))[0]:
    if not child.stdout.readline():return
    if time.monotonic()>=quiet:break
 finally:
  child.terminate()
  try:child.wait(timeout=2)
  except subprocess.TimeoutExpired:child.kill();child.wait()

def main():
 p=argparse.ArgumentParser(description=__doc__);s=p.add_subparsers(dest='verb',required=True);s.add_parser('list');s.add_parser('watch')
 q=s.add_parser('register');q.add_argument('id');q.add_argument('--node',required=True);q.add_argument('--label',required=True);q.add_argument('--project');q.add_argument('--baud',type=int);q.add_argument('--firmware');q.add_argument('--test-task')
 a=p.parse_args()
 if a.verb=='watch':watch();return
 if a.verb=='list':return inventory()
 e.identifier(a.id)
 if a.project:e.project(a.project)
 if a.test_task:
  if not a.project:raise ValueError('A diagnostic task needs its owning project')
  e.task(e.project(a.project),a.test_task)
 if a.baud is not None and not 1<=a.baud<=12000000:raise ValueError('Invalid expected baud rate')
 props=properties(a.node);keys=['ID_VENDOR_ID','ID_MODEL_ID','ID_USB_INTERFACE_NUM','ID_V4L_CAPABILITIES']
 match={k:props[k] for k in keys if props.get(k)}
 if props.get('ID_SERIAL_SHORT'):match['ID_SERIAL_SHORT']=props['ID_SERIAL_SHORT']
 elif props.get('ID_PATH'):match['ID_PATH']=props['ID_PATH']
 else:raise ValueError('No stable serial or physical path; register manually after inspecting identity')
 row=dict(id=a.id,label=a.label[:120],project=a.project,expected_baud=a.baud,firmware=a.firmware,diagnostic_task=a.test_task,match=match)
 with e.locked(e.config()/'hardware.lock'):
  catalog=e.read(e.config()/'hardware.json',{'version':1,'devices':[]})
  if any(x['id']==a.id for x in catalog['devices']):raise ValueError('Passport already exists; edit its private configuration explicitly')
  catalog['devices'].append(row);e.save(e.config()/'hardware.json',catalog)
 return row
if __name__=='__main__':
 try:
  result=main()
  if result is not None:print(json.dumps(result))
 except (ValueError,OSError,subprocess.SubprocessError) as error:print(json.dumps({'error':str(error)}));sys.exit(1)
