#!/usr/bin/python3
"""Den receive-only radio controls; actions are explicit and bounded."""
import argparse,json,sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'share/sensei'))
import radio
p=argparse.ArgumentParser(description=__doc__);s=p.add_subparsers(dest='verb',required=True)
for name in ('status','test','stop','open','watch','history','sensors','folder','compare'):s.add_parser(name)
s.add_parser('scan').add_argument('band',choices=radio.BANDS)
s.add_parser('stream').add_argument('band',choices=radio.BANDS)
s.add_parser('record').add_argument('frequency',type=float)
for name in ('fm','fm-worker','scope'):
 q=s.add_parser(name);q.add_argument('frequency',type=float);q.add_argument('gain',type=float,nargs='?',default=20)
a=p.parse_args()
try:
 if a.verb=='watch':radio.watch()
 elif a.verb=='stream':radio.stream(a.band)
 elif a.verb=='scope':radio.scope(a.frequency,a.gain)
 elif a.verb=='folder':
  import subprocess
  radio.ROOT.mkdir(parents=True,exist_ok=True,mode=0o700);subprocess.Popen(['xdg-open',str(radio.ROOT)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);print(json.dumps({'opened':'Radio receipts'}))
 else:
  result=radio.record_iq(a.frequency) if a.verb=='record' else radio.sensors() if a.verb=='sensors' else radio.history() if a.verb=='history' else radio.compare() if a.verb=='compare' else radio.scan(a.band) if a.verb=='scan' else radio.fm(a.frequency,a.gain) if a.verb=='fm' else radio.fm_worker(a.frequency,a.gain) if a.verb=='fm-worker' else {'status':radio.status,'test':radio.test,'stop':radio.stop,'open':radio.open_receiver}[a.verb]()
  print(json.dumps(result))
except (ValueError,OSError,KeyError) as error:print(json.dumps({'error':str(error)}));sys.exit(1)
