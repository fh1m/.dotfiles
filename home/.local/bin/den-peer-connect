#!/usr/bin/env python3
"""SSH ProxyCommand: discover a named peer, then use standard socat over the LAN.

Discovery is not authorization. The parent SSH process still verifies its host
key and authenticates normally. This never invokes Tailscale SSH or changes IPs.
"""
import argparse
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
from urllib.parse import urlencode


def local_networks(addresses):
    return [ipaddress.ip_network(f"{a['local']}/{a['prefixlen']}", strict=False)
            for row in addresses if 'UP' in row.get('flags', [])
            and row['ifname'] not in ('lo', 'tailscale0')
            and not row['ifname'].startswith(('docker', 'veth', 'br-'))
            for a in row.get('addr_info', []) if a.get('family') == 'inet']


def peer_node(status, name):
    rows = [p for p in status.get('Peer', {}).values()
            if p.get('DNSName', '').rstrip('.').split('.')[0] == name]
    if not rows:
        rows = [p for p in status.get('Peer', {}).values() if p.get('HostName') == name]
    return rows[0] if len(rows) == 1 else None


def direct_endpoint(node, ping, name, networks):
    if ping.get('Err') or ping.get('NodeName', '').rstrip('.').split('.')[0] != name:
        return None
    if ping.get('NodeIP') not in node.get('TailscaleIPs', []):
        return None
    try:
        address = ipaddress.IPv4Address(ping.get('Endpoint', '').rsplit(':', 1)[0])
    except ipaddress.AddressValueError:
        return None
    if address.is_loopback or address.is_link_local or not address.is_private:
        return None
    return str(address) if any(address in network for network in networks) else None


def local_api(path, method='GET'):
    result = subprocess.run(['curl', '--silent', '--show-error', '--fail',
                             '--max-time', '2', '--max-filesize', '2097152',
                             '--unix-socket', '/var/run/tailscale/tailscaled.sock',
                             '-X', method, 'http://local-tailscaled.sock/localapi/v0/' + path],
                            capture_output=True, text=True, timeout=3)
    if result.returncode:
        raise OSError('Native peer discovery unavailable')
    return json.loads(result.stdout)


def discover(name, networks):
    try:
        status = local_api('status')
        node = peer_node(status, name)
        if node:
            address = next((value for value in node.get('TailscaleIPs', []) if ipaddress.ip_address(value).version == 4), None)
            if address:
                path = 'ping?' + urlencode({'ip': address, 'type': 'disco'})
                ping = local_api(path, 'POST')
                selected = direct_endpoint(node, ping, name, networks)
                if not selected and ping.get('DERPRegionID'):
                    selected = direct_endpoint(node, local_api(path, 'POST'), name, networks)
                if selected:
                    return selected
    except (OSError, ValueError, subprocess.SubprocessError, KeyError, TypeError):
        pass
    # Avahi remains the fallback when the VPN/control plane is unavailable.
    result = subprocess.run(['getent', 'ahostsv4', name + '.local'],
                            capture_output=True, text=True, timeout=2)
    for line in result.stdout.splitlines():
        try:
            address = ipaddress.IPv4Address(line.split()[0])
            if not address.is_loopback and not address.is_link_local and any(address in n for n in networks):
                return str(address)
        except (ValueError, IndexError):
            continue
    raise OSError('No directly connected peer address; no command was sent')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('peer')
    parser.add_argument('port', type=int)
    parser.add_argument('--resolve', action='store_true', help='Print the discovered LAN address without opening a connection')
    args = parser.parse_args()
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,62}', args.peer) or not 1 <= args.port <= 65535:
        parser.error('Use a peer hostname and a valid TCP port')
    binary = shutil.which('socat')
    if not args.resolve and not binary:
        raise OSError('Install socat for the standard SSH relay')
    result = subprocess.run(['ip', '-j', '-4', 'address'], capture_output=True,
                            text=True, check=True, timeout=3)
    address = discover(args.peer, local_networks(json.loads(result.stdout)))
    if args.resolve:
        print(address)
        return
    os.execv(binary, [binary, 'STDIO', f'TCP4:{address}:{args.port},connect-timeout=3'])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Den peer connection unavailable: ' + str(error), file=sys.stderr)
        raise SystemExit(255)
