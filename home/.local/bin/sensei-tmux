#!/usr/bin/env python3
"""Resume the daily tmux session or explicitly create an independent session."""
import argparse,fcntl,os,re,subprocess
from pathlib import Path
STATE=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))/'sensei-tmux'
def tmux(*args,capture=False):
    return subprocess.run(['tmux',*args],check=True,text=True,stdout=subprocess.PIPE if capture else subprocess.DEVNULL,stderr=subprocess.PIPE)
def create():
    STATE.mkdir(mode=0o700,parents=True,exist_ok=True)
    with (STATE/'launch.lock').open('a+') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        listing=subprocess.run(['tmux','list-sessions','-F','#{session_name}'],capture_output=True,text=True).stdout.splitlines()
        counter=STATE/'counter'
        try:previous=int(counter.read_text())
        except (OSError,ValueError):previous=0
        slot=max([previous]+[int(n[4:]) for n in listing if re.fullmatch(r'dev_\d+',n)])+1
        name=f'dev_{slot:03d}'
        # No -t: each new session owns distinct windows and panes.
        tmux('new-session','-d','-s',name,'-n','Shell','-c',os.getcwd())
        temp=counter.with_suffix('.tmp');temp.write_text(str(slot));temp.chmod(0o600);temp.replace(counter)
        return name

def daily():
    STATE.mkdir(mode=0o700,parents=True,exist_ok=True)
    with (STATE/'daily.lock').open('a+') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        anchor=STATE/'daily-session'
        try:name=anchor.read_text().strip()
        except FileNotFoundError:name=''
        if not re.fullmatch(r'daily|dev_\d+',name):
            listing=subprocess.run(['tmux','list-sessions','-F','#{session_name} #{?session_last_attached,#{session_last_attached},0} #{session_activity}'],capture_output=True,text=True)
            candidates=[line.split() for line in listing.stdout.splitlines()
                        if re.fullmatch(r'dev_\d+ \d+ \d+',line)]
            name=max(candidates,key=lambda row:(int(row[1]),int(row[2]),int(row[0][4:])),default=('daily',))[0]
        if subprocess.run(['tmux','has-session','-t','='+name],capture_output=True).returncode:
            tmux('new-session','-d','-s',name,'-n','Shell','-c',os.getcwd())
        temp=anchor.with_suffix('.tmp');temp.write_text(name+'\n');temp.chmod(0o600);temp.replace(anchor)
        return name

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    modes=parser.add_mutually_exclusive_group()
    modes.add_argument('--prepare',action='store_true');modes.add_argument('--create',action='store_true')
    modes.add_argument('--new',action='store_true');modes.add_argument('--attach');modes.add_argument('--daily-name',action='store_true')
    modes.add_argument('--list',action='store_true');args=parser.parse_args()
    if args.prepare:return # The existing tmux -D service owns server lifetime.
    if args.list:print(tmux('list-sessions',capture=True).stdout,end='');return
    if args.daily_name:print(daily());return
    name=args.attach
    if name and not re.fullmatch(r'[A-Za-z0-9_.-]+',name):raise ValueError('Choose a session by exact name')
    if not name:name=create() if args.new or args.create else daily()
    if args.create:print(name);return
    command='switch-client' if os.environ.get('TMUX') else 'attach-session'
    os.execvp('tmux',['tmux',command,'-t','='+name])
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.CalledProcessError) as error:raise SystemExit('tmux setup failed: '+str(error))
