#!/usr/bin/env python3
"""Launch the daily Alacritty terminal, preserving the common terminal caller CLI."""
import os
import sys
from pathlib import Path

args = sys.argv[1:]
out = []
value_options = {'--title', '-T', '--class', '--working-directory', '--directory', '--config-file', '--option', '-o'}
i = 0
explicit_command = False
new_session = False
while i < len(args):
    arg = args[i]
    if arg in ('-e', '--command'):
        explicit_command = True
        out.extend(['-e', *args[i + 1:]])
        break
    if arg == '--new-session':
        new_session = True
        i += 1
        continue
    if arg in value_options:
        if i + 1 >= len(args):
            raise SystemExit(f'{arg} needs a value')
        out.extend(['--working-directory' if arg == '--directory' else arg, args[i + 1]])
        i += 2
        continue
    if arg == '--hold':
        out.append(arg)
        i += 1
        continue
    if arg.startswith('-'):
        out.append(arg)
        i += 1
        continue
    out.extend(['-e', *args[i:]])
    explicit_command = True
    break
# Task commands remain separate. Ordinary terminals attach to daily work;
# only the explicit new-session action allocates an independent dev session.
if not explicit_command:
    if not any(arg in ('--title', '-T') for arg in args):
        out.extend(['--title', 'Sensei · Terminal'])
    if not new_session and not '--class' in out:
        out.extend(['--class', 'sensei-daily-terminal'])
    out.extend(['-e', '@HOME@/.local/bin/sensei-tmux'])
    if new_session:
        out.append('--new')

# A new terminal is outside its launcher's tmux client, even from a pane.
os.environ.pop('TMUX',None)
os.environ.pop('TMUX_PANE',None)
cwd=''
for index,arg in enumerate(out[:-1]):
    if arg=='--working-directory':
        cwd=out[index+1]
        break
command=[str(Path.home()/'.local/bin/sensei-app-run')]
if cwd:
    command.extend(['--cwd',cwd])
command.extend(['--','alacritty',*out])
os.execv(command[0],command)
