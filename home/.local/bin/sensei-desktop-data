#!/usr/bin/python3
import json,sys,subprocess,time,urllib.request,urllib.parse,random,re,os
from pathlib import Path
cache=Path.home()/'.cache/sensei-desktop';cache.mkdir(exist_ok=True)
def cmd(args,timeout=15):
 p=subprocess.run(args,capture_output=True,text=True,timeout=timeout);return p

def comic(number):
 latest=cache/'latest.json'
 def fetch(url):
  with urllib.request.urlopen(urllib.request.Request(url,headers={'User-Agent':'SenseiDesktop/1.0'}),timeout=15) as r:return json.load(r)
 if not latest.exists() or time.time()-latest.stat().st_mtime>900:
  try:latest.write_text(json.dumps(fetch('https://xkcd.com/info.0.json')))
  except Exception:
   if not latest.exists():raise
 last=json.loads(latest.read_text());n=int(last['num']) if number=='latest' else random.randint(1,int(last['num'])) if number=='random' else max(1,min(int(last['num']),int(number)))
 if n==404:n=405
 p=cache/f'comic-{n}.json'
 d=json.loads(p.read_text()) if p.exists() else last if n==last['num'] else fetch(f'https://xkcd.com/{n}/info.0.json');p.write_text(json.dumps(d))
 url=d['img']
 if urllib.parse.urlparse(url).hostname!='imgs.xkcd.com':raise ValueError('Unexpected comic image host')
 image=cache/(str(n)+Path(urllib.parse.urlparse(url).path).suffix)
 if not image.exists():
  with urllib.request.urlopen(url,timeout=15) as r:image.write_bytes(r.read(12*1024*1024))
 return {'num':n,'latest':last['num'],'title':d['safe_title'],'alt':d['alt'],'transcript':d.get('transcript',''),'date':f"{d['year']}-{int(d['month']):02}-{int(d['day']):02}",'image':image.as_uri(),'url':f'https://xkcd.com/{n}/'}
def packages(check=False):
 p=cache/'packages.json';saved=json.loads(p.read_text()) if p.exists() else {}
 official=cmd(['pacman','-Qn']).stdout.splitlines();foreign=cmd(['pacman','-Qm']).stdout.splitlines()
 installed=[{'name':v.split()[0],'version':v.split()[1],'source':'AUR/local' if v in foreign else 'pacman'} for v in official+foreign if len(v.split())>=2]
 updates=saved.get('updates',[]);errors=[]
 if check:
  updates=[]
  for args,source in [(['checkupdates'],'pacman'),(['paru','-Qua'],'AUR')]:
   try:
    r=cmd(args,120)
    if r.returncode not in (0,2):errors.append(source+': '+r.stderr.strip()[-300:])
    for line in r.stdout.splitlines():
     match=re.fullmatch(r'(\S+)\s+(\S+)\s+->\s+(\S+)',line)
     if match:updates.append({'name':match[1],'version':match[2],'new':match[3],'source':source})
   except Exception as e:errors.append(source+': '+str(e))
  saved={'updates':updates,'checked':time.time(),'error':' · '.join(errors)};p.write_text(json.dumps(saved))
 return dict(saved,installed=installed,total=len(installed),official=len(official),foreign=len(foreign))
def network():
 keys={'connections':['nmcli','-t','-f','NAME,TYPE,DEVICE','connection','show','--active'],'devices':['nmcli','-t','-f','DEVICE,TYPE,STATE,CONNECTION','device'],'addresses':['ip','-brief','address'],'routes':['ip','route'],'dns':['resolvectl','status'],'ssh':['systemctl','is-active','sshd'],'listeners':['ss','-tuln']}
 return {key:cmd(args).stdout.strip() for key,args in keys.items()}
try:
 op=sys.argv[1];result=comic(sys.argv[2]) if op=='comic' else packages(len(sys.argv)>2 and sys.argv[2]=='check') if op=='packages' else network();print(json.dumps(result))
except Exception as e:print(json.dumps({'error':str(e)}));sys.exit(1)
