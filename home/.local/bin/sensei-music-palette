#!/usr/bin/env python3
"""One small artwork sample; no network, persistent daemon or full-size blur."""
import colorsys
import json
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse
from PIL import Image


def palette(source):
    parsed = urlparse(source)
    if parsed.scheme not in ('', 'file') or parsed.netloc:
        raise ValueError('Only local artwork is supported')
    path = Path(unquote(parsed.path))
    with Image.open(path) as image:
        image.thumbnail((48, 48))
        colors = image.convert('RGB').quantize(colors=8).convert('RGB').getcolors(2304) or []
    # Prefer a populous chromatic shade, then keep it dark enough behind UI.
    chromatic = [pair for pair in colors if pair[0] >= sum(n for n, _ in colors)*.015 and colorsys.rgb_to_hsv(*(c/255 for c in pair[1]))[1] >= .22]
    _, rgb = max(chromatic or colors, key=lambda pair: pair[0] * (.2 + colorsys.rgb_to_hsv(*(c/255 for c in pair[1]))[1]))
    h, s, _ = colorsys.rgb_to_hsv(*(c/255 for c in rgb))
    def color(value):
        return '#'+''.join(f'{round(c*255):02x}' for c in colorsys.hsv_to_rgb(h, min(.65, s), value))
    return {'wash': color(.27), 'edge': color(.12)}


if __name__ == '__main__':
    try:
        result = palette(sys.argv[1])
    except (OSError, ValueError, IndexError):
        result = {'wash': '#402131', 'edge': '#171019'}
    print(json.dumps(result))
