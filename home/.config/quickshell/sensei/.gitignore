# Runtime files -- written by sensei or the installer, never source.
# sensei keeps its settings, state and caches in ~/.config/sensei,
# ~/.local/state/sensei and ~/.cache/sensei; these cover anything that could
# ever land inside the checkout instead.

# Generated per profile by sensei-profile.
external/sensei-colors.conf
*.raw

# Python byte-code from the helpers.
__pycache__/
*.pyc

# The installer's and helpers' backups and temporary files.
*.sensei-backup-*
*.sensei-removed-*
*.tmp
*.orig
*.rej

# Local notes and QA output that belong to a working copy, not the project.
SPEC.md
scratchpad/
*.log
*.ppm
*.mkv

# Editor and OS noise.
*.swp
*~
.DS_Store
.qmlls.ini
.vscode/
.idea/
