#!/usr/bin/python3
import json,os,sys,time,subprocess,fcntl,runpy
from pathlib import Path
store=Path.home()/'.cache/sensei-spotify';store.mkdir(parents=True,exist_ok=True)
def read(p):
 try:return json.loads(p.read_text())
 except Exception:return {}
def put(p,d):
 t=p.with_name(p.name+'.'+str(os.getpid())+'.tmp');t.write_text(json.dumps(d));t.chmod(0o600);t.replace(p)
if len(sys.argv)<3:sys.exit(0)
if sys.argv[1]=='resolve':
 uri=sys.argv[2]
 resolve_lock=(store/('resolve-'+uri.rsplit(':',1)[-1]+'.lock')).open('a')
 try:fcntl.flock(resolve_lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
 except BlockingIOError:sys.exit(0)
 if (store/('native-track-'+uri.rsplit(':',1)[-1]+'.json')).exists():sys.exit(0)
 api=runpy.run_path(str(Path.home()/'.local/bin/sensei-spotify'))
 try:
  item=api['api']('tracks/'+uri.rsplit(':',1)[-1]);track=api['row'](item);put(store/('native-track-'+track['id']+'.json'),track)
  with (store/'native-event.lock').open('a') as lock:
   fcntl.flock(lock,fcntl.LOCK_EX);d=read(store/'native-event.json')
   if d.get('uri')==uri:d['track']=track;put(store/'native-event.json',d)
 except Exception:pass
 sys.exit(0)
event,uri=sys.argv[1:3]
if event not in ('Changed','Playing','Paused'):sys.exit(0)
with (store/'native-event.lock').open('a') as lock:
 fcntl.flock(lock,fcntl.LOCK_EX);old=read(store/'native-event.json');track=read(store/('native-track-'+uri.rsplit(':',1)[-1]+'.json'))
 if not track and old.get('uri')==uri:track=old.get('track',{})
 d={'uri':uri,'time':time.time(),'track':track,'playing':event=='Playing' if event!='Changed' else old.get('playing',False),'progress':int(sys.argv[3]) if len(sys.argv)>3 else 0}
 put(store/'native-event.json',d)
if not track:subprocess.Popen([sys.executable,__file__,'resolve',uri],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
